    }
    if (!isUndef(ctx) && isObj(ctx)) {
      JsValue state = ctx["~memo"];
      if (isObj(state) && !isUndef(state["backEdges"]) && !JS.isNullish(state["backEdges"])) {
        if (setHas(state["backEdges"], payload["value"]).truthy()) {
          JsValue err = construct1(gError(), "Cannot parse a reference cycle that closes through a transform");
          err["name"] = "ZodCyclicError";
          throw err;
        }
