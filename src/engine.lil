    }
  }
  if (JS.number(vr["issues"]["length"]).toInt() > 0) {
    if (isPropertyKey(key)) prefixAll(vr["issues"], payload["issues"], key);
    else {
      push(payload["issues"], JS.object("code", "invalid_element", "origin", "map", "key", key, "issues", finalizeRawIssues(vr["issues"], ctx), "input", input, "path", newArray()));
    }
  }
}

void parseMap(Schema schema, JsValue payload, JsValue ctx) {
