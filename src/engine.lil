}

bool isPropertyKey(JsValue key) {
  string t = typeOf(key);
  if (t == "string") return true;
  if (t == "number") return true;
  if (t == "symbol") return true;
  return false;
}

void handleMapResult(JsValue kr, JsValue vr, JsValue payload, JsValue key, JsValue input, JsValue ctx) {
  if (JS.number(kr["issues"]["length"]).toInt() > 0) {
