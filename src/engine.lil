export JsValue sizeIssue(bool tooBig, string origin, float bound, bool inclusive, bool exact, JsValue input, string message) {
  JsValue issue = sizeIssueValue(tooBig, origin, bound, inclusive, exact, input);
  if (message.length > 0) issue["message"] = message;
