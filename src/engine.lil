      this.defineLazyInternal("optin", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (isObj(inner) && isObj(inner["_zod"])) return inner["_zod"]["optin"];
        return undef();
      }));
      this.defineLazyInternal("optout", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (isObj(inner) && isObj(inner["_zod"])) return inner["_zod"]["optout"];
        return undef();
      }));
      this.defineLazyInternal("pattern", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (!isObj(inner) || !isObj(inner["_zod"])) return undef();
        JsValue pat = inner["_zod"]["pattern"];
        if (isUndef(pat) || JS.isNullish(pat)) return undef();
        return newRegex("^(" + this.cleanRegex(toStr(pat["source"])) + "|null)$", "");
      }));
      this.defineLazyInternal("values", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (!isObj(inner) || !isObj(inner["_zod"]) || isUndef(inner["_zod"]["values"])) return undef();
        JsValue set = newSet();
        JsValue list = invoke1(gArray(), "from", inner["_zod"]["values"]);
        int i = 0;
        int n = JS.number(list["length"]).toInt();
        while (i < n) {
          setAdd(set, list[i]);
          i = i + 1;
        }
        setAdd(set, null);
        return set;
      }));
      return;
    }
    if (k == KUnion || k == KXor) {
      this.defineLazyInternal("optin", JS.method1((JsValue _s, JsValue zod) => {
        JsValue options = zod["def"]["options"];
        if (!isArr(options)) return undef();
        bool any = false;
        int i = 0;
        int n = JS.number(options["length"]).toInt();
        while (i < n) {
          JsValue opt = options[i]["_zod"]["optin"];
          if (toStr(opt) == "defaulted") return "defaulted";
          if (!isUndef(opt)) any = true;
          i = i + 1;
        }
        if (any) return "optional";
        return undef();
      }));
      this.defineLazyInternal("optout", JS.method1((JsValue _s, JsValue zod) => {
        JsValue options = zod["def"]["options"];
        if (!isArr(options)) return undef();
        int i = 0;
        int n = JS.number(options["length"]).toInt();
        while (i < n) {
          if (toStr(options[i]["_zod"]["optout"]) == "optional") return "optional";
          i = i + 1;
        }
        return undef();
      }));
      this.defineLazyInternal("values", JS.method1((JsValue _s, JsValue zod) => {
        JsValue options = zod["def"]["options"];
        if (!isArr(options)) return undef();
        JsValue set = newSet();
        int i = 0;
        int n = JS.number(options["length"]).toInt();
        while (i < n) {
          JsValue vals = options[i]["_zod"]["values"];
          if (isUndef(vals)) return undef();
          JsValue list = invoke1(gArray(), "from", vals);
          int j = 0;
          int jn = JS.number(list["length"]).toInt();
          while (j < jn) {
            setAdd(set, list[j]);
            j = j + 1;
          }
          i = i + 1;
        }
        return set;
      }));
      this.defineLazyInternal("pattern", JS.method1((JsValue _s, JsValue zod) => {
        JsValue options = zod["def"]["options"];
        if (!isArr(options)) return undef();
        JsValue parts = newArray();
        int i = 0;
        int n = JS.number(options["length"]).toInt();
        while (i < n) {
          JsValue pat = options[i]["_zod"]["pattern"];
          if (isUndef(pat) || JS.isNullish(pat)) return undef();
          push(parts, this.cleanRegex(toStr(pat["source"])));
          i = i + 1;
        }
        return newRegex("^(" + toStr(invoke1(parts, "join", "|")) + ")$", "");
      }));
      return;
    }
    if (k == KPipe) {
      this.defineLazyInternal("values", JS.method1((JsValue _s, JsValue zod) => {
        JsValue left = zod["def"]["in"];
        if (isObj(left) && isObj(left["_zod"])) return left["_zod"]["values"];
        return undef();
      }));
      this.defineLazyInternal("optin", JS.method1((JsValue _s, JsValue zod) => {
        JsValue left = zod["def"]["in"];
        if (isObj(left) && isObj(left["_zod"])) return left["_zod"]["optin"];
        return undef();
      }));
      this.defineLazyInternal("optout", JS.method1((JsValue _s, JsValue zod) => {
        JsValue right = zod["def"]["out"];
        if (isObj(right) && isObj(right["_zod"])) return right["_zod"]["optout"];
        return undef();
      }));
      return;
    }
    if (k == KCatch) {
      this.defineLazyInternal("optin", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (isObj(inner) && isObj(inner["_zod"]) && toStr(inner["_zod"]["optin"]) == "defaulted") return "defaulted";
        return "optional";
      }));
      this.defineLazyInternal("optout", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (isObj(inner) && isObj(inner["_zod"])) return inner["_zod"]["optout"];
        return undef();
      }));
      this.defineLazyInternal("values", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (isObj(inner) && isObj(inner["_zod"])) return inner["_zod"]["values"];
        return undef();
      }));
      return;
    }
    if (k == KTemplateLiteral) {
      return;
    }
    if (k == KReadonly) {
      this.defineLazyInternal("optin", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (isObj(inner) && isObj(inner["_zod"])) return inner["_zod"]["optin"];
        return undef();
      }));
      this.defineLazyInternal("optout", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (isObj(inner) && isObj(inner["_zod"])) return inner["_zod"]["optout"];
        return undef();
      }));
      this.defineLazyInternal("values", JS.method1((JsValue _s, JsValue zod) => {
        JsValue inner = zod["def"]["innerType"];
        if (isObj(inner) && isObj(inner["_zod"])) return inner["_zod"]["values"];
        return undef();
      }));
      return;
    }
    this.defineLazyInternal("pattern", JS.method1((JsValue _s, JsValue zod) => {
      Schema owner = bag[JS.number(zod["id"]).toInt()];
      return owner.computePattern();
    }));
    if (this.optin != 0) intern["optin"] = this.optinValue();
    else {
      this.defineLazyInternal("optin", JS.method1((JsValue _s, JsValue zod) => {
        Schema owner = bag[JS.number(zod["id"]).toInt()];
        return owner.optinValue();
      }));
    }
    if (this.optout != 0) intern["optout"] = this.optoutValue();
    else {
      this.defineLazyInternal("optout", JS.method1((JsValue _s, JsValue zod) => {
        Schema owner = bag[JS.number(zod["id"]).toInt()];
        return owner.optoutValue();
      }));
    }
    if (!isUndef(this.values)) intern["values"] = this.values;
  }

  bool isContainer() {
    int k = this.kind;
    if (k == KObject) return true;
    if (k == KArray) return true;
    if (k == KTuple) return true;
    if (k == KRecord) return true;
    if (k == KMap) return true;
    if (k == KSet) return true;
    return false;
  }

  bool walkChildRecursive(JsValue child, JsValue stack) {
    if (JS.isNullish(child) || !isObj(child)) return false;
    if (isObj(child["_zod"])) {
      Schema? s = trySchema(child);
      if (s != null) return s.isRecursiveWalk(stack);
      return false;
    }
    if (!isArr(child)) return false;
    int i = 0;
    int n = JS.number(child["length"]).toInt();
    while (i < n) {
      if (this.walkChildRecursive(child[i], stack)) return true;
      i = i + 1;
    }
    return false;
  }

  bool isRecursiveWalk(JsValue stack) {
    JsValue cached = weakGet(recCache, this.handle);
    if (!isUndef(cached) && !JS.isNullish(cached)) return yes(cached);
    if (setHas(stack, this.handle).truthy()) return true;
    setAdd(stack, this.handle);
    bool result = false;
    if (this.kind == KLazy) {
      JsValue inner = this.handle["_zod"]["innerType"];
      if (this.walkChildRecursive(inner, stack)) result = true;
    } else {
      JsValue def = this.def;
      JsValue shape = def["shape"];
      if (isObj(shape) && !JS.isNullish(shape)) {
        JsValue keys = objectKeys(shape);
        int i = 0;
        int n = JS.number(keys["length"]).toInt();
        while (i < n) {
          if (this.walkChildRecursive(shape[keys[i]], stack)) result = true;
          i = i + 1;
        }
      }
      JsValue keys = objectKeys(def);
      int i = 0;
      int n = JS.number(keys["length"]).toInt();
      while (i < n) {
        string key = toStr(keys[i]);
        if (key != "shape") {
          if (this.walkChildRecursive(def[keys[i]], stack)) result = true;
        }
        i = i + 1;
      }
    }
    setDelete(stack, this.handle);
    weakSet(recCache, this.handle, result);
    return result;
  }

  JsValue cloneIssues(JsValue issues) {
    JsValue out = newArray();
    int i = 0;
    int n = JS.number(issues["length"]).toInt();
    while (i < n) {
      JsValue iss = objectAssign(JS.object(), issues[i]);
      if (isArr(iss["path"])) iss["path"] = invoke1(iss["path"], "slice", 0);
      push(out, iss);
      i = i + 1;
    }
    return out;
  }

  void pushClonedIssues(JsValue issues, JsValue payload) {
    JsValue cloned = this.cloneIssues(issues);
    int i = 0;
    int n = JS.number(cloned["length"]).toInt();
    while (i < n) {
      push(payload["issues"], cloned[i]);
      i = i + 1;
    }
  }

  JsValue memoEnter(JsValue payload, JsValue ctx) {
    JsValue m = this.handle["_zod"]["memoizer"];
    if (isUndef(m) || JS.isNullish(m)) return undef();
    if (isUndef(m["recursive"])) {
      m["recursive"] = this.isRecursiveWalk(newSet());
      if (!m["recursive"].truthy()) return undef();
    } else if (!m["recursive"].truthy()) {
      return undef();
    }
    JsValue input = payload["value"];
    if (JS.isNullish(input) || JS.typeOf(input) != "object") return undef();
    if (isUndef(ctx) || JS.isNullish(ctx) || !isObj(ctx)) return undef();
    JsValue state = ctx["~memo"];
    if (isUndef(state) || JS.isNullish(state)) {
      state = JS.object("buckets", newMap(), "backEdges", undef());
      ctx["~memo"] = state;
    }
    JsValue bucket = undef();
    if (JS.strictEqual(m["ctx"], ctx)) bucket = m["bucket"];
    else {
      bucket = mapGet(state["buckets"], this.handle);
      if (isUndef(bucket) || JS.isNullish(bucket)) {
        bucket = newMap();
        mapSet(state["buckets"], this.handle, bucket);
      }
      m["ctx"] = ctx;
      m["bucket"] = bucket;
    }
    JsValue hit = mapGet(bucket, input);
    if (!isUndef(hit) && !JS.isNullish(hit)) {
      payload["value"] = hit["value"];
      if (!JS.isNullish(hit["issues"])) {
        if (JS.number(hit["issues"]["length"]).toInt() > 0) this.pushClonedIssues(hit["issues"], payload);
      } else {
        payload["memo"] = true;
        if (isUndef(state["backEdges"]) || JS.isNullish(state["backEdges"])) state["backEdges"] = newSet();
        setAdd(state["backEdges"], hit["value"]);
      }
      return payload;
    }
    m["handoff"] = bucket;
    m["openDepth"] = m["open"]["length"];
    return undef();
  }

  JsValue memoAlloc(JsValue payload, JsValue empty) {
    JsValue m = this.handle["_zod"]["memoizer"];
    if (isUndef(m) || isUndef(m["handoff"]) || JS.isNullish(m["handoff"])) return empty;
    JsValue bucket = m["handoff"];
    m["handoff"] = undef();
    JsValue entry = JS.object("value", empty, "issues", null);
    mapSet(bucket, payload["value"], entry);
    push(m["open"], entry);
    return empty;
  }

  void memoLeave(JsValue payload) {
    JsValue m = this.handle["_zod"]["memoizer"];
    if (isUndef(m) || JS.isNullish(m)) return;
    m["handoff"] = undef();
    JsValue open = m["open"];
    int depth = 0;
    if (isNum(m["openDepth"])) depth = JS.number(m["openDepth"]).toInt();
    if (isArr(open) && JS.number(open["length"]).toInt() > depth) {
      JsValue entry = invoke0(open, "pop");
      if (JS.number(payload["issues"]["length"]).toInt() > 0) entry["issues"] = this.cloneIssues(payload["issues"]);
      else entry["issues"] = newArray();
    }
  }

  JsValue tupleBoundIssue(bool tooBig, int bound, JsValue input) {
    if (tooBig) {
      return JS.object("code", "too_big", "maximum", 0.0 + bound, "inclusive", true, "input", input, "origin", "array");
    }
    return JS.object("code", "too_small", "minimum", 0.0 + bound, "inclusive", true, "input", input, "origin", "array");
  }

  void finishTuple(JsValue payload, JsValue items, JsValue input, JsValue itemResults, int optoutStart) {
    JsValue out = payload["value"];
    int n = JS.number(input["length"]).toInt();
    int want = JS.number(items["length"]).toInt();
    int i = 0;
    while (i < want) {
      JsValue r = itemResults[i];
      bool present = i < n;
      Schema? item = trySchema(items[i]);
      int optin = 0;
      if (item != null) {
        Schema s = item;
        optin = s.optin;
      }
      if (!present && i >= optoutStart && optin == 1) {
        out["length"] = i;
        break;
      }
      if (!isUndef(r) && !JS.isNullish(r) && JS.number(r["issues"]["length"]).toInt() > 0) {
        if (!present && i >= optoutStart) {
          out["length"] = i;
          break;
        }
        prefixAll(r["issues"], payload["issues"], JS.number(0.0 + i));
      }
      if (!isUndef(r) && !JS.isNullish(r)) out[i] = r["value"];
      i = i + 1;
    }
    i = JS.number(out["length"]).toInt() - 1;
    while (i >= n) {
      Schema? tail = trySchema(items[i]);
      if (tail != null) {
        Schema s = tail;
        if (s.optout == 1 && isUndef(out[i])) {
          out["length"] = i;
          i = i - 1;
          continue;
        }
      }
      break;
    }
  }

  void takeUnionResult(JsValue payload, JsValue result) {
    payload["value"] = result["value"];
    copyIssues(result["issues"], payload["issues"]);
  }

  void finishUnion(JsValue payload, JsValue results, JsValue ctx) {
    int n = JS.number(results["length"]).toInt();
    int i = 0;
    while (i < n) {
      JsValue r = results[i];
      if (!isUndef(r) && !JS.isNullish(r) && JS.number(r["issues"]["length"]).toInt() == 0) {
        this.takeUnionResult(payload, r);
        return;
      }
      i = i + 1;
    }
    JsValue alive = newArray();
    i = 0;
    while (i < n) {
      JsValue r = results[i];
      if (!isUndef(r) && !JS.isNullish(r) && !payloadAborted(r)) push(alive, r);
      i = i + 1;
    }
    if (JS.number(alive["length"]).toInt() == 1) {
      this.takeUnionResult(payload, alive[0]);
      return;
    }
    JsValue errors = newArray();
    i = 0;
    while (i < n) {
      JsValue r = results[i];
      JsValue group = newArray();
      if (!isUndef(r) && !JS.isNullish(r)) {
        JsValue issues = r["issues"];
        int k = 0;
        int kn = JS.number(issues["length"]).toInt();
        while (k < kn) {
          push(group, finalizeIssue(issues[k], this, ctx));
          k = k + 1;
        }
      }
      push(errors, group);
      i = i + 1;
    }
    push(payload["issues"], JS.object("code", "invalid_union", "errors", errors, "path", newArray()));
  }
}

JsValue localeErrorFn = undef();
JsValue customErrorFn = undef();
JsValue globalReg = undef();
JsValue versionObj = JS.object("major", 4, "minor", 4, "patch", 3);

export string typeNameOf(int kind) {
  if (kind == KString) return "string";
  if (kind == KNumber) return "number";
  if (kind == KBoolean) return "boolean";
  if (kind == KBigint) return "bigint";
  if (kind == KSymbol) return "symbol";
  if (kind == KDate) return "date";
  if (kind == KNan) return "nan";
  if (kind == KUndefined) return "undefined";
  if (kind == KNull) return "null";
  if (kind == KAny) return "any";
  if (kind == KUnknown) return "unknown";
  if (kind == KNever) return "never";
  if (kind == KVoid) return "void";
  if (kind == KLiteral) return "literal";
  if (kind == KEnum) return "enum";
  if (kind == KObject) return "object";
  if (kind == KArray) return "array";
  if (kind == KTuple) return "tuple";
  if (kind == KRecord) return "record";
  if (kind == KMap) return "map";
  if (kind == KSet) return "set";
  if (kind == KUnion) return "union";
  if (kind == KXor) return "union";
  if (kind == KIntersection) return "intersection";
  if (kind == KOptional) return "optional";
  if (kind == KNullable) return "nullable";
  if (kind == KDefault) return "default";
  if (kind == KPrefault) return "prefault";
  if (kind == KCatch) return "catch";
  if (kind == KNonoptional) return "nonoptional";
  if (kind == KLazy) return "lazy";
  if (kind == KPromise) return "promise";
  if (kind == KTransform) return "transform";
  if (kind == KPipe) return "pipe";
  if (kind == KReadonly) return "readonly";
  if (kind == KCustom) return "custom";
  if (kind == KFile) return "file";
  if (kind == KInstanceof) return "custom";
  if (kind == KSuccess) return "success";
  if (kind == KFunction) return "function";
  if (kind == KTemplateLiteral) return "template_literal";
  return "custom";
}

export int registerSchema(Schema schema) {
  int id = nextId;
  nextId = nextId + 1;
  bag.push(schema);
  schema.id = id;
  return id;
}

export Schema schemaOf(JsValue inst) {
  return bag[JS.number(inst["_zod"]["id"]).toInt()];
}

export Schema? trySchema(JsValue inst) {
  if (JS.isNullish(inst) || !isObj(inst)) {
    return null;
  }
  JsValue zint = inst["_zod"];
  if (JS.isNullish(zint) || isUndef(zint["id"])) {
    return null;
  }
  int id = JS.number(zint["id"]).toInt();
  if (id < 0 || id >= bag.length) {
    return null;
  }
  return bag[id];
}

export Schema makeSchema(JsValue def) {
  return new Schema(def);
}

export string parsedType(JsValue data) {
  if (isUndef(data)) return "undefined";
  if (JS.isNullish(data) && !isUndef(data)) return "null";
  string t = typeOf(data);
  if (t == "number") {
    if (isNaNNum(data)) return "nan";
    if (!isFiniteNum(data)) return toStr(data);
    return "number";
  }
  if (t == "object") {
    if (JS.isNullish(data)) return "null";
    if (isArr(data)) return "array";
    JsValue proto = getPrototypeOf(data);
    if (!JS.strictEqual(proto, gObject()["prototype"]) && isFn(data["constructor"])) {
      string name = toStr(data["constructor"]["name"]);
      if (name.length > 0) return name;
    }
    return "object";
  }
  return t;
}

string formatNoun(string format) {
  if (format == "regex") return "input";
  if (format == "email") return "email address";
  if (format == "url") return "URL";
  if (format == "emoji") return "emoji";
  if (format == "uuid") return "UUID";
  if (format == "uuidv4") return "UUIDv4";
  if (format == "uuidv6") return "UUIDv6";
  if (format == "uuidv7") return "UUIDv7";
  if (format == "nanoid") return "nanoid";
  if (format == "guid") return "GUID";
  if (format == "cuid") return "cuid";
  if (format == "cuid2") return "cuid2";
  if (format == "ulid") return "ULID";
  if (format == "xid") return "XID";
  if (format == "ksuid") return "KSUID";
  if (format == "datetime") return "ISO datetime";
  if (format == "date") return "ISO date";
  if (format == "time") return "ISO time";
  if (format == "duration") return "ISO duration";
  if (format == "ipv4") return "IPv4 address";
  if (format == "ipv6") return "IPv6 address";
  if (format == "mac") return "MAC address";
  if (format == "cidrv4") return "IPv4 range";
  if (format == "cidrv6") return "IPv6 range";
  if (format == "base64") return "base64-encoded string";
  if (format == "base64url") return "base64url-encoded string";
  if (format == "json_string") return "JSON string";
  if (format == "e164") return "E.164 number";
  if (format == "credit_card") return "credit card number";
  if (format == "jwt") return "JWT";
  if (format == "template_literal") return "input";
  return format;
}

export string stringifyPrimitive(JsValue value) {
  if (isBig(value)) return toStr(value) + "n";
  if (isStr(value)) return "\"" + toStr(value) + "\"";
  if (isUndef(value)) return "undefined";
  if (JS.isNullish(value)) return "null";
  return toStr(value);
}

JsValue joinValues(JsValue values, string sep) {
  JsValue out = "";
  int n = JS.number(values["length"]).toInt();
  int i = 0;
  while (i < n) {
    if (i > 0) out = JS.add(out, sep);
    out = JS.add(out, stringifyPrimitive(values[i]));
    i = i + 1;
  }
  return out;
}

export string localeMessage(JsValue issue) {
  string code = toStr(issue["code"]);
  if (code == "invalid_type") {
    string expected = toStr(issue["expected"]);
    if (expected == "nan") expected = "NaN";
    string received = parsedType(issue["input"]);
    if (received == "nan") received = "NaN";
    if (received == "number" && isNum(issue["input"]) && !isFiniteNum(issue["input"])) {
      received = toStr(issue["input"]);
    }
    return "Invalid input: expected " + expected + ", received " + received;
  }
  if (code == "invalid_value") {
    JsValue values = issue["values"];
    if (isUndef(values) || JS.isNullish(values) || !isArr(values)) return "Invalid input";
    if (JS.number(values["length"]).toInt() == 1) {
      return "Invalid input: expected " + stringifyPrimitive(values[0]);
    }
    return "Invalid option: expected one of " + toStr(joinValues(values, "|"));
  }
  if (code == "too_big") {
    string adj = ">";
    if (issue["exact"].truthy()) adj = "exactly ";
    else if (!JS.strictEqual(issue["inclusive"], false)) adj = "<=";
    else adj = "<";
    string origin = "value";
    if (!isUndef(issue["origin"])) origin = toStr(issue["origin"]);
    if (origin == "string") return "Too big: expected string to have " + adj + toStr(issue["maximum"]) + " characters";
    if (origin == "array") return "Too big: expected array to have " + adj + toStr(issue["maximum"]) + " items";
