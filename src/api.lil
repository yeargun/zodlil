}

export JsValue schemaSuccess(JsValue inner) {
  return construct1(ZodSuccess, JS.object("type", "success", "innerType", inner));
}

export JsValue schemaPartialRecord(JsValue key, JsValue val, JsValue params) {
  JsValue inst = schemaRecord(key, val, params);
  schemaOf(inst).def["partial"] = true;
  return inst;
}

export JsValue schemaJson(JsValue params) {
  JsValue jsonSchema = undef();
  jsonSchema = schemaLazy(JS.method0((JsValue _s) => {
    JsValue opts = newArray();
    push(opts, schemaString(params));
    push(opts, schemaNumber(undef()));
    push(opts, schemaBoolean(undef()));
    push(opts, schemaNull());
    push(opts, schemaArray(jsonSchema, undef()));
    push(opts, schemaRecord(schemaString(undef()), jsonSchema, undef()));
    return schemaUnion(opts, undef());
  }));
  return jsonSchema;
}

export JsValue schemaFormat(JsValue ctor, string format, JsValue regex, JsValue params) {
  JsValue use = ctor;
  if (isUndef(ctor) || JS.isNullish(ctor)) use = ZodString;
  JsValue def = typedDef("string", params);
  def["format"] = format;
  def["check"] = "string_format";
  if (!isUndef(regex) && !JS.isNullish(regex)) def["pattern"] = regex;
  return construct1(use, def);
}

export JsValue schemaHex(JsValue params) {
  return schemaFormat(undef(), "hex", regexJs(hexRe), params);
}

export JsValue schemaHostname(JsValue params) {
  return schemaFormat(undef(), "hostname", regexJs(hostnameRe), params);
}

export JsValue schemaHttpUrl(JsValue params) {
  JsValue def = typedDef("string", params);
  def["format"] = "url";
  def["check"] = "string_format";
  def["abort"] = false;
  def["protocol"] = regexJs(httpProtocolRe);
  def["hostname"] = regexJs(domainRe);
  return construct1(ZodURL, def);
}

export JsValue schemaCreditCard(JsValue params) {
  return schemaFormat(undef(), "credit_card", regexJs(creditCardRe), params);
}

export JsValue schemaMac(JsValue params) {
  JsValue delim = ":";
  if (isObj(params) && isStr(params["delimiter"])) delim = params["delimiter"];
  string d = toStr(delim);
  JsValue re = newRegex("^(?:[0-9A-F]{2}" + d + "){5}[0-9A-F]{2}$|^(?:[0-9a-f]{2}" + d + "){5}[0-9a-f]{2}$", "");
  return schemaFormat(undef(), "mac", re, params);
}

export JsValue schemaLooseRecord(JsValue key, JsValue val, JsValue params) {
  JsValue inst = schemaRecord(key, val, params);
  schemaOf(inst).def["mode"] = "loose";
  return inst;
}

export JsValue schemaHash(JsValue alg, JsValue params) {
  string encoding = "hex";
  if (isObj(params) && isStr(params["enc"])) encoding = toStr(params["enc"]);
  string name = toStr(alg) + "_" + encoding;
  string a = toStr(alg);
  JsValue re = regexJs(sha256HexRe);
  if (encoding == "hex") {
    if (a == "md5") re = regexJs(md5HexRe);
    if (a == "sha1") re = regexJs(sha1HexRe);
    if (a == "sha256") re = regexJs(sha256HexRe);
    if (a == "sha384") re = regexJs(sha384HexRe);
    if (a == "sha512") re = regexJs(sha512HexRe);
  }
  if (encoding == "base64") {
    if (a == "md5") re = newRegex("^[A-Za-z0-9+/]{22}==$", "");
    if (a == "sha1") re = newRegex("^[A-Za-z0-9+/]{27}=$", "");
    if (a == "sha256") re = newRegex("^[A-Za-z0-9+/]{43}=$", "");
    if (a == "sha384") re = newRegex("^[A-Za-z0-9+/]{64}$", "");
    if (a == "sha512") re = newRegex("^[A-Za-z0-9+/]{86}==$", "");
  }
  if (encoding == "base64url") {
    if (a == "md5") re = newRegex("^[A-Za-z0-9_-]{22}$", "");
    if (a == "sha1") re = newRegex("^[A-Za-z0-9_-]{27}$", "");
    if (a == "sha256") re = newRegex("^[A-Za-z0-9_-]{43}$", "");
    if (a == "sha384") re = newRegex("^[A-Za-z0-9_-]{64}$", "");
    if (a == "sha512") re = newRegex("^[A-Za-z0-9_-]{86}$", "");
  }
  return schemaFormat(undef(), name, re, params);
}

export JsValue schemaInt(JsValue params) {
  return withCheck(schemaNumber(params), createCheck("number_format", JS.object("format", "int")));
}

export JsValue schemaNumberFormat(string format, JsValue params) {
  return withCheck(schemaNumber(params), createCheck("number_format", JS.object("format", format)));
}

export JsValue schemaTemplateLiteral(JsValue parts, JsValue params) {
  JsValue def = typedDef("template_literal", params);
  def["parts"] = parts;
  JsValue inst = construct1(ZodTemplateLiteral, def);
  defineProperty(inst["_zod"], "pattern", JS.object(
    "value", schemaOf(inst).templatePattern(parts),
    "writable", true,
    "configurable", true,
    "enumerable", true
  ));
  return inst;
}

export JsValue schemaStringFormat(JsValue format, JsValue fnOrRegex, JsValue params) {
  JsValue def = typedDef("string", params);
  def["check"] = "string_format";
  def["format"] = format;
  if (isFn(fnOrRegex)) def["fn"] = fnOrRegex;
  if (isObj(fnOrRegex) && !isNullish(fnOrRegex) && isFn(fnOrRegex["test"])) {
    def["pattern"] = fnOrRegex;
    if (isUndef(def["fn"])) {
      def["fn"] = JS.method1((JsValue _s, JsValue val) => {
        return invoke1(fnOrRegex, "test", val);
      });
    }
  }
  return construct1(ZodString, def);
}

export JsValue schemaProperty(JsValue property, JsValue schema, JsValue params) {
  JsValue fields = JS.object("property", property, "schema", schema);
  objectAssign(fields, normalizeParams(params));
  return createCheck("property", fields);
}

export JsValue schemaFunction(JsValue params) {
  JsValue input = undef();
  JsValue output = undef();
  if (isObj(params) && !isNullish(params)) {
    input = params["input"];
    output = params["output"];
  }
  if (isArr(input)) input = schemaTuple(input, undef(), undef());
  if (isUndef(input)) input = schemaArray(schemaUnknown(), undef());
  if (isUndef(output)) output = schemaUnknown();
  return construct1(ZodFunction, JS.object("type", "function", "input", input, "output", output));
}

JsValue addFormat(JsValue inst, string format, JsValue regex, JsValue params) {
  JsValue fields = JS.object("format", format, "pattern", regex);
  string msg = toStr(paramMessage(params));
  if (msg.length > 0) fields["error"] = msg;
  return withCheck(inst, createCheck("string_format", fields));
}

