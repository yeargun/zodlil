import {
  construct1,
  gArray,
  gError,
  gNumber,
  invoke1,
  isArr,
  isFn,
  isNullish,
  isObj,
  isPromise,
  isStr,
  isUndef,
  len,
  newArray,
  objectAssign,
  push,
  toNum,
  toStr,
  typeOf,
  undef,
  yes
} from "./host.lil";
import { typeIssue } from "./engine.lil";

// The engine's parse/run pair covers every schema kind, jitless mode,
// recursion and async; nothing here re-implements it or compiles source text
// with `new Function` (which a CSP without 'unsafe-eval' forbids). What this
// module adds is what upstream's own parsers and checks do that the engine's
// leave out: the issue a schema raises about its own input carries `inst` (so
// that schema's error map and registry metadata own it), and the common
// checks run as upstream states them, with their `abort`.

// kind 0: string/number/boolean (the engine parses, coercion included, and
// the one issue it can raise is the schema's own); 1: object; 2: array (the
// shape is tested first, as upstream does, so a wrong input never reaches the
// engine's recursion memo). Called as the schema's run it goes through the
// engine's run; called under the checks below it only parses.
JsValue gate(JsValue parse, JsValue run, JsValue inst, int kind) {
  string expected = "object";
  if (kind == 2) expected = "array";
  JsValue self = undef();
  self = (JsValue payload, JsValue ctx) => {
    JsValue input = payload["value"];
    JsValue issues = payload["issues"];
    int n = len(issues);
    if (kind == 0 || isArr(input) == (kind == 2) && (kind == 2 || isObj(input))) {
      JsValue next = parse;
      if (JS.strictEqual(inst["_zod"]["run"], self)) next = run;
      JsValue result = JS.call(next, undef(), payload, ctx);
      if (kind == 0 && len(issues) > n) issues[n]["inst"] = inst;
      return result;
    }
    JsValue issue = typeIssue(expected, input);
    issue["inst"] = inst;
    push(issues, issue);
    return payload;
  };
  return self;
}

export JsValue stringParseFact = (JsValue inst) => gate(inst["_zod"]["parse"], inst["_zod"]["run"], inst, 0);

export JsValue objectParseFor(JsValue parseFallback, JsValue runFallback, JsValue inst) {
  return gate(parseFallback, runFallback, inst, 1);
}

export JsValue arrayParseFor(JsValue parseFallback, JsValue runFallback, JsValue inst) {
  return gate(parseFallback, runFallback, inst, 2);
}

// The checks stated below. A schema whose checks are all of these runs them
// here, after its own parse, the way upstream's run does; any other check
// sends the schema to the engine's run.
bool ours(JsValue def) {
  string name = toStr(def["check"]);
  return name.endsWith("length") || name.endsWith("than") || name == "number_format" || name == "string_format" && toStr(def["format"]) == "email" && def["pattern"].truthy();
}

export JsValue collectJsChecks(JsValue inst) {
  JsValue list = newArray();
  JsValue def = inst["_zod"]["def"];
  if (isStr(def["check"])) push(list, inst);
  if (isArr(def["checks"])) list = invoke1(list, "concat", def["checks"]);
  return list;
}

JsValue runChecks(JsValue checks, JsValue payload, JsValue owner) {
  JsValue issues = payload["issues"];
  invoke1(checks, "forEach", (JsValue ch) => {
    JsValue when = ch["_zod"]["def"]["when"];
    bool own = isFn(when);
    bool run = !invoke1(issues, "some", (JsValue issue) => JS.strictEqual(issue["continue"], false) || !own && !JS.strictEqual(issue["continue"], true)).truthy();
    if (run && own) run = JS.call(when, undef(), payload).truthy();
    if (run) {
      int start = len(issues);
      JS.invoke(ch["_zod"], "check", payload);
      invoke1(invoke1(issues, "slice", start), "forEach", (JsValue issue) => {
        if (isUndef(issue["schema"])) issue["schema"] = owner;
        return undef();
      });
    }
    return undef();
  });
  return payload;
}

export JsValue bindRun(JsValue parseFn, JsValue checks, JsValue fallback, JsValue intern, JsValue owner) {
  if (len(checks) == 0) return parseFn;
  if (!invoke1(checks, "every", (JsValue ch) => ours(ch["_zod"]["def"])).truthy()) return fallback;
  return (JsValue payload, JsValue ctx) => {
    if (!isNullish(ctx)) {
      if (JS.strictEqual(ctx["direction"], "backward")) return JS.call(fallback, undef(), payload, ctx);
      if (yes(ctx["skipChecks"])) return JS.call(parseFn, undef(), payload, ctx);
    }
    JsValue result = JS.call(parseFn, undef(), payload, ctx);
    if (isPromise(result)) return invoke1(result, "then", (JsValue next) => runChecks(checks, next, owner));
    return runChecks(checks, result, owner);
  };
}

// Check bodies, as upstream's `_zod.check` functions state them.

// min_length / max_length (length) and greater_than / less_than.
JsValue sizeCheck(JsValue def, JsValue inst, bool max, bool length) {
  string key = "minimum";
  string code = "too_small";
  if (max) {
    key = "maximum";
    code = "too_big";
  }
  return (JsValue payload) => {
    JsValue input = payload["value"];
    JsValue size = input;
    JsValue bound = def["value"];
    bool inclusive = !JS.strictEqual(def["inclusive"], false);
    string t = typeOf(input);
    string origin = t;
    if (t == "object") origin = "date";
    else if (t != "number" && t != "bigint") origin = toStr(def["origin"]);
    if (length) {
      size = input["length"];
      if (isStr(input)) size = invoke1(gArray(), "from", input)["length"];
      bound = def[key];
      inclusive = true;
      origin = "unknown";
      if (isArr(input)) origin = "array";
      if (isStr(input)) origin = "string";
    }
    JsValue hi = size;
    JsValue lo = bound;
    if (max) {
      hi = bound;
      lo = size;
    }
    if (inclusive && JS.greaterThanOrEqual(hi, lo) || !inclusive && JS.greaterThan(hi, lo)) return undef();
    JsValue issue = JS.object("origin", origin, "code", code);
    issue[key] = bound;
    if (isObj(bound) && isFn(bound["getTime"])) issue[key] = JS.invoke(bound, "getTime");
    issue["inclusive"] = inclusive;
    issue["input"] = input;
    issue["inst"] = inst;
    issue["continue"] = !def["abort"].truthy();
    push(payload["issues"], issue);
    return undef();
  };
}

JsValue formatCheck(JsValue def, JsValue inst) {
  string format = toStr(def["format"]);
  if (format == "int") format = "safeint";
  bool isInt = format.includes("int");
  float hi = 1.0 / 0.0;
  if (format == "int32") hi = 2147483647.0;
  if (format == "uint32") hi = 4294967295.0;
  if (format == "float32") hi = 3.4028234663852886e38;
  float lo = -hi;
  if (format == "int32") lo = -hi - 1.0;
  if (format == "uint32") lo = 0.0;
  return (JsValue payload) => {
    JsValue input = payload["value"];
    JsValue issues = payload["issues"];
    bool cont = !def["abort"].truthy();
    if (isInt) {
      if (!JS.invoke(gNumber(), "isInteger", input).truthy()) {
        push(issues, JS.object("expected", "int", "format", format, "code", "invalid_type", "continue", false, "input", input, "inst", inst));
        return undef();
      }
      if (!JS.invoke(gNumber(), "isSafeInteger", input).truthy()) {
        JsValue issue = JS.object("input", input, "code", "too_small", "minimum", -9007199254740991.0);
        if (toNum(input) > 0.0) issue = JS.object("input", input, "code", "too_big", "maximum", 9007199254740991.0);
        issue["note"] = "Integers must be within the safe integer range.";
        issue["inst"] = inst;
        issue["origin"] = "int";
        issue["inclusive"] = true;
        issue["continue"] = cont;
        push(issues, issue);
        return undef();
      }
    }
    float v = toNum(input);
    if (v < lo || v > hi) {
      JsValue issue = JS.object("origin", "number", "input", input, "code", "too_small", "minimum", lo);
      if (v > hi) issue = JS.object("origin", "number", "input", input, "code", "too_big", "maximum", hi);
      issue["inclusive"] = true;
      issue["inst"] = inst;
      issue["continue"] = cont;
      push(issues, issue);
    }
    return undef();
  };
}

JsValue patternCheck(JsValue def, JsValue inst) {
  return (JsValue payload) => {
    JsValue pattern = def["pattern"];
    pattern["lastIndex"] = 0;
    if (JS.invoke(pattern, "test", payload["value"]).truthy()) return undef();
    push(payload["issues"], JS.object("origin", "string", "code", "invalid_format", "format", def["format"], "input", payload["value"], "pattern", toStr(pattern), "inst", inst, "continue", !def["abort"].truthy()));
    return undef();
  };
}

export void attachJsCheck(JsValue inst) {
  JsValue intern = inst["_zod"];
  JsValue def = intern["def"];
  if (isFn(intern["check"]) || !ours(def)) return;
  string name = toStr(def["check"]);
  if (name == "number_format") intern["check"] = formatCheck(def, inst);
  else if (name == "string_format") intern["check"] = patternCheck(def, inst);
  else intern["check"] = sizeCheck(def, inst, name.startsWith("max") || name.startsWith("less"), name.endsWith("length"));
}

// parse / safeParse bound to one schema.
JsValue boundParse(JsValue intern, JsValue fail, bool safe) {
  return (JsValue data, JsValue params) => {
    JsValue ctx = objectAssign(JS.object(), params);
    ctx["async"] = false;
    JsValue result = JS.invoke(intern, "run", JS.object("value", data, "issues", newArray()), ctx);
    if (isPromise(result)) throw construct1(gError(), "Encountered Promise during synchronous parse. Use .parseAsync() instead.");
    if (len(result["issues"]) > 0) return JS.call(fail, undef(), result, ctx);
    if (safe) return JS.object("success", true, "data", result["value"]);
    return result["value"];
  };
}

export JsValue makeBoundParseFn = (JsValue intern, JsValue fail) => boundParse(intern, fail, false);

export JsValue makeBoundSafeParseFn = (JsValue intern, JsValue fail) => boundParse(intern, fail, true);
