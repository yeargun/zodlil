bool pipeBlocked(JsValue payload) {
  JsValue issues = payload["issues"];
  int i = 0;
  int n = JS.number(issues["length"]).toInt();
  while (i < n) {
    if (toStr(issues[i]["code"]) != "unrecognized_keys") return true;
    i = i + 1;
  }
  return false;
}

JsValue parseAfterTransform(Schema schema, JsValue payload, JsValue ctx, Schema? right) {
  if (right != null) return runOnPayload(right, payload, ctx);
  return payload;
}

JsValue parseAfterLeft(Schema schema, JsValue payload, JsValue ctx) {
  if (pipeBlocked(payload)) {
    payload["aborted"] = true;
    return payload;
