              } else {
                if (JS.strictEqual(cont, true) == false) aborted = true;
              }
              ai = ai + 1;
            }
          }
          bool skip = false;
          if (hasWhen) {
            if (len(pl["issues"]) > 0 && aborted) skip = true;
            if (!skip && !call1(cdef["when"], undef(), pl).truthy()) skip = true;
          } else {
            if (len(pl["issues"]) > 0 && aborted) skip = true;
          }
          if (!skip) {
            JsValue fn = cin["check"];
            if (!isFn(fn)) return call2(fallback, self, pl, ctx);
            JsValue ret = call1(fn, ch, pl);
            if (isPromise(ret)) {
              if (!isUndef(ctx) && isNullish(ctx) == false && JS.strictEqual(ctx["async"], false)) {
                throw construct1(gError(), "Encountered Promise during synchronous parse. Use .parseAsync() instead.");
              }
