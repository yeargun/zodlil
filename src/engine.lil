import {
  apply,
  asyncImplement,
  assignProp,
  call0,
  call1,
  call2,
  captureStackTrace,
  construct1,
  copyOwn,
  defineProperty,
  gArray,
  gDate,
  gError,
  gGlobal,
  gMap,
  gNumber,
  gObject,
  gSet,
  gString,
  gSymbol,
  gURL,
  getPrototypeOf,
  hasOwn,
  hiddenValue,
  invoke0,
  invoke1,
  getDescriptor,
  getProp,
  isArr,
  isBig,
  isBool,
  isDate,
  isFn,
  isInstance,
  isNum,
  isObj,
  isPromise,
  isStr,
  isSym,
  isUndef,
  mapGet,
  mapHas,
  mapSet,
  newError,
  newMap,
  newSet,
  newWeakMap,
  objectAssign,
  objectCreate,
  objectIs,
  objectKeys,
  ownKeys,
  promiseAll,
  promiseResolve,
  propertyIsEnumerable,
  push,
  regexTest,
  setAdd,
  setDelete,
