export JsValue jsCheckFor(string name, JsValue def, JsValue inst) {
  if (name == "number_format") return call2(numberFormatCheckFact, undef(), def, inst);
  if (name == "min_length") return call2(minLengthCheckFact, undef(), def, inst);
  if (name == "max_length") return call2(maxLengthCheckFact, undef(), def, inst);
  if (name == "greater_than") return call2(greaterThanCheckFact, undef(), def, inst);
  if (name == "less_than") return call2(lessThanCheckFact, undef(), def, inst);
  if (name == "string_format") {
    if (isUndef(def["pattern"]) || isStr(def["format"]) == false) return undef();
    if (toStr(def["format"]) != "email") return undef();
    return call2(stringFormatCheckFact, undef(), def, inst);
  }
  return undef();
}

export void attachJsCheck(JsValue inst) {
  if (isUndef(inst)) return;
  if (isUndef(inst["_zod"])) return;
  JsValue intern = inst["_zod"];
  if (!isFn(intern["check"])) {
    JsValue def = intern["def"];
    if (isStr(def["check"])) {
      JsValue fn = jsCheckFor(toStr(def["check"]), def, inst);
      if (!isUndef(fn)) intern["check"] = fn;
    }
  }
}

export JsValue collectJsChecks(JsValue inst) {
  JsValue list = newArray();
  JsValue def = inst["_zod"]["def"];
  if (isStr(def["check"])) push(list, inst);
  JsValue chs = def["checks"];
  if (!isUndef(chs) && JS.isArray(chs)) {
    int i = 0;
    int n = len(chs);
    while (i < n) {
      attachJsCheck(chs[i]);
      push(list, chs[i]);
      i = i + 1;
    }
  }
  return list;
}

export bool checksAreJs(JsValue checks) {
  int i = 0;
  int n = len(checks);
  while (i < n) {
    JsValue ch = checks[i];
    if (isUndef(ch["_zod"]) || isFn(ch["_zod"]["check"]) == false) return false;
    i = i + 1;
  }
  return true;
}

