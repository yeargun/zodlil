  JsValue minBound() {
    JsValue checks = this.def["checks"];
    if (isUndef(checks) || !isArr(checks)) return null;
    JsValue found = null;
    int i = 0;
    int n = JS.number(checks["length"]).toInt();
    while (i < n) {
      JsValue cdef = checkDef(checks[i]);
      if (toStr(cdef["check"]) == "greater_than") {
        if (!JS.strictEqual(cdef["inclusive"], false)) found = cdef["value"];
      }
      i = i + 1;
    }
    return found;
  }

  JsValue maxBound() {
    JsValue checks = this.def["checks"];
    if (isUndef(checks) || !isArr(checks)) return null;
    JsValue found = null;
    int i = 0;
    int n = JS.number(checks["length"]).toInt();
    while (i < n) {
      JsValue cdef = checkDef(checks[i]);
      if (toStr(cdef["check"]) == "less_than") {
