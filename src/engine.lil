JsValue mergeValues(JsValue a, JsValue b) {
  if (objectIs(a, b)) return JS.object("valid", true, "data", a);
  if (isDate(a) && isDate(b) && JS.strictEqual(invoke0(a, "getTime"), invoke0(b, "getTime"))) {
    return JS.object("valid", true, "data", a);
