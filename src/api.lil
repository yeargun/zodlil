JsValue ctorFor(int kind) {
  if (kind == KString) return ZodString;
  if (kind == KNumber) return ZodNumber;
  if (kind == KBoolean) return ZodBoolean;
  if (kind == KBigint) return ZodBigInt;
  if (kind == KSymbol) return ZodSymbol;
  if (kind == KDate) return ZodDate;
  if (kind == KNan) return ZodNaN;
  if (kind == KUndefined) return ZodUndefined;
  if (kind == KNull) return ZodNull;
  if (kind == KAny) return ZodAny;
  if (kind == KUnknown) return ZodUnknown;
  if (kind == KNever) return ZodNever;
  if (kind == KVoid) return ZodVoid;
  if (kind == KLiteral) return ZodLiteral;
  if (kind == KEnum) return ZodEnum;
  if (kind == KObject) return ZodObject;
  if (kind == KArray) return ZodArray;
  if (kind == KTuple) return ZodTuple;
  if (kind == KRecord) return ZodRecord;
  if (kind == KMap) return ZodMap;
  if (kind == KSet) return ZodSet;
  if (kind == KUnion) return ZodUnion;
  if (kind == KXor) return ZodXor;
  if (kind == KIntersection) return ZodIntersection;
  if (kind == KOptional) return ZodOptional;
  if (kind == KNullable) return ZodNullable;
  if (kind == KDefault) return ZodDefault;
  if (kind == KPrefault) return ZodPrefault;
  if (kind == KCatch) return ZodCatch;
  if (kind == KNonoptional) return ZodNonOptional;
  if (kind == KLazy) return ZodLazy;
  if (kind == KPromise) return ZodPromise;
  if (kind == KTransform) return ZodTransform;
  if (kind == KPipe) return ZodPipe;
  if (kind == KReadonly) return ZodReadonly;
  if (kind == KCustom) return ZodCustom;
  if (kind == KFile) return ZodFile;
  if (kind == KSuccess) return ZodSuccess;
  if (kind == KFunction) return ZodFunction;
  if (kind == KTemplateLiteral) return ZodTemplateLiteral;
  return ZodType;
}

JsValue typedDef(string typ, JsValue params) {
  JsValue def = JS.object("type", typ);
  objectAssign(def, normalizeParams(params));
  return def;
}

JsValue checked(JsValue inst, string name, JsValue fields, JsValue params) {
  objectAssign(fields, normalizeParams(params));
  return withCheck(inst, createCheck(name, fields));
}

JsValue cloneInst(JsValue inst) {
  return cloneWithDef(inst, undef());
}

JsValue wrap(int kind, JsValue inner, JsValue params) {
  JsValue def = typedDef(typeNameOf(kind), params);
  def["innerType"] = inner;
  return construct1(ctorFor(kind), def);
}

JsValue shapeOf(JsValue inst) {
  JsValue sh = schemaOf(inst).def["shape"];
  if (isUndef(sh) || isNullish(sh)) return JS.object();
  return sh;
}

bool objectHasChecks(JsValue inst) {
  JsValue checks = schemaOf(inst).def["checks"];
  return isArr(checks) && JS.number(checks["length"]).toInt() > 0;
}

void assertMaskKeys(JsValue shape, JsValue mask) {
  JsValue keys = ownKeys(mask);
  int i = 0;
  int n = JS.number(keys["length"]).toInt();
  while (i < n) {
    if (!isStr(keys[i])) {
      i = i + 1;
      continue;
    }
    if (!hasOwn(shape, keys[i])) {
      throw newError("Unrecognized key: \"" + toStr(keys[i]) + "\"");
    }
    i = i + 1;
  }
}

JsValue overlayShapeGetter(JsValue srcInst, JsValue incoming) {
  JsValue overlay = JS.object();
  defineProperty(overlay, "shape", JS.object(
    "configurable", true,
    "enumerable", true,
    "get", JS.method0((JsValue self) => {
      JsValue next = JS.object();
      copyOwn(next, shapeOf(srcInst));
      if (!isUndef(incoming) && isObj(incoming) && !isNullish(incoming)) copyOwn(next, incoming);
      defineProperty(self, "shape", JS.object("value", next, "writable", true, "enumerable", true, "configurable", true));
      return next;
    })
  ));
  return overlay;
}

JsValue remapObjectFields(JsValue inst, JsValue mask, bool optionalize, bool exact) {
  if (optionalize && objectHasChecks(inst)) {
    if (exact) throw newError(".exactPartial() cannot be used on object schemas containing refinements");
    throw newError(".partial() cannot be used on object schemas containing refinements");
  }
  JsValue srcInst = inst;
  JsValue def = copyDescriptors(JS.object(), schemaOf(inst).def);
  defineProperty(def, "shape", JS.object(
    "configurable", true,
    "enumerable", true,
    "get", JS.method0((JsValue self) => {
      JsValue src = schemaOf(srcInst).def["shape"];
      if (isUndef(src) || isNullish(src)) src = JS.object();
      if (!isUndef(mask) && !JS.isNullish(mask)) assertMaskKeys(src, mask);
      JsValue keys = ownKeys(src);
      JsValue shape = JS.object();
      int i = 0;
      int n = JS.number(keys["length"]).toInt();
      while (i < n) {
        JsValue key = keys[i];
        if (!isStr(key)) {
          i = i + 1;
          continue;
        }
        JsValue field = src[key];
        bool take = isUndef(mask) || JS.isNullish(mask) || mask[key].truthy();
        if (take) {
          if (optionalize) {
            if (exact) field = construct1(ZodExactOptional, JS.object("type", "optional", "innerType", field, "exact", true));
            else field = wrap(KOptional, field, undef());
          } else {
            field = wrap(KNonoptional, field, undef());
          }
        }
        assignProp(shape, key, field);
        i = i + 1;
      }
      defineProperty(self, "shape", JS.object("value", shape, "writable", true, "enumerable", true, "configurable", true));
      return shape;
    })
  ));
  if (optionalize) def["checks"] = newArray();
  return construct1(ZodObject, def);
}

export JsValue schemaString(JsValue params) {
  return construct1(ZodString, typedDef("string", params));
}

export JsValue schemaNumber(JsValue params) {
  return construct1(ZodNumber, typedDef("number", params));
}

export JsValue schemaBoolean(JsValue params) {
  return construct1(ZodBoolean, typedDef("boolean", params));
}

export JsValue schemaBigint(JsValue params) {
  return construct1(ZodBigInt, typedDef("bigint", params));
}

export JsValue schemaSymbol(JsValue params) {
  return construct1(ZodSymbol, typedDef("symbol", params));
}

export JsValue schemaDate(JsValue params) {
  return construct1(ZodDate, typedDef("date", params));
}

export JsValue schemaNan(JsValue params) {
  return construct1(ZodNaN, typedDef("nan", params));
}

export JsValue schemaUndefined() {
  return construct1(ZodUndefined, JS.object("type", "undefined"));
}

export JsValue schemaNull() {
  return construct1(ZodNull, JS.object("type", "null"));
}

export JsValue schemaAny() {
  return construct1(ZodAny, JS.object("type", "any"));
}

export JsValue schemaUnknown() {
  return construct1(ZodUnknown, JS.object("type", "unknown"));
}

export JsValue schemaNever() {
  return construct1(ZodNever, JS.object("type", "never"));
}

export JsValue schemaVoid() {
  return construct1(ZodVoid, JS.object("type", "void"));
}

export JsValue schemaLiteral(JsValue values, JsValue params) {
  JsValue list = values;
  if (!isArr(values)) {
    list = newArray();
    push(list, values);
  }
  JsValue def = typedDef("literal", params);
  def["values"] = list;
  return construct1(ZodLiteral, def);
}

export JsValue schemaEnum(JsValue entries, JsValue params) {
  JsValue obj = entries;
  if (isArr(entries)) {
    obj = JS.object();
    int i = 0;
    int n = JS.number(entries["length"]).toInt();
    while (i < n) {
      assignProp(obj, entries[i], entries[i]);
      i = i + 1;
    }
  }
  JsValue def = typedDef("enum", params);
  def["entries"] = obj;
  return construct1(ZodEnum, def);
}

export JsValue schemaObject(JsValue shape, JsValue params) {
  JsValue sh = shape;
  if (isUndef(shape) || isNullish(shape)) sh = JS.object();
  JsValue def = typedDef("object", params);
  def["shape"] = sh;
  return construct1(ZodObject, def);
}

export JsValue schemaArray(JsValue element, JsValue params) {
  JsValue def = typedDef("array", params);
  def["element"] = element;
  return construct1(ZodArray, def);
}

export JsValue schemaTuple(JsValue items, JsValue rest, JsValue params) {
  JsValue def = typedDef("tuple", params);
  def["items"] = items;
  if (!isUndef(rest) && !isNullish(rest)) def["rest"] = rest;
  return construct1(ZodTuple, def);
}

export JsValue schemaRecord(JsValue key, JsValue val, JsValue params) {
  JsValue keyType = key;
  JsValue valueType = val;
  JsValue p = params;
  if (isUndef(val) || JS.isNullish(val) || isUndef(val["_zod"])) {
    valueType = key;
    keyType = schemaString(undef());
    p = val;
  }
  JsValue def = typedDef("record", p);
  def["keyType"] = keyType;
  def["valueType"] = valueType;
  return construct1(ZodRecord, def);
}

export JsValue schemaUnion(JsValue options, JsValue params) {
  JsValue def = typedDef("union", params);
  def["options"] = options;
  return construct1(ZodUnion, def);
}

export JsValue schemaXor(JsValue options, JsValue params) {
  JsValue def = typedDef("union", params);
  def["options"] = options;
  def["inclusive"] = false;
  return construct1(ZodXor, def);
}

export JsValue schemaDiscUnion(string key, JsValue options, JsValue params) {
  JsValue def = typedDef("union", params);
  def["options"] = options;
  def["discriminator"] = key;
  def["inclusive"] = false;
  if (isArr(options)) {
    int i = 0;
    int n = JS.number(options["length"]).toInt();
    while (i < n) {
      JsValue option = options[i];
      if (isUndef(option)) {
        i = i + 1;
        continue;
      }
      if (JS.isNullish(option)) {
        i = i + 1;
        continue;
      }
      if (!isObj(option)) {
        i = i + 1;
        continue;
      }
      JsValue intern = option["_zod"];
      if (isUndef(intern)) {
        i = i + 1;
        continue;
      }
      if (JS.isNullish(intern)) {
        i = i + 1;
        continue;
      }
      JsValue odef = intern["def"];
      if (isUndef(odef)) {
        i = i + 1;
        continue;
      }
      if (JS.isNullish(odef)) {
        i = i + 1;
        continue;
      }
      JsValue propShape = shapePhase(odef);
      if (isUndef(propShape)) {
        i = i + 1;
        continue;
      }
      if (JS.isNullish(propShape)) {
        i = i + 1;
        continue;
      }
      if (!hasOwn(propShape, key)) {
        throw newError("Invalid discriminated union option at index \"" + toStr(i) + "\"");
      }
      i = i + 1;
    }
  }
  return construct1(ZodDiscriminatedUnion, def);
}

export JsValue schemaIntersection(JsValue left, JsValue right) {
  return construct1(ZodIntersection, JS.object("type", "intersection", "left", left, "right", right));
}

export JsValue schemaMap(JsValue key, JsValue val) {
  return construct1(ZodMap, JS.object("type", "map", "keyType", key, "valueType", val));
}

export JsValue schemaSetType(JsValue val, JsValue params) {
  JsValue def = typedDef("set", params);
  def["valueType"] = val;
  return construct1(ZodSet, def);
}

export JsValue schemaLazy(JsValue fn) {
  return construct1(ZodLazy, JS.object("type", "lazy", "getter", fn));
}

export JsValue schemaPromise(JsValue inner) {
  return construct1(ZodPromise, JS.object("type", "promise", "innerType", inner));
}

export JsValue schemaCheck(JsValue fn, JsValue params) {
  return createPayloadCheck(fn, params);
}

export JsValue schemaRefine(JsValue fn, JsValue params) {
  JsValue def = typedDef("custom", params);
  def["fn"] = fn;
  def["check"] = "custom";
  return construct1(ZodCustom, def);
}

export JsValue schemaSuperRefine(JsValue fn, JsValue params) {
  JsValue ch = createPayloadCheck(JS.method1((JsValue self, JsValue payload) => {
    payload["addIssue"] = JS.method1((JsValue _s, JsValue issue) => {
      JsValue next = issue;
      if (isStr(issue)) next = JS.object("message", issue, "code", "custom", "input", payload["value"], "inst", self, "path", newArray());
      else {
        if (next["fatal"].truthy()) next["continue"] = false;
        if (isUndef(next["code"])) next["code"] = "custom";
        if (!inOp("input", next)) next["input"] = payload["value"];
        if (isUndef(next["inst"])) next["inst"] = self;
        if (isUndef(next["continue"])) next["continue"] = true;
      }
      push(payload["issues"], next);
      return undef();
    });
    return call2(fn, undef(), payload["value"], payload);
  }), params);
  return ch;
}

export JsValue schemaCustom(JsValue fn, JsValue params) {
  JsValue check = fn;
  if (!isFn(fn)) {
    check = JS.method1((JsValue _s, JsValue _d) => {
      return true;
    });
  }
  JsValue def = typedDef("custom", params);
  def["fn"] = check;
  def["check"] = "custom";
  return construct1(ZodCustom, def);
}

export JsValue schemaFile(JsValue params) {
  return construct1(ZodFile, typedDef("file", params));
}

export JsValue schemaInstanceof(JsValue ctor, JsValue params) {
  JsValue def = typedDef("custom", params);
  def["check"] = "custom";
  def["abort"] = true;
  def["fn"] = JS.method1((JsValue _s, JsValue data) => {
    if (isInstance(ctor, data)) return true;
    return false;
  });
  JsValue inst = construct1(ZodCustom, def);
  schemaOf(inst).handle["_zod"]["bag"]["Class"] = ctor;
  return inst;
}

export JsValue schemaTransform(JsValue fn) {
  return construct1(ZodTransform, JS.object("type", "transform", "transform", fn));
}

export JsValue schemaPipe(JsValue left, JsValue right) {
  return construct1(ZodPipe, JS.object("type", "pipe", "in", left, "out", right));
}

export JsValue schemaCodec(JsValue inn, JsValue out, JsValue params) {
  return construct1(ZodCodec, JS.object(
    "type", "pipe",
    "in", inn,
    "out", out,
    "transform", params["decode"],
    "reverseTransform", params["encode"]
  ));
}

export JsValue schemaInvertCodec(JsValue codec) {
  Schema s = schemaOf(codec);
  return schemaCodec(s.def["out"], s.def["in"], JS.object(
    "decode", s.def["reverseTransform"],
    "encode", s.def["transform"]
  ));
}

export JsValue schemaPreprocess(JsValue fn, JsValue schema) {
  return construct1(ZodPreprocess, JS.object("type", "pipe", "in", schemaTransform(fn), "out", schema));
}

export JsValue schemaUrl(JsValue params) {
  JsValue def = typedDef("string", params);
  def["format"] = "url";
  def["check"] = "string_format";
  def["abort"] = false;
  return construct1(ZodURL, def);
}

JsValue defaultTruthy() {
  JsValue list = newArray();
  push(list, "true");
  push(list, "1");
  push(list, "yes");
  push(list, "on");
  push(list, "y");
  push(list, "enabled");
  return list;
}

JsValue defaultFalsy() {
  JsValue list = newArray();
  push(list, "false");
  push(list, "0");
  push(list, "no");
  push(list, "off");
  push(list, "n");
  push(list, "disabled");
  return list;
}

export JsValue schemaStringbool(JsValue params) {
  JsValue norm = normalizeParams(params);
  JsValue truthy = norm["truthy"];
  JsValue falsy = norm["falsy"];
  if (isUndef(truthy) || !isArr(truthy)) truthy = defaultTruthy();
  if (isUndef(falsy) || !isArr(falsy)) falsy = defaultFalsy();
  bool sensitive = false;
  if (isStr(norm["case"]) && toStr(norm["case"]) == "sensitive") sensitive = true;
  if (!sensitive) {
    JsValue t2 = newArray();
    int i = 0;
    int n = JS.number(truthy["length"]).toInt();
    while (i < n) {
      if (isStr(truthy[i])) push(t2, toStr(truthy[i]).toLowerCase());
      else push(t2, truthy[i]);
      i = i + 1;
    }
    truthy = t2;
    JsValue f2 = newArray();
    i = 0;
    n = JS.number(falsy["length"]).toInt();
    while (i < n) {
      if (isStr(falsy[i])) push(f2, toStr(falsy[i]).toLowerCase());
      else push(f2, falsy[i]);
      i = i + 1;
    }
    falsy = f2;
  }
  JsValue truthySet = newSet();
  JsValue falsySet = newSet();
  int ti = 0;
  int tn = JS.number(truthy["length"]).toInt();
  while (ti < tn) {
    setAdd(truthySet, truthy[ti]);
    ti = ti + 1;
  }
  int fi = 0;
  int fn = JS.number(falsy["length"]).toInt();
  while (fi < fn) {
    setAdd(falsySet, falsy[fi]);
    fi = fi + 1;
  }
  JsValue stringSchema = construct1(ZodString, JS.object("type", "string", "error", norm["error"]));
  JsValue booleanSchema = construct1(ZodBoolean, JS.object("type", "boolean", "error", norm["error"]));
  JsValue codec = undef();
  JsValue decode = JS.method2((JsValue _s, JsValue input, JsValue payload) => {
    string data = toStr(input);
    if (!sensitive) data = data.toLowerCase();
    if (setHas(truthySet, data).truthy()) return true;
    if (setHas(falsySet, data).truthy()) return false;
    JsValue values = newArray();
    int ti2 = 0;
    int tn2 = JS.number(truthy["length"]).toInt();
    while (ti2 < tn2) {
      push(values, truthy[ti2]);
      ti2 = ti2 + 1;
    }
    int j = 0;
    int jn = JS.number(falsy["length"]).toInt();
    while (j < jn) {
      push(values, falsy[j]);
      j = j + 1;
    }
    push(payload["issues"], JS.object(
