      JsValue[] groups = JS.assume(issue["errors"]);
      groups.forEach((JsValue group) => walkIssues(group, full, leaf));
    } else if (code == "invalid_key" || code == "invalid_element") walkIssues(issue["issues"], full, leaf);
    else leaf(full, issue);
