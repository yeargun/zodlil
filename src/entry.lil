import {
  invoke0,
  invoke1,
  objectAssign,
  undef
} from "./host.lil";
import {
  coreUtil,
  getConfig,
  datetimeRegex,
  timeRegex,
  durationRe,
  emailRe,
  guidRe,
  ipv4Re,
  ipv6Re,
  isoDateRe,
  nanoidRe,
  regexJs,
  hexRe,
  hostnameRe,
  creditCardRe,
  createPayloadCheck,
  ZodEncodeError,
  setCoerce,
  ulidRe,
  uuidRe,
  ZodError,
  ZodRealError,
  flattenError,
  formatError,
  getDiscriminatedOption,
  globalRegistry,
  makeRegistry,
  prettifyError,
  setConfig,
  toDotPath,
  treeifyError,
  safeParseInst,
  safeParseAsyncInst
} from "./engine.lil";
import {
  ZodAny,
  ZodEmail,
  ZodFile,
  ZodGUID,
  ZodISODate,
  ZodISODateTime,
  ZodISODuration,
  ZodISOTime,
  ZodJWT,
  ZodNaN,
  ZodNull,
  ZodString,
  ZodSymbol,
  ZodUUID,
  ZodUndefined,
  ZodVoid,
  boot,
  schemaTyped,
  selfKeyed,
  ctors,
  localesEn,
  decodeApi,
  decodeAsyncApi,
  encodeApi,
  encodeAsyncApi,
  parseApi,
  parseAsyncApi,
  objectOf,
  schemaArray,
  schemaBigint,
  schemaBoolean,
  schemaCustom,
  schemaDate,
  schemaDiscUnion,
  schemaEnum,
  schemaFunction,
  schemaTemplateLiteral,
  schemaStringFormat,
  schemaProperty,
  schemaInstanceof,
  schemaNumberFormat,
  schemaIntersection,
  schemaLazy,
  schemaLiteral,
  schemaMap,
  schemaNever,
  schemaNumber,
  schemaObject,
  schemaPipe,
  schemaCodec,
  schemaInvertCodec,
  schemaPreprocess,
  schemaUrl,
  schemaHttpUrl,
  schemaStringbool,
  schemaSuccess,
  schemaJson,
  schemaHash,
  schemaMac,
  schemaFormat,
  schemaPromise,
  schemaRecord,
  schemaSetType,
  schemaString,
  schemaTransform,
  schemaTuple,
  schemaUnion,
  schemaUnknown,
  schemaXor,
  schemaExactOptional,
  schemaProperties,
  schemaSlugifyCheck,
  schemaTrimCheck,
  schemaMaxLengthCheck,
  schemaMinLengthCheck,
  schemaRefine,
  schemaSuperRefine
} from "./api.lil";

boot();

JsValue coerced(JsValue inst) {
  setCoerce(inst);
  return inst;
}

JsValue defaultFn = (JsValue schema, JsValue value) => invoke1(schema, "default", value);

JsValue core = JS.object();
JsValue issueCodes = selfKeyed(JS.invoke("invalid_type too_big too_small invalid_format not_multiple_of unrecognized_keys invalid_union invalid_key invalid_element invalid_value custom", "split", " "));
JsValue globalReg = globalRegistry();

JsValue zObj = JS.object(
  "string", schemaString,
  "number", schemaNumber,
  "boolean", schemaBoolean,
  "bigint", schemaBigint,
  "symbol", (JsValue params) => schemaTyped(ZodSymbol, "symbol", params),
  "date", schemaDate,
  "nan", (JsValue params) => schemaTyped(ZodNaN, "nan", params),
  "undefined", (JsValue params) => schemaTyped(ZodUndefined, "undefined", params),
  "null", (JsValue params) => schemaTyped(ZodNull, "null", params),
  "any", (JsValue params) => schemaTyped(ZodAny, "any", params),
  "unknown", schemaUnknown,
  "never", schemaNever,
  "void", (JsValue params) => schemaTyped(ZodVoid, "void", params),
  "literal", schemaLiteral,
  "enum", schemaEnum,
  "nativeEnum", schemaEnum,
  "object", schemaObject,
  "strictObject", (JsValue shape, JsValue params) => objectOf(shape, params, schemaNever(undef())),
  "looseObject", (JsValue shape, JsValue params) => objectOf(shape, params, schemaUnknown(undef())),
  "array", schemaArray,
  "tuple", schemaTuple,
  "record", schemaRecord,
  "union", schemaUnion,
  "xor", schemaXor,
  "discriminatedUnion", schemaDiscUnion,
  "intersection", schemaIntersection,
  "map", schemaMap,
  "set", schemaSetType,
  "lazy", schemaLazy,
  "promise", schemaPromise,
  "custom", schemaCustom,
  "file", (JsValue params) => schemaTyped(ZodFile, "file", params),
  "instanceof", schemaInstanceof,
  "transform", schemaTransform,
  "function", schemaFunction,
  "int", (JsValue params) => schemaNumberFormat("int", params),
  "int32", (JsValue params) => schemaNumberFormat("int32", params),
  "uint32", (JsValue params) => schemaNumberFormat("uint32", params),
  "float32", (JsValue params) => schemaNumberFormat("float32", params),
  "float64", (JsValue params) => schemaNumberFormat("float64", params),
  "pipe", schemaPipe,
  "optional", (JsValue schema) => invoke0(schema, "optional"),
  "nullable", (JsValue schema) => invoke0(schema, "nullable"),
  "email", (JsValue params) => schemaFormat(ZodEmail, "email", regexJs(emailRe), params),
  "uuid", (JsValue params) => schemaFormat(ZodUUID, "uuid", regexJs(uuidRe), params),
  "guid", (JsValue params) => schemaFormat(ZodGUID, "guid", regexJs(guidRe), params),
  "url", schemaUrl,
  "httpUrl", schemaHttpUrl,
  "codec", schemaCodec,
  "invertCodec", schemaInvertCodec,
  "preprocess", schemaPreprocess,
  "stringbool", schemaStringbool,
  "success", schemaSuccess,
  "json", schemaJson,
  "hex", (JsValue params) => schemaStringFormat("hex", regexJs(hexRe), params),
  "hostname", (JsValue params) => schemaStringFormat("hostname", regexJs(hostnameRe), params),
  "hash", schemaHash,
  "partialRecord", (JsValue key, JsValue val, JsValue params) => schemaRecord(key, val, params, JS.object("partial", true)),
  "looseRecord", (JsValue key, JsValue val, JsValue params) => schemaRecord(key, val, params, JS.object("mode", "loose")),
  "creditCard", (JsValue params) => schemaFormat(ZodString, "credit_card", regexJs(creditCardRe), params),
  "mac", schemaMac,
  "keyof", (JsValue schema) => invoke0(schema, "keyof"),
  "catch", (JsValue schema, JsValue value) => invoke1(schema, "catch", value),
  "default", defaultFn,
  "_default", defaultFn,
  "prefault", (JsValue schema, JsValue value) => invoke1(schema, "prefault", value),
  "nonoptional", (JsValue schema, JsValue params) => invoke1(schema, "nonoptional", params),
  "readonly", (JsValue schema) => invoke0(schema, "readonly"),
  "jwt", (JsValue params) => schemaFormat(ZodJWT, "jwt", undef(), params),
  "nanoid", (JsValue params) => schemaFormat(ZodString, "nanoid", regexJs(nanoidRe), params),
  "ulid", (JsValue params) => schemaFormat(ZodString, "ulid", regexJs(ulidRe), params),
  "ipv4", (JsValue params) => schemaFormat(ZodString, "ipv4", regexJs(ipv4Re), params),
  "ipv6", (JsValue params) => schemaFormat(ZodString, "ipv6", regexJs(ipv6Re), params),
  "coerce", JS.object(
    "string", (JsValue params) => coerced(schemaString(params)),
    "number", (JsValue params) => coerced(schemaNumber(params)),
    "boolean", (JsValue params) => coerced(schemaBoolean(params)),
    "bigint", (JsValue params) => coerced(schemaBigint(params)),
    "date", (JsValue params) => coerced(schemaDate(params))
  ),
  "iso", JS.object(
    "datetime", (JsValue params) => schemaFormat(ZodISODateTime, "datetime", datetimeRegex(params), params),
    "date", (JsValue params) => schemaFormat(ZodISODate, "date", regexJs(isoDateRe), params),
    "time", (JsValue params) => schemaFormat(ZodISOTime, "time", timeRegex(params), params),
    "duration", (JsValue params) => schemaFormat(ZodISODuration, "duration", regexJs(durationRe), params)
  ),
  "locales", JS.object("en", localesEn),
  "core", core,
  "parse", parseApi,
  "safeParse", safeParseInst,
  "parseAsync", parseAsyncApi,
  "safeParseAsync", safeParseAsyncInst,
  "encode", encodeApi,
  "decode", decodeApi,
  "encodeAsync", encodeAsyncApi,
  "decodeAsync", decodeAsyncApi,
  "treeifyError", treeifyError,
  "prettifyError", prettifyError,
  "formatError", formatError,
  "flattenError", flattenError,
  "registry", makeRegistry,
  "globalRegistry", globalReg,
  "config", setConfig,
  "ZodError", ZodError,
  "ZodRealError", ZodRealError,
  "getDiscriminatedOption", getDiscriminatedOption,
  "exactOptional", schemaExactOptional,
  "slugify", schemaSlugifyCheck,
  "properties", schemaProperties,
  "property", schemaProperty,
  "templateLiteral", schemaTemplateLiteral,
  "stringFormat", schemaStringFormat,
  "check", createPayloadCheck,
  "with", createPayloadCheck,
  "refine", schemaRefine,
  "superRefine", schemaSuperRefine,
  "trim", schemaTrimCheck,
  "maxLength", schemaMaxLengthCheck,
  "minLength", schemaMinLengthCheck,
  "NEVER", JS.object("status", "aborted"),
  "ZodIssueCode", issueCodes,
  "TimePrecision", JS.object(
    "Any", null,
    "Minute", 0.0 - 1.0,
    "Second", 0,
    "Millisecond", 3,
    "Microsecond", 6
  )
);

objectAssign(zObj, ctors);
objectAssign(core, zObj);
// `z.core` names every constructor `$ZodX`, as upstream's core does.
for (string name in ctors) core["$" + name] = ctors[name];
objectAssign(core, JS.object(
  "$ZodError", ZodError,
  "$ZodRealError", ZodRealError,
  "$ZodEncodeError", ZodEncodeError,
  "toDotPath", toDotPath,
  "globalConfig", getConfig(),
  "util", coreUtil()
));
zObj["util"] = core["util"];

export JsValue z = zObj;
export JsValue default = zObj;
