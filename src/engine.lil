export Regex isoDateTimeRe = new Regex("^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?)Z$");
export Regex durationRe = new Regex("^P(?:(\\d+W)|(?!.*W)(?=\\d|T\\d)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+([.,]\\d+)?S)?)?)$");
export Regex xidRe = new Regex("^[0-9a-vA-V]{20}$");
export Regex ksuidRe = new Regex("^[A-Za-z0-9]{27}$");
export Regex e164Re = new Regex("^\\+[1-9]\\d{6,14}$");
export Regex jwtRe = new Regex("^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$");
export Regex emojiRe = new Regex("^[\\p{Extended_Pictographic}\\p{Emoji_Component}]+$", "u");
export Regex base64urlRe = new Regex("^[A-Za-z0-9_-]*$");
export Regex cidrv4Re = new Regex("^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\/([0-9]|[1-2][0-9]|3[0-2])$");
export Regex cidrv6Re = new Regex("^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))\\/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$");
export Regex creditCardRe = new Regex("^\\d(?:[ -]?\\d){11,18}$");
export Regex macRe = new Regex("^(?:[0-9A-F]{2}:){5}[0-9A-F]{2}$|^(?:[0-9a-f]{2}:){5}[0-9a-f]{2}$");
export Regex hexRe = new Regex("^[0-9a-fA-F]*$");
export Regex hostnameRe = new Regex("^(?=.{1,253}\\.?$)[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[-0-9a-zA-Z]{0,61}[0-9a-zA-Z])?)*\\.?$");
export Regex httpProtocolRe = new Regex("^https?$");
export Regex domainRe = new Regex("^(?=.{1,253}$)([a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$");
export Regex md5HexRe = new Regex("^[0-9a-fA-F]{32}$");
export Regex sha1HexRe = new Regex("^[0-9a-fA-F]{40}$");
export Regex sha256HexRe = new Regex("^[0-9a-fA-F]{64}$");
export Regex sha384HexRe = new Regex("^[0-9a-fA-F]{96}$");
export Regex sha512HexRe = new Regex("^[0-9a-fA-F]{128}$");

export JsValue regexJs(Regex re) {
  return JS.assume(re);
}

export void setCoerce(JsValue inst) {
  schemaOf(inst).def["coerce"] = true;
  JsValue intern = inst["_zod"];
  if (isUndef(intern["~pf"]) || isUndef(intern["~rf"])) return;
  intern["parse"] = intern["~pf"];
  intern["run"] = intern["~rf"];
}
