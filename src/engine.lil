export string finalizeMessage(JsValue raw, Schema? schema, JsValue ctx) {
  if (isStr(raw["message"]) && toStr(raw["message"]).length > 0) return toStr(raw["message"]);
  JsValue m = mapMessage(errorFnOf(raw["inst"]), raw, true);
  if (isUndef(m) && !JS.strictEqual(raw["schema"], raw["inst"])) m = mapMessage(errorFnOf(raw["schema"]), raw, true);
