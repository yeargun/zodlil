        for (string key in incoming) {
          if (!isUndef(getDescriptor(existing, key))) {
            throw newError("Cannot overwrite keys on object schemas containing refinements. Use `.safeExtend()` instead.");
          }
        }
      }
      return cloneWithDef(self, extendOverlay(self, incoming));
    },
    "safeExtend", (JsValue self) => (JsValue incoming) => cloneWithDef(self, extendOverlay(self, incoming)),
    "merge", (JsValue self) => (JsValue other) => {
      if (objectHasChecks(self)) {
        throw newError(".merge() cannot be used on object schemas containing refinements. Use .safeExtend() instead.");
      }
      JsValue overlay = extendOverlay(self, defOf(other)["shape"]);
      defineProperty(overlay, "catchall", JS.object(
        "configurable", true,
        "enumerable", true,
        "get", () => defOf(other)["catchall"]
      ));
      JsValue otherChecks = defOf(other)["checks"];
      if (!isArr(otherChecks)) otherChecks = JS.array();
      overlay["checks"] = otherChecks;
      return cloneWithDef(self, overlay);
    },
    "pick", (JsValue self) => (JsValue mask) => maskedShape(self, mask, true, "pick"),
    "omit", (JsValue self) => (JsValue mask) => maskedShape(self, mask, false, "omit"),
    "partial", (JsValue self) => (JsValue mask) => remapObjectFields(self, mask, true, false),
    "exactPartial", (JsValue self) => (JsValue mask) => remapObjectFields(self, mask, true, true),
    "required", (JsValue self) => (JsValue mask) => remapObjectFields(self, mask, false, false),
    "keyof", (JsValue self) => () => schemaEnum(objectKeys(shapeOf(self)), undef())
  ));
  methodsOn(ZodEnum)(JS.object(
    "extract", (JsValue self) => (JsValue keys, JsValue params) => enumSubset(self, keys, params, true),
    "exclude", (JsValue self) => (JsValue keys, JsValue params) => enumSubset(self, keys, params, false)
  ));
  methodsOn(ZodFunction)(JS.object(
    "implement", implementM(false, "implement"),
    "implementAsync", implementM(true, "implementAsync"),
    "input", (JsValue self) => (JsValue next, JsValue rest) => {
      JsValue input = next;
      if (isArr(next)) input = schemaTuple(next, rest, undef());
      return cloneWithDef(self, JS.object("input", input));
    },
    "output", (JsValue self) => (JsValue out) => cloneWithDef(self, JS.object("output", out))
  ));
  invoke1(JS.array(ZodOptional, ZodNullable, ZodNonOptional, ZodDefault, ZodCatch, ZodPrefault, ZodPromise, ZodSuccess, ZodReadonly), "forEach", (JsValue ctor) => installLazy(ctor["prototype"], "unwrap", unwrapM, true));
  installLazy(ZodDefault["prototype"], "removeDefault", unwrapM, true);
  installLazy(ZodCatch["prototype"], "removeCatch", unwrapM, true);
  installLazy(ZodLazy["prototype"], "unwrap", (JsValue self) => () => JS.call(defOf(self)["getter"], undef()), true);
  fields(ZodArray, "element");
  fields(ZodRecord, "keyType valueType");
  fields(ZodMap, "keyType valueType");
  fields(ZodUnion, "options discriminator");
  fields(ZodPipe, "in out");
  accessor(ZodEnum, "enum", (JsValue self) => defOf(self)["entries"]);
  accessor(ZodEnum, "options", (JsValue self) => enumValues(defOf(self)["entries"]));
  accessor(ZodLiteral, "values", (JsValue self) => self["_zod"]["values"]);
  accessor(ZodLiteral, "value", (JsValue self) => {
    JsValue values = defOf(self)["values"];
    if (len(values) > 1) throw newError("This schema contains multiple valid literal values. Use `.values` instead.");
    return values[0];
  });
}

export func()->JsValue localesEn = () => JS.object("localeError", defaultLocale());
export func(JsValue, JsValue, JsValue)->JsValue parseApi = (JsValue schema, JsValue data, JsValue ctx) => parseWithCallee(schema, data, ctx, parseApi);
export func(JsValue, JsValue, JsValue)->JsValue parseAsyncApi = (JsValue schema, JsValue data, JsValue ctx) => awaitParse(schema, data, ctx);
export func(JsValue, JsValue, JsValue)->JsValue encodeApi = (JsValue schema, JsValue data, JsValue ctx) => parseWithCallee(schema, data, dirCtx(ctx, "backward"), encodeApi);
export func(JsValue, JsValue, JsValue)->JsValue decodeApi = (JsValue schema, JsValue data, JsValue ctx) => parseWithCallee(schema, data, dirCtx(ctx, "forward"), decodeApi);
export func(JsValue, JsValue, JsValue)->JsValue encodeAsyncApi = (JsValue schema, JsValue data, JsValue ctx) => awaitParse(schema, data, dirCtx(ctx, "backward"));
export func(JsValue, JsValue, JsValue)->JsValue decodeAsyncApi = (JsValue schema, JsValue data, JsValue ctx) => awaitParse(schema, data, dirCtx(ctx, "forward"));