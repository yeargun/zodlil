  int kindOfType(string t) {
    if (t == "string") return KString;
    if (t == "number") return KNumber;
    if (t == "int") return KNumber;
    if (t == "boolean") return KBoolean;
    if (t == "bigint") return KBigint;
    if (t == "symbol") return KSymbol;
    if (t == "date") return KDate;
    if (t == "nan") return KNan;
    if (t == "undefined") return KUndefined;
    if (t == "null") return KNull;
    if (t == "any") return KAny;
    if (t == "unknown") return KUnknown;
    if (t == "never") return KNever;
    if (t == "void") return KVoid;
    if (t == "literal") return KLiteral;
    if (t == "enum") return KEnum;
    if (t == "object") return KObject;
    if (t == "array") return KArray;
    if (t == "tuple") return KTuple;
    if (t == "record") return KRecord;
    if (t == "map") return KMap;
    if (t == "set") return KSet;
    if (t == "union") return KUnion;
    if (t == "intersection") return KIntersection;
    if (t == "optional") return KOptional;
    if (t == "nullable") return KNullable;
    if (t == "default") return KDefault;
    if (t == "prefault") return KPrefault;
    if (t == "catch") return KCatch;
    if (t == "nonoptional") return KNonoptional;
    if (t == "lazy") return KLazy;
    if (t == "promise") return KPromise;
    if (t == "transform") return KTransform;
    if (t == "pipe") return KPipe;
    if (t == "readonly") return KReadonly;
    if (t == "custom") return KCustom;
    if (t == "file") return KFile;
    if (t == "success") return KSuccess;
    if (t == "function") return KFunction;
    if (t == "template_literal") return KTemplateLiteral;
