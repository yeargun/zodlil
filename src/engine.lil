export JsValue implementFn(JsValue fn, JsValue input, JsValue output, bool asyncOut) {
  if (asyncOut) {
    return asyncImplement(
      JS.method2((JsValue _s, JsValue schema, JsValue data) => {
        return parseAsyncInst(schema, data, undef());
      }),
      JS.methodRest((JsValue _s, JsValue args) => {
        return apply(args[0], args[1], args[2]);
