  }
}

void copyIssues(JsValue from, JsValue into) {
  int i = 0;
  int n = JS.number(from["length"]).toInt();
  while (i < n) {
    push(into, from[i]);
    i = i + 1;
  }
}

void prefixAll(JsValue issues, JsValue into, JsValue part) {
  int j = 0;
  int jn = JS.number(issues["length"]).toInt();
  while (j < jn) {
    prefixPath(issues[j], part);
    push(into, issues[j]);
    j = j + 1;
  }
}

bool fieldNeedsFullRun(Schema field) {
  int k = field.kind;
  if (k == KPipe) return true;
  if (k == KTransform) return true;
  if (k == KPromise) return true;
  if (k == KLazy) return true;
  if (k == KDefault) return true;
  if (k == KPrefault) return true;
  if (k == KCatch) return true;
  return false;
}

JsValue parseFieldSync(Schema field, JsValue value, JsValue ctx, JsValue scratch) {
  if (field.isContainer()) return parsePayload(field, value, ctx);
  if (isBackward(ctx) && field.hasChecks) return parsePayload(field, value, ctx);
  if (fieldNeedsFullRun(field)) return parsePayload(field, value, ctx);
  scratch["value"] = value;
  scratch["issues"]["length"] = 0;
  if (!isUndef(scratch["aborted"])) scratch["aborted"] = false;
  if (!isUndef(scratch["memo"])) scratch["memo"] = false;
  JsValue intern = field.handle["_zod"];
  JsValue ran = call2(intern["run"], intern, scratch, ctx);
  if (isPromise(ran)) return parsePayload(field, value, ctx);
  return ran;
}

void parseArray(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isArr(value)) {
    push(payload["issues"], typeIssue("array", value));
    return;
  }
  Schema? el = childOf(schema, "element");
  JsValue out = schema.memoAlloc(payload, newArray());
  JsValue scratch = JS.object("value", undef(), "issues", newArray());
  int i = 0;
  int n = JS.number(value["length"]).toInt();
  while (i < n) {
    if (el != null) {
      JsValue inner = parseFieldSync(el, value[i], ctx, scratch);
      if (isPromise(inner)) {
        JsValue idx = JS.number(0.0 + i);
        queueWait(payload, inner, JS.method1((JsValue _s, JsValue parsed) => {
          schema.applyIndexedField(payload, out, idx, parsed);
          return undef();
        }));
      } else {
        schema.applyIndexedField(payload, out, JS.number(0.0 + i), inner);
      }
    } else {
      push(out, value[i]);
    }
    i = i + 1;
  }
  payload["value"] = out;
}

int tupleOptStart(JsValue items, bool forIn) {
  int i = JS.number(items["length"]).toInt() - 1;
  while (i >= 0) {
    Schema? item = trySchema(items[i]);
    bool omittable = false;
    if (item != null) {
      Schema s = item;
      if (forIn) {
        if (s.optin != 0) omittable = true;
      } else if (s.optout == 1) {
        omittable = true;
      }
    }
    if (!omittable) return i + 1;
    i = i - 1;
  }
  return 0;
}

void parseTuple(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isArr(value)) {
    push(payload["issues"], typeIssue("tuple", value));
    return;
  }
  JsValue items = schema.def["items"];
  if (!isArr(items)) items = newArray();
  int n = JS.number(value["length"]).toInt();
  int want = JS.number(items["length"]).toInt();
  int optinStart = tupleOptStart(items, true);
  int optoutStart = tupleOptStart(items, false);
  Schema? rest = childOf(schema, "rest");
  if (rest == null) {
    if (n < optinStart) {
      push(payload["issues"], schema.tupleBoundIssue(false, optinStart, value));
      return;
    }
    if (n > want) push(payload["issues"], schema.tupleBoundIssue(true, want, value));
  }
  JsValue out = schema.memoAlloc(payload, newArray());
  payload["value"] = out;
  JsValue itemResults = newArray();
  JsValue proms = newArray();
  int i = 0;
  while (i < want) {
    push(itemResults, undef());
    i = i + 1;
  }
  i = 0;
  while (i < want) {
    JsValue slot = JS.object("i", 0.0 + i);
    JsValue inner = parseOpt(trySchema(items[i]), value[i], ctx);
    if (isPromise(inner)) {
      push(proms, invoke1(inner, "then", JS.method1((JsValue _s, JsValue parsed) => {
        itemResults[slot["i"]] = parsed;
        return undef();
      })));
    } else {
      itemResults[i] = inner;
    }
    i = i + 1;
  }
  if (n > want && rest != null) {
    while (i < n) {
      JsValue slot = JS.object("i", 0.0 + i);
      JsValue inner = parseOpt(rest, value[i], ctx);
      if (isPromise(inner)) {
        push(proms, invoke1(inner, "then", JS.method1((JsValue _s, JsValue parsed) => {
          schema.applyIndexedField(payload, out, slot["i"], parsed);
          return undef();
        })));
      } else {
        schema.applyIndexedField(payload, out, slot["i"], inner);
      }
      i = i + 1;
    }
  }
  if (JS.number(proms["length"]).toInt() > 0) {
    payload["$pending"] = invoke1(promiseAll(proms), "then", JS.method1((JsValue _s, JsValue _v) => {
      schema.finishTuple(payload, items, value, itemResults, optoutStart);
      return payload;
    }));
    return;
  }
  schema.finishTuple(payload, items, value, itemResults, optoutStart);
}

void parseObject(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isObj(value) || isArr(value)) {
    push(payload["issues"], typeIssue("object", value));
    return;
  }
  JsValue draft = undef();
  JsValue shape = schema.def["shape"];
  if (isUndef(shape) || JS.isNullish(shape)) shape = JS.object();
