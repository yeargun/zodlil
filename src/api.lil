export JsValue formatFactory(JsValue ctor, string format, JsValue regex) {
  return JS.staticRest((JsValue args) => {
    return schemaFormat(ctor, format, regex, args[0]);
  });
}

export void boot() {
  ensureLocale();
  initErrorProto();
  installTypeMethods();
  installStringMethods();
  installNumberMethods();
  installBigintMethods();
  installDateMethods();
  installCollectionSizeMethods(ZodMap["prototype"]);
  installCollectionSizeMethods(ZodSet["prototype"]);
  installCollectionSizeMethods(ZodFile["prototype"]);
  installLazy(ZodFile["prototype"], "mime", JS.method1((JsValue _p, JsValue self) => {
    return JS.methodRest((JsValue _s, JsValue args) => {
      JsValue types = args[0];
