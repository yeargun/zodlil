export JsValue ZodType = makeCtor("ZodType", undef());
export JsValue ZodString = makeCtor("ZodString", ZodType);
export JsValue ZodNumber = makeCtor("ZodNumber", ZodType);
export JsValue ZodBoolean = makeCtor("ZodBoolean", ZodType);
