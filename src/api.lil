export JsValue ZodISODate = pubOf("ZodISODate", ZodString);
export JsValue ZodISOTime = pubOf("ZodISOTime", ZodString);
export JsValue ZodISODuration = pubOf("ZodISODuration", ZodString);
export JsValue ZodEmail = makeCtor("ZodEmail", ZodString);
export JsValue ZodGUID = makeCtor("ZodGUID", ZodString);
export JsValue ZodUUID = makeCtor("ZodUUID", ZodString);
export JsValue ZodURL = makeCtor("ZodURL", ZodString);
export JsValue ZodJWT = makeCtor("ZodJWT", ZodString);

JsValue defOf(JsValue inst) {
  return inst["_zod"]["def"];
}

JsValue bagOf(JsValue inst) {
  return inst["_zod"]["bag"];
}

JsValue orNull(JsValue value) {
  if (isUndef(value)) return null;
  return value;
}

// `new Ctor({ ...def, ...normalizeParams(params) })`, the shape every upstream factory has.
JsValue mk(JsValue ctor, JsValue def, JsValue params) {
  return construct1(ctor, objectAssign(def, normalizeParams(params)));
}

export JsValue schemaTyped(JsValue ctor, string type, JsValue params) {
  return mk(ctor, JS.object("type", type), params);
}

JsValue wrapIn(JsValue ctor, string type, JsValue inner) {
  return construct1(ctor, JS.object("type", type, "innerType", inner));
}

// A check built from its own fields plus the caller's params, like `checks.minLength(n, params)`.
JsValue chk(string name, JsValue fields, JsValue params) {
  return createCheck(name, objectAssign(fields, normalizeParams(params)));
}

func(JsValue, JsValue)->JsValue sized(string name, string key) {
  return (JsValue value, JsValue params) => {
    JsValue fields = JS.object();
    fields[key] = value;
    return chk(name, fields, params);
  };
}

func(JsValue, JsValue)->JsValue compare(string name, bool inclusive) {
  return (JsValue value, JsValue params) => chk(name, JS.object("value", value, "inclusive", inclusive), params);
}

JsValue signM(string name, bool inclusive, bool big) {
  return via((JsValue params, JsValue _u) => {
    JsValue zero = 0;
    if (big) zero = toBigInt(0);
    return chk(name, JS.object("value", zero, "inclusive", inclusive), params);
  });
}

JsValue overwrite(JsValue fn) {
  return createCheck("overwrite", JS.object("transform", fn));
}

// A lazy builder method: `schema.m(a, b)` is `schema.check(make(a, b))`.
JsValue via(func(JsValue, JsValue)->JsValue make) {
  return (JsValue self) => bind(self, make);
}

func(JsValue, JsValue)->JsValue minLen = sized("min_length", "minimum");
func(JsValue, JsValue)->JsValue maxLen = sized("max_length", "maximum");
JsValue bind(JsValue self, func(JsValue, JsValue)->JsValue make) {
  return (JsValue a, JsValue b) => withCheck(self, make(a, b));
}

func(JsValue)->JsValue minM = (JsValue self) => bind(self, minLen);
func(JsValue)->JsValue maxM = (JsValue self) => bind(self, maxLen);
func(JsValue)->JsValue lengthM = (JsValue self) => bind(self, sized("length_equals", "length"));
func(JsValue)->JsValue nonemptyM = (JsValue self) => bind(self, (JsValue params, JsValue _u) => minLen(1, params));
func(JsValue)->JsValue gtM = (JsValue self) => bind(self, compare("greater_than", false));
func(JsValue)->JsValue gteM = (JsValue self) => bind(self, compare("greater_than", true));
func(JsValue)->JsValue ltM = (JsValue self) => bind(self, compare("less_than", false));
func(JsValue)->JsValue lteM = (JsValue self) => bind(self, compare("less_than", true));
func(JsValue)->JsValue multipleM = (JsValue self) => bind(self, sized("multiple_of", "value"));
func(JsValue)->JsValue unwrapM = (JsValue self) => () => defOf(self)["innerType"];
JsValue trimFn = (JsValue v) => invoke0(v, "trim");

JsValue slugifyFn = (JsValue v) => {
  JsValue lower = invoke0(invoke0(v, "toLowerCase"), "trim");
  JsValue stripped = invoke2(lower, "replace", newRegex("[^\\w\\s-]", "g"), "");
  JsValue dashed = invoke2(stripped, "replace", newRegex("[\\s_-]+", "g"), "-");
  return invoke2(dashed, "replace", newRegex("^-+|-+$", "g"), "");
};

JsValue sizedM(string name, string key) {
  return via(sized(name, key));
}

JsValue owM(JsValue fn) {
  return via((JsValue _a, JsValue _b) => overwrite(fn));
}

JsValue formatCheck(string format, JsValue pattern, JsValue params) {
  JsValue fields = JS.object("format", format);
  if (!isUndef(pattern)) fields["pattern"] = pattern;
  return chk("string_format", fields, params);
}

JsValue fmtM(string format, JsValue pattern) {
  return via((JsValue params, JsValue _u) => formatCheck(format, pattern, params));
}

JsValue uuidM(string v) {
  return fmtM("uuid", newRegex("^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-" + v + "[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$", ""));
}

// Built at run time: a folded regex literal would print `/` as `\/` and change `.source`, which JSON Schema output exposes.
JsValue base64Pattern = construct1(gGlobal()["RegExp"], "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$");

// String formats whose method name, format name and pattern line up one to one.
JsValue stringFormats = JS.object(
  "email", regexJs(emailRe),
  "url", undef(),
  "uuid", regexJs(uuidRe),
  "guid", regexJs(guidRe),
  "cuid", regexJs(cuidRe),
  "cuid2", regexJs(cuid2Re),
  "ulid", regexJs(ulidRe),
  "nanoid", regexJs(nanoidRe),
  "base64", base64Pattern,
  "base64url", regexJs(base64urlRe),
  "ipv4", regexJs(ipv4Re),
  "ipv6", regexJs(ipv6Re),
  "cidrv4", regexJs(cidrv4Re),
  "cidrv6", regexJs(cidrv6Re),
  "jwt", undef(),
  "emoji", regexJs(emojiRe),
  "e164", regexJs(e164Re),
  "xid", regexJs(xidRe),
  "ksuid", regexJs(ksuidRe),
  "duration", regexJs(durationRe)
);

JsValue macRegex(JsValue params) {
  JsValue d = ":";
  if (isObj(params) && isStr(params["delimiter"])) d = params["delimiter"];
  string e = toStr(invoke2(d, "replace", newRegex("[.*+?^${}()|[\\]\\\\]", "g"), "\\$&"));
  return newRegex("^(?:[0-9A-F]{2}" + e + "){5}[0-9A-F]{2}$|^(?:[0-9a-f]{2}" + e + "){5}[0-9a-f]{2}$", "");
}

export func(JsValue)->JsValue schemaMac = (JsValue params) => schemaFormat(ZodString, "mac", macRegex(params), params);
// `methodsOn(Ctor)(table)`: installs each table entry as a lazily bound builder method on `Ctor.prototype`.
func(JsValue)->void methodsOn(JsValue ctor) {
  JsValue proto = ctor["prototype"];
  return (JsValue table) => {
    for (string key in table) installLazy(proto, key, table[key], true);
  };
}

void getter(JsValue ctor, string key, JsValue fn) {
  defineProperty(ctor["prototype"], key, JS.object("configurable", true, "get", fn));
}

void accessor(JsValue ctor, JsValue key, func(JsValue)->JsValue read) {
  defineProperty(ctor["prototype"], key, JS.object(
    "configurable", true,
    "enumerable", true,
    "get", JS.method0((JsValue self) => read(self))
  ));
}

// Enumerable getters that read the same-named `def` field.
void fields(JsValue ctor, string keys) {
  invoke1(JS.invoke(keys, "split", " "), "forEach", (JsValue key) => accessor(ctor, key, (JsValue self) => defOf(self)[key]));
}

JsValue shapeOf(JsValue inst) {
  JsValue sh = defOf(inst)["shape"];
  if (isNullish(sh)) return JS.object();
  return sh;
}

void assertNoRefinements(JsValue inst, string method) {
  if (objectHasChecks(inst)) throw newError("." + method + "() cannot be used on object schemas containing refinements");
}

bool objectHasChecks(JsValue inst) {
  JsValue checks = defOf(inst)["checks"];
  return isArr(checks) && checks.length > 0.0;
}

void assertMaskKeys(JsValue shape, JsValue mask) {
  for (string key in mask) {
    if (!hasOwn(shape, key)) throw newError("Unrecognized key: \"" + key + "\"");
  }
}

// `shape` as a getter that computes once and pins the result on the def it is read from.
JsValue pinShape(JsValue target, func()->JsValue compute) {
  defineProperty(target, "shape", JS.object(
    "configurable", true,
    "enumerable", true,
    "get", JS.method0((JsValue self) => {
      JsValue shape = compute();
      assignProp(self, "shape", shape);
      return shape;
    })
  ));
  return target;
}

JsValue extendOverlay(JsValue src, JsValue incoming) {
  return pinShape(JS.object(), () => copyOwn(copyOwn(JS.object(), shapeOf(src)), incoming));
}


export func(JsValue)->JsValue schemaString = (JsValue params) => schemaTyped(ZodString, "string", params);
export func(JsValue)->JsValue schemaNumber = (JsValue params) => schemaTyped(ZodNumber, "number", params);
export func(JsValue)->JsValue schemaBoolean = (JsValue params) => schemaTyped(ZodBoolean, "boolean", params);
export func(JsValue)->JsValue schemaBigint = (JsValue params) => schemaTyped(ZodBigInt, "bigint", params);
export func(JsValue)->JsValue schemaDate = (JsValue params) => schemaTyped(ZodDate, "date", params);
export func(JsValue)->JsValue schemaUnknown = (JsValue params) => schemaTyped(ZodUnknown, "unknown", params);
export func(JsValue)->JsValue schemaNever = (JsValue params) => schemaTyped(ZodNever, "never", params);
export func(JsValue, JsValue)->JsValue schemaLiteral = (JsValue values, JsValue params) => {
  JsValue list = values;
  if (!isArr(values)) list = JS.array(values);
  return mk(ZodLiteral, JS.object("type", "literal", "values", list), params);
};
// `{ a: "a", b: "b" }` from `["a", "b"]`.
export JsValue selfKeyed(JsValue list) {
  JsValue obj = JS.object();
  invoke1(list, "forEach", (JsValue v) => assignProp(obj, v, v));
  return obj;
}

export func(JsValue, JsValue)->JsValue schemaEnum = (JsValue entries, JsValue params) => {
  JsValue obj = entries;
  if (isArr(entries)) obj = selfKeyed(entries);
  return mk(ZodEnum, JS.object("type", "enum", "entries", obj), params);
};
export func(JsValue, JsValue)->JsValue schemaObject = (JsValue shape, JsValue params) => objectOf(shape, params, undef());
export JsValue objectOf(JsValue shape, JsValue params, JsValue catchall) {
  JsValue def = JS.object("type", "object", "shape", shape);
  if (isNullish(shape)) def["shape"] = JS.object();
  if (!isUndef(catchall)) def["catchall"] = catchall;
  return mk(ZodObject, def, params);
}

export func(JsValue, JsValue)->JsValue schemaArray = (JsValue element, JsValue params) => mk(ZodArray, JS.object("type", "array", "element", element), params);
export func(JsValue, JsValue, JsValue)->JsValue schemaTuple = (JsValue items, JsValue rest, JsValue params) => {
  JsValue def = JS.object("type", "tuple", "items", items);
  if (isObj(rest) && !isUndef(rest["_zod"])) def["rest"] = rest;
  else if (isUndef(params)) params = rest;
  return mk(ZodTuple, def, params);
};
export func(JsValue, JsValue, JsValue, JsValue)->JsValue schemaRecord = (JsValue key, JsValue val, JsValue params, JsValue extra) => {
  JsValue def = JS.object("type", "record", "keyType", key, "valueType", val);
  if (isNullish(val) || isUndef(val["_zod"])) {
    def["keyType"] = schemaString(undef());
    def["valueType"] = key;
    params = val;
  }
  return construct1(ZodRecord, objectAssign(objectAssign(def, normalizeParams(params)), extra));
};
export func(JsValue, JsValue)->JsValue schemaUnion = (JsValue options, JsValue params) => mk(ZodUnion, JS.object("type", "union", "options", options), params);
export func(JsValue, JsValue)->JsValue schemaXor = (JsValue options, JsValue params) => mk(ZodXor, JS.object("type", "union", "options", options, "inclusive", false), params);
export func(JsValue, JsValue, JsValue)->JsValue schemaDiscUnion = (JsValue key, JsValue options, JsValue params) => {
  if (isArr(options)) {
    int i = 0;
    while (i < len(options)) {
      JsValue option = options[i];
      if (isObj(option) && isObj(option["_zod"])) {
        JsValue shape = shapePhase(option["_zod"]["def"]);
        if (isObj(shape) && !hasOwn(shape, key)) {
          throw newError("Invalid discriminated union option at index \"" + toStr(i) + "\"");
        }
      }
      i = i + 1;
    }
  }
  return mk(ZodDiscriminatedUnion, JS.object("type", "union", "options", options, "discriminator", toStr(key), "inclusive", false), params);
};
export func(JsValue, JsValue)->JsValue schemaIntersection = (JsValue left, JsValue right) => construct1(ZodIntersection, JS.object("type", "intersection", "left", left, "right", right));
export func(JsValue, JsValue, JsValue)->JsValue schemaMap = (JsValue key, JsValue val, JsValue params) => mk(ZodMap, JS.object("type", "map", "keyType", key, "valueType", val), params);
export func(JsValue, JsValue)->JsValue schemaSetType = (JsValue val, JsValue params) => mk(ZodSet, JS.object("type", "set", "valueType", val), params);
export func(JsValue)->JsValue schemaLazy = (JsValue fn) => construct1(ZodLazy, JS.object("type", "lazy", "getter", fn));
export func(JsValue)->JsValue schemaPromise = (JsValue inner) => wrapIn(ZodPromise, "promise", inner);
export func(JsValue, JsValue)->JsValue schemaRefine = (JsValue fn, JsValue params) => mk(ZodCustom, JS.object("type", "custom", "check", "custom", "fn", fn), params);
export func(JsValue, JsValue)->JsValue schemaSuperRefine = (JsValue fn, JsValue params) => {
  return createPayloadCheck(JS.method1((JsValue self, JsValue payload) => {
    payload["addIssue"] = (JsValue issue) => {
      JsValue next = issue;
      if (isStr(issue)) next = JS.object("message", issue, "code", "custom", "input", payload["value"], "inst", self, "path", JS.array());
      else {
        if (next["fatal"].truthy()) next["continue"] = false;
        if (isUndef(next["code"])) next["code"] = "custom";
        if (!inOp("input", next)) next["input"] = payload["value"];
        if (isUndef(next["inst"])) next["inst"] = self;
        if (isUndef(next["continue"])) next["continue"] = true;
      }
      push(payload["issues"], next);
      return undef();
    };
    return JS.call(fn, undef(), payload["value"], payload);
  }), params);
};
export func(JsValue, JsValue)->JsValue schemaCustom = (JsValue fn, JsValue params) => {
  JsValue check = fn;
  if (!isFn(fn)) check = () => true;
  return schemaRefine(check, params);
};
export func(JsValue, JsValue)->JsValue schemaInstanceof = (JsValue ctor, JsValue params) => {
  JsValue inst = mk(ZodCustom, JS.object("type", "custom", "check", "custom", "abort", true, "fn", (JsValue data) => isInstance(ctor, data)), params);
  bagOf(inst)["Class"] = ctor;
  return inst;
};
export func(JsValue)->JsValue schemaTransform = (JsValue fn) => construct1(ZodTransform, JS.object("type", "transform", "transform", fn));
export func(JsValue, JsValue)->JsValue schemaPipe = (JsValue left, JsValue right) => construct1(ZodPipe, JS.object("type", "pipe", "in", left, "out", right));
export func(JsValue, JsValue, JsValue)->JsValue schemaCodec = (JsValue inn, JsValue out, JsValue params) => {
  return construct1(ZodCodec, JS.object(
    "type", "pipe",
    "in", inn,
    "out", out,
    "transform", params["decode"],
    "reverseTransform", params["encode"]
  ));
};
export func(JsValue)->JsValue schemaInvertCodec = (JsValue codec) => {
  JsValue d = defOf(codec);
  return schemaCodec(d["out"], d["in"], JS.object("decode", d["reverseTransform"], "encode", d["transform"]));
};
export func(JsValue, JsValue)->JsValue schemaPreprocess = (JsValue fn, JsValue schema) => construct1(ZodPreprocess, JS.object("type", "pipe", "in", schemaTransform(fn), "out", schema));
JsValue urlDef() {
  return JS.object("type", "string", "format", "url", "check", "string_format", "abort", false);
}

export func(JsValue)->JsValue schemaUrl = (JsValue params) => mk(ZodURL, urlDef(), params);
export func(JsValue)->JsValue schemaHttpUrl = (JsValue params) => {
  JsValue def = urlDef();
  def["protocol"] = regexJs(httpProtocolRe);
  def["hostname"] = regexJs(domainRe);
  return mk(ZodURL, def, params);
};
JsValue lowered(JsValue list) {
  return invoke1(list, "map", (JsValue v) => {
    if (isStr(v)) return invoke0(v, "toLowerCase");
    return v;
  });
}

export func(JsValue)->JsValue schemaStringbool = (JsValue params) => {
  JsValue norm = normalizeParams(params);
  JsValue truthy = norm["truthy"];
  JsValue falsy = norm["falsy"];
  if (!isArr(truthy)) truthy = JS.array("true", "1", "yes", "on", "y", "enabled");
  if (!isArr(falsy)) falsy = JS.array("false", "0", "no", "off", "n", "disabled");
  bool sensitive = JS.strictEqual(norm["case"], "sensitive");
  if (!sensitive) {
    truthy = lowered(truthy);
    falsy = lowered(falsy);
  }
  JsValue truthySet = setOf(truthy);
  JsValue falsySet = setOf(falsy);
  JsValue error = norm["error"];
  JsValue codec = undef();
  JsValue def = JS.object(
    "type", "pipe",
    "in", construct1(ZodString, JS.object("type", "string", "error", error)),
    "out", construct1(ZodBoolean, JS.object("type", "boolean", "error", error)),
    "transform", (JsValue input, JsValue payload) => {
      JsValue data = input;
      if (!sensitive) data = invoke0(input, "toLowerCase");
      if (setHas(truthySet, data).truthy()) return true;
      if (setHas(falsySet, data).truthy()) return false;
      push(payload["issues"], JS.object(
        "code", "invalid_value",
        "expected", "stringbool",
        "values", invoke1(truthy, "concat", falsy),
        "input", payload["value"],
        "inst", codec,
        "continue", false
      ));
      // Upstream returns `{}` and the codec aborts before `out` runs; a boolean keeps `out` from adding a second issue here.
      return false;
    },
    "reverseTransform", (JsValue input) => {
      if (JS.strictEqual(input, true)) return JS.or(truthy[0], "true");
      return JS.or(falsy[0], "false");
    },
    "error", error
  );
  codec = construct1(ZodCodec, def);
  return codec;
};
export func(JsValue)->JsValue schemaSuccess = (JsValue inner) => wrapIn(ZodSuccess, "success", inner);
export func(JsValue)->JsValue schemaJson = (JsValue params) => {
  JsValue json = undef();
  json = schemaLazy(() => schemaUnion(JS.array(
    schemaString(params),
    schemaNumber(undef()),
    schemaBoolean(undef()),
    schemaTyped(ZodNull, "null", undef()),
    schemaArray(json, undef()),
    schemaRecord(schemaString(undef()), json, undef(), undef())
  ), undef()));
  return json;
};
export JsValue schemaFormat(JsValue ctor, string format, JsValue regex, JsValue params) {
  JsValue def = JS.object("type", "string", "format", format, "check", "string_format");
  if (!isUndef(regex)) def["pattern"] = regex;
  return mk(ctor, def, params);
}

export func(JsValue, JsValue, JsValue)->JsValue schemaStringFormat = (JsValue format, JsValue fnOrRegex, JsValue params) => {
  JsValue def = JS.object("type", "string", "check", "string_format", "format", format, "fn", fnOrRegex);
  if (!isFn(fnOrRegex)) {
    def["pattern"] = fnOrRegex;
    def["fn"] = (JsValue v) => invoke1(fnOrRegex, "test", v);
  }
  return mk(ZodString, def, params);
};
JsValue hashLengths = JS.object(
  "md5", JS.array(32, 22, "=="),
  "sha1", JS.array(40, 27, "="),
  "sha256", JS.array(64, 43, "="),
  "sha384", JS.array(96, 64, ""),
  "sha512", JS.array(128, 86, "==")
);

export func(JsValue, JsValue)->JsValue schemaHash = (JsValue alg, JsValue params) => {
  JsValue enc = "hex";
  if (isObj(params) && !isUndef(params["enc"])) enc = params["enc"];
  string format = toStr(alg) + "_" + toStr(enc);
  JsValue lens = hashLengths[alg];
  string source = "";
  if (isArr(lens)) {
    if (JS.strictEqual(enc, "hex")) source = "^[0-9a-fA-F]{" + toStr(lens[0]) + "}$";
    if (JS.strictEqual(enc, "base64")) source = "^[A-Za-z0-9+/]{" + toStr(lens[1]) + "}" + toStr(lens[2]) + "$";
    if (JS.strictEqual(enc, "base64url")) source = "^[A-Za-z0-9_-]{" + toStr(lens[1]) + "}$";
  }
  if (source == "") throw newError("Unrecognized hash format: " + format);
  return schemaStringFormat(format, newRegex(source, ""), params);
};
export JsValue schemaNumberFormat(string format, JsValue params) {
  return withCheck(schemaNumber(params), createCheck("number_format", JS.object("format", format)));
}

export func(JsValue, JsValue)->JsValue schemaTemplateLiteral = (JsValue parts, JsValue params) => {
  JsValue inst = mk(ZodTemplateLiteral, JS.object("type", "template_literal", "parts", parts), params);
  JsValue pattern = schemaOf(inst).templatePattern(parts);
  assignProp(inst["_zod"], "pattern", pattern);
  return inst;
};
export func(JsValue, JsValue, JsValue)->JsValue schemaProperty = (JsValue property, JsValue schema, JsValue params) => chk("property", JS.object("property", property, "schema", schema), params);
export func(JsValue)->JsValue schemaFunction = (JsValue params) => {
  JsValue input = undef();
  JsValue output = undef();
  if (isObj(params)) {
    input = params["input"];
    output = params["output"];
  }
  if (isArr(input)) input = schemaTuple(input, undef(), undef());
  if (isUndef(input)) input = schemaArray(schemaUnknown(undef()), undef());
  if (isUndef(output)) output = schemaUnknown(undef());
  return construct1(ZodFunction, JS.object("type", "function", "input", input, "output", output));
};
export func(JsValue)->JsValue schemaExactOptional = (JsValue inner) => construct1(ZodExactOptional, JS.object("type", "optional", "innerType", inner, "exact", true));

JsValue remapObjectFields(JsValue inst, JsValue mask, bool optionalize, bool exact) {
  if (optionalize) {
    if (exact) assertNoRefinements(inst, "exactPartial");
    else assertNoRefinements(inst, "partial");
  }
  JsValue def = pinShape(copyDescriptors(JS.object(), defOf(inst)), () => {
    JsValue src = shapeOf(inst);
    if (!isNullish(mask)) assertMaskKeys(src, mask);
    JsValue shape = JS.object();
    for (string key in src) {
      JsValue field = src[key];
      if (isNullish(mask) || mask[key].truthy()) {
        if (!optionalize) field = wrapIn(ZodNonOptional, "nonoptional", field);
        else if (exact) field = schemaExactOptional(field);
        else field = wrapIn(ZodOptional, "optional", field);
      }
      assignProp(shape, key, field);
    }
    return shape;
  });
  if (optionalize) def["checks"] = JS.array();
  return construct1(ZodObject, def);
}
export func()->JsValue schemaSlugifyCheck = () => overwrite(slugifyFn);
export func()->JsValue schemaTrimCheck = () => overwrite(trimFn);
export func(JsValue, JsValue)->JsValue schemaMaxLengthCheck = maxLen;
export func(JsValue, JsValue)->JsValue schemaMinLengthCheck = minLen;

export func(JsValue)->JsValue schemaProperties = (JsValue shape) => invoke1(objectKeys(shape), "map", (JsValue key) => createCheck("property", JS.object("property", key, "schema", shape[key])));
JsValue withDefault(JsValue ctor, string type, JsValue inner, JsValue value) {
  JsValue def = JS.object("type", type, "innerType", inner);
  defineProperty(def, "defaultValue", JS.object(
    "configurable", true,
    "enumerable", true,
    "get", () => {
      if (isFn(value)) return JS.call(value, undef());
      return value;
    }
  ));
  return construct1(ctor, def);
}

JsValue dirCtx(JsValue ctx, string direction) {
  JsValue next = JS.object();
  if (!isNullish(ctx)) objectAssign(next, ctx);
  next["direction"] = direction;
  return next;
}

JsValue directed(string direction) {
  return (JsValue self) => {
    JsValue fn = undef();
    fn = (JsValue data, JsValue ctx) => parseWithCallee(self, data, dirCtx(ctx, direction), fn);
    return fn;
  };
}

// The throwing async parse (parseAsync/encodeAsync/decodeAsync, on schemas and on z): the stack of its error starts at
// the caller, as upstream's `async (data, params) => await parse.parseAsync(self, data, params, { callee: fn })`.
async JsValue awaitParse(JsValue self, JsValue data, JsValue ctx) {
  return await parseAsyncWithCallee(self, data, ctx, awaitParse);
}

JsValue directedAsync(string direction) {
  return (JsValue self) => (JsValue data, JsValue ctx) => awaitParse(self, data, dirCtx(ctx, direction));
}

JsValue safeDirected(string direction, bool isAsync) {
  return (JsValue self) => (JsValue data, JsValue ctx) => {
    if (isAsync) return safeParseAsyncInst(self, data, dirCtx(ctx, direction));
    return safeParseInst(self, data, dirCtx(ctx, direction));
  };
}

JsValue standardResult(JsValue result) {
  if (result["success"].truthy()) return JS.object("value", result["data"]);
  return JS.object("issues", result["error"]["issues"]);
}

JsValue standardJson(JsValue self, string io) {
  return (JsValue params) => {
    JsValue next = JS.object();
    if (!isNullish(params)) objectAssign(next, params);
    next["io"] = io;
    return invoke1(self, "toJSONSchema", next);
  };
}

JsValue implementM(bool isAsync, string method) {
  return (JsValue self) => (JsValue fn) => {
    if (!isFn(fn)) throw newError(method + "() must be called with a function");
    JsValue def = defOf(self);
    return implementFn(fn, def["input"], def["output"], isAsync);
  };
}

JsValue enumSubset(JsValue self, JsValue keys, JsValue params, bool keep) {
  JsValue def = defOf(self);
  JsValue entries = def["entries"];
  JsValue next = JS.object();
  if (!keep) copyDescriptors(next, entries);
  int i = 0;
  while (i < len(keys)) {
    JsValue key = keys[i];
    if (!hasOwn(entries, key)) throw newError("Key " + toStr(key) + " not found in enum");
    if (keep) assignProp(next, key, entries[key]);
    else deleteProp(next, key);
    i = i + 1;
  }
  JsValue d = objectAssign(copyDescriptors(JS.object(), def), normalizeParams(params));
  d["entries"] = next;
  d["checks"] = JS.array();
  return construct1(ZodEnum, d);
}

JsValue maskedShape(JsValue self, JsValue mask, bool keep, string name) {
  assertNoRefinements(self, name);
  JsValue overlay = pinShape(JS.object("checks", JS.array()), () => {
    JsValue src = shapeOf(self);
    JsValue shape = JS.object();
    if (!keep) copyOwn(shape, src);
    for (string key in mask) {
      if (!hasOwn(src, key)) throw newError("Unrecognized key: \"" + key + "\"");
      if (mask[key].truthy()) {
        if (keep) assignProp(shape, key, src[key]);
        else deleteProp(shape, key);
      }
    }
    return shape;
  });
  return cloneWithDef(self, overlay);
}

JsValue numberRange(JsValue self, string inclusiveKey, string exclusiveKey, string pick, JsValue unbounded) {
  JsValue bag = bagOf(self);
  JsValue a = bag[inclusiveKey];
  JsValue b = bag[exclusiveKey];
  if (isUndef(a)) a = unbounded;
  if (isUndef(b)) b = unbounded;
  return JS.invoke(Math, pick, a, b);
}

JsValue dateBound(JsValue self, string key) {
  JsValue v = bagOf(self)[key];
  if (!v.truthy()) return null;
  return construct1(gDate(), v);
}

export void boot() {
  ensureLocale();
  initErrorProto();
  methodsOn(ZodType)(JS.object(
    "parse", (JsValue self) => {
      JsValue fn = undef();
      fn = (JsValue data, JsValue ctx) => parseWithCallee(self, data, ctx, fn);
      return fn;
    },
    "safeParse", (JsValue self) => JS.call(makeBoundSafeParseFn, undef(), self["_zod"], (JsValue payload, JsValue ctx) => failSafeParsed(self, payload, ctx)),
    "parseAsync", (JsValue self) => (JsValue data, JsValue ctx) => awaitParse(self, data, ctx),
    "safeParseAsync", (JsValue self) => (JsValue data, JsValue ctx) => safeParseAsyncInst(self, data, ctx),
    "spa", (JsValue self) => self["safeParseAsync"],
    "encode", directed("backward"),
    "decode", directed("forward"),
    "encodeAsync", directedAsync("backward"),
    "decodeAsync", directedAsync("forward"),
    "safeEncode", safeDirected("backward", false),
    "safeDecode", safeDirected("forward", false),
    "safeEncodeAsync", safeDirected("backward", true),
    "safeDecodeAsync", safeDirected("forward", true),
    "optional", (JsValue self) => () => wrapIn(ZodOptional, "optional", self),
    "exactOptional", (JsValue self) => () => schemaExactOptional(self),
    "nullable", (JsValue self) => () => wrapIn(ZodNullable, "nullable", self),
    "nullish", (JsValue self) => () => wrapIn(ZodOptional, "optional", wrapIn(ZodNullable, "nullable", self)),
    "array", (JsValue self) => () => schemaArray(self, undef()),
    "or", (JsValue self) => (JsValue other) => schemaUnion(JS.array(self, other), undef()),
    "and", (JsValue self) => (JsValue other) => schemaIntersection(self, other),
    "default", (JsValue self) => (JsValue value) => withDefault(ZodDefault, "default", self, value),
    "prefault", (JsValue self) => (JsValue value) => withDefault(ZodPrefault, "prefault", self, value),
    "catch", (JsValue self) => (JsValue value) => {
      JsValue catchValue = value;
      if (!isFn(value)) catchValue = () => value;
      return construct1(ZodCatch, JS.object("type", "catch", "innerType", self, "catchValue", catchValue));
    },
    "nonoptional", (JsValue self) => (JsValue params) => mk(ZodNonOptional, JS.object("type", "nonoptional", "innerType", self), params),
    "transform", (JsValue self) => (JsValue fn) => schemaPipe(self, schemaTransform(fn)),
    "pipe", (JsValue self) => (JsValue target) => schemaPipe(self, target),
    "readonly", (JsValue self) => () => wrapIn(ZodReadonly, "readonly", self),
    "brand", (JsValue self) => () => self,
    "describe", (JsValue self) => (JsValue description) => {
