  JsValue value = payload["value"];
  if (name == "min_length" || name == "max_length" || name == "length_equals") {
    if (!isStr(value) && !isArr(value)) return;
    float n = toNum(value["length"]);
    if (isStr(value)) n = toNum(invoke1(gArray(), "from", value)["length"]);
    string origin = "string";
    if (isArr(value)) origin = "array";
    if (name == "min_length" && n < toNum(cdef["minimum"])) {
      push(payload["issues"], sizeIssue(false, origin, toNum(cdef["minimum"]), true, false, value, ""));
    }
    if (name == "max_length" && n > toNum(cdef["maximum"])) {
      push(payload["issues"], sizeIssue(true, origin, toNum(cdef["maximum"]), true, false, value, ""));
    }
    if (name == "length_equals" && n != toNum(cdef["length"])) {
      if (n < toNum(cdef["length"])) push(payload["issues"], sizeIssue(false, origin, toNum(cdef["length"]), true, true, value, ""));
      else push(payload["issues"], sizeIssue(true, origin, toNum(cdef["length"]), true, true, value, ""));
    }
    return;
  }
  if (name == "min_size" || name == "max_size" || name == "size_equals") {
    float n = 0.0;
    if (isArr(value)) n = toNum(value["length"]);
    else if (isObj(value) && !isUndef(value["size"])) n = toNum(value["size"]);
    else return;
    string origin = "set";
    if (isArr(value)) origin = "array";
    if (isInstance(gMap(), value)) origin = "map";
    JsValue File = gGlobal()["File"];
    if (!isUndef(File) && isInstance(File, value)) origin = "file";
    if (name == "min_size" && n < toNum(cdef["minimum"])) {
      failSize(payload, false, origin, cdef["minimum"], true, false, value);
    }
    if (name == "max_size" && n > toNum(cdef["maximum"])) {
      failSize(payload, true, origin, cdef["maximum"], true, false, value);
    }
    if (name == "size_equals" && n != toNum(cdef["size"])) {
      if (n < toNum(cdef["size"])) failSize(payload, false, origin, cdef["size"], true, true, value);
      else failSize(payload, true, origin, cdef["size"], true, true, value);
    }
    return;
  }
  if (name == "greater_than" || name == "less_than") {
    if (!isNum(value) && !isDate(value) && !isBig(value)) return;
    JsValue bound = cdef["value"];
    bool inclusive = !JS.strictEqual(cdef["inclusive"], false);
    string origin = "number";
    if (isDate(value)) origin = "date";
    if (isBig(value)) origin = "bigint";
    if (!isUndef(cdef["origin"])) origin = toStr(cdef["origin"]);
    if (name == "greater_than") {
      bool ok = JS.greaterThan(value, bound);
      if (inclusive) ok = JS.greaterThanOrEqual(value, bound);
      if (ok) return;
      failSize(payload, false, origin, bound, inclusive, false, value);
    } else {
      bool ok = JS.lessThan(value, bound);
      if (inclusive) ok = JS.lessThanOrEqual(value, bound);
      if (ok) return;
      failSize(payload, true, origin, bound, inclusive, false, value);
    }
    return;
  }
  if (name == "multiple_of") {
    if (isBig(value)) {
      if (!JS.strictEqual(JS.mod(value, cdef["value"]), toBigInt(0))) {
