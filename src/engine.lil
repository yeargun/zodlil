  string cleanRegex(string source) {
    JsValue src = JS.string(source);
    int start = 0;
    int end = JS.number(src["length"]).toInt();
    if (invoke1(src, "startsWith", "^").truthy()) start = 1;
    if (invoke1(src, "endsWith", "$").truthy()) end = end - 1;
    return toStr(invoke2(src, "slice", start, end));
