JsValue parsePipe(Schema schema, JsValue payload, JsValue ctx) {
  Schema? left = childOf(schema, "in");
  Schema? right = childOf(schema, "out");
  JsValue tx = schema.def["transform"];
  JsValue rev = schema.def["reverseTransform"];
  if (schema.kind == KTransform) {
