bool isPlainObject(JsValue value) {
  if (!isObj(value) || isArr(value)) return false;
  JsValue proto = getPrototypeOf(value);
  if (JS.isNullish(proto)) return true;
  return JS.strictEqual(proto, gObject()["prototype"]);
}

bool looksNumericKey(JsValue key) {
  if (!isStr(key)) return false;
  JsValue n = toNumber(key);
  if (!isNum(n) || !isFiniteNum(n)) return false;
  return toStr(n) == toStr(key);
}

void writeRecordValue(JsValue payload, JsValue out, JsValue key, JsValue inner) {
  if (JS.number(inner["issues"]["length"]).toInt() > 0) prefixAll(inner["issues"], payload["issues"], key);
  assignProp(out, key, inner["value"]);
}

void parseRecord(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isPlainObject(value)) {
    failType(payload, "record", value);
    return;
  }
  JsValue out = schema.memoAlloc(payload, JS.object());
  payload["value"] = out;
  bool loose = false;
  if (isStr(schema.def["mode"]) && toStr(schema.def["mode"]) == "loose") loose = true;
  bool partial = schema.def["partial"].truthy();
  Schema? keySchema = childOf(schema, "keyType");
  Schema? valSchema = childOf(schema, "valueType");
  JsValue keyValues = undef();
  if (keySchema != null) {
    Schema keys = keySchema;
    if (!isUndef(keys.values)) keyValues = invoke1(gArray(), "from", keys.values);
  }
  if (!isUndef(keyValues) && isArr(keyValues) && !partial) {
    JsValue expected = keyValues;
    JsValue recordKeys = newSet();
    int e = 0;
    int en = JS.number(expected["length"]).toInt();
    while (e < en) {
      JsValue key = expected[e];
      string kt = typeOf(key);
      if (kt != "string") {
        if (kt != "number") {
          if (kt != "symbol") {
            e = e + 1;
            continue;
          }
        }
      }
      if (isNum(key)) key = toStr(key);
      setAdd(recordKeys, key);
      if (isStr(key) && toStr(key) == "__proto__") {
        e = e + 1;
        continue;
      }
      JsValue keyR = parseOpt(keySchema, expected[e], ctx);
      if (isPromise(keyR)) {
        e = e + 1;
        continue;
      }
      if (JS.number(keyR["issues"]["length"]).toInt() > 0) {
        JsValue finalized = newArray();
        int fi = 0;
        int fn = JS.number(keyR["issues"]["length"]).toInt();
        while (fi < fn) {
          push(finalized, finalizeIssue(keyR["issues"][fi], keySchema, ctx));
          fi = fi + 1;
        }
        JsValue path = newArray();
        push(path, expected[e]);
        push(payload["issues"], JS.object("code", "invalid_key", "origin", "record", "issues", finalized, "input", expected[e], "path", path));
        e = e + 1;
        continue;
      }
      JsValue outKey = keyR["value"];
      if (isStr(outKey) && toStr(outKey) == "__proto__") {
        e = e + 1;
        continue;
      }
      JsValue inner = parseOpt(valSchema, getProp(value, expected[e]), ctx);
      queueWait(payload, inner, JS.method1((JsValue _s, JsValue parsed) => {
        writeRecordValue(payload, out, outKey, parsed);
        return undef();
      }));
      e = e + 1;
    }
    JsValue extraKeys = newArray();
    JsValue keys = objectKeys(value);
    int i = 0;
    int n = JS.number(keys["length"]).toInt();
    while (i < n) {
      JsValue key = keys[i];
      if (!setHas(recordKeys, key).truthy()) {
        if (loose) {
          if (toStr(key) != "__proto__") out[key] = value[key];
        } else {
          push(extraKeys, key);
        }
      }
      i = i + 1;
    }
    if (JS.number(extraKeys["length"]).toInt() > 0) {
      push(payload["issues"], JS.object("code", "unrecognized_keys", "keys", extraKeys, "input", value, "continue", true));
    }
    return;
  }
  JsValue extraKeys = newArray();
  JsValue keys = ownKeys(value);
  int i = 0;
  int n = JS.number(keys["length"]).toInt();
  while (i < n) {
    JsValue key = keys[i];
    if (isStr(key) && toStr(key) == "__proto__") {
      i = i + 1;
      continue;
    }
    if (!propertyIsEnumerable(value, key)) {
      i = i + 1;
      continue;
    }
    JsValue keyR = parseOpt(keySchema, key, ctx);
    if (!isPromise(keyR) && JS.number(keyR["issues"]["length"]).toInt() > 0 && looksNumericKey(key)) {
      JsValue retry = parseOpt(keySchema, toNumber(key), ctx);
      if (!isPromise(retry) && JS.number(retry["issues"]["length"]).toInt() == 0) keyR = retry;
    }
    if (isPromise(keyR) || JS.number(keyR["issues"]["length"]).toInt() > 0) {
      if (loose) out[key] = value[key];
      else if (!isUndef(keyValues)) {
        push(extraKeys, key);
      } else {
        JsValue finalized = newArray();
        if (!isPromise(keyR)) {
          int fi = 0;
          int fn = JS.number(keyR["issues"]["length"]).toInt();
          while (fi < fn) {
            push(finalized, finalizeIssue(keyR["issues"][fi], keySchema, ctx));
            fi = fi + 1;
          }
        }
        JsValue path = newArray();
        push(path, key);
        push(payload["issues"], JS.object("code", "invalid_key", "origin", "record", "issues", finalized, "input", key, "path", path));
      }
      i = i + 1;
      continue;
    }
    JsValue outKey = keyR["value"];
    if (isStr(outKey) && toStr(outKey) == "__proto__") {
      i = i + 1;
      continue;
    }
    JsValue inner = parseOpt(valSchema, value[key], ctx);
    queueWait(payload, inner, JS.method1((JsValue _s, JsValue parsed) => {
      writeRecordValue(payload, out, outKey, parsed);
      return undef();
    }));
    i = i + 1;
  }
  if (JS.number(extraKeys["length"]).toInt() > 0) {
    push(payload["issues"], JS.object("code", "unrecognized_keys", "keys", extraKeys, "input", value, "continue", true));
  }
}

JsValue finalizeIssueList(JsValue issues, Schema schema, JsValue ctx) {
  JsValue out = newArray();
  int i = 0;
  int n = JS.number(issues["length"]).toInt();
  while (i < n) {
    push(out, finalizeIssue(issues[i], schema, ctx));
    i = i + 1;
  }
  return out;
}

JsValue finalizeRawIssues(JsValue issues, JsValue ctx) {
  JsValue out = newArray();
  int i = 0;
  int n = JS.number(issues["length"]).toInt();
  while (i < n) {
    push(out, finalizeIssue(issues[i], null, ctx));
    i = i + 1;
  }
  return out;
}

export JsValue propValuesOf(JsValue inst) {
  if (JS.isNullish(inst) || !isObj(inst) || isUndef(inst["_zod"])) return undef();
  JsValue intern = inst["_zod"];
  if (!isUndef(intern["bag"]["propValues"])) return intern["bag"]["propValues"];
  Schema s = schemaOf(inst);
  if (s.kind == KObject) {
    JsValue pv = JS.object();
    JsValue shape = s.def["shape"];
    if (isObj(shape)) {
      JsValue keys = objectKeys(shape);
      int i = 0;
      int n = JS.number(keys["length"]).toInt();
      while (i < n) {
        JsValue key = keys[i];
        Schema? field = trySchema(shape[key]);
        if (field != null) {
          Schema f = field;
          if (!isUndef(f.values)) {
            JsValue set = newSet();
            JsValue list = invoke1(gArray(), "from", f.values);
            int t = 0;
            int tn = JS.number(list["length"]).toInt();
            while (t < tn) {
              setAdd(set, list[t]);
              t = t + 1;
            }
            if (f.optin != 0) setAdd(set, undef());
            assignProp(pv, key, set);
          }
        }
        i = i + 1;
      }
    }
    intern["bag"]["propValues"] = pv;
    return pv;
  }
  if (s.kind == KPipe) return propValuesOf(s.def["in"]);
  if (s.kind == KLazy) return propValuesOf(unwrapLazy(s).handle);
  if (s.kind == KUnion || s.kind == KXor) {
    JsValue pv = JS.object();
    JsValue options = s.def["options"];
    if (isArr(options)) {
      int i = 0;
      int n = JS.number(options["length"]).toInt();
      while (i < n) {
        JsValue child = propValuesOf(options[i]);
        if (isUndef(child) || JS.isNullish(child) || JS.number(objectKeys(child)["length"]).toInt() == 0) {
          throw newError("Invalid discriminated union option at index \"" + toStr(i) + "\"");
        }
        JsValue keys = objectKeys(child);
        int k = 0;
        int kn = JS.number(keys["length"]).toInt();
        while (k < kn) {
          JsValue key = keys[k];
          if (!hasOwn(pv, key)) assignProp(pv, key, newSet());
          JsValue src = child[key];
          if (!isUndef(src) && !JS.isNullish(src)) {
            JsValue list = invoke1(gArray(), "from", src);
            int t = 0;
            int tn = JS.number(list["length"]).toInt();
            while (t < tn) {
              setAdd(pv[key], list[t]);
              t = t + 1;
            }
          }
          k = k + 1;
        }
        i = i + 1;
      }
    }
    intern["bag"]["propValues"] = pv;
    return pv;
  }
  return undef();
}

JsValue discMapOf(Schema schema) {
  JsValue intern = schema.handle["_zod"];
  JsValue bag = intern["bag"];
  if (!isUndef(bag["optionsMap"])) return bag["optionsMap"];
  JsValue map = newMap();
  string disc = toStr(schema.def["discriminator"]);
  JsValue options = schema.def["options"];
  int i = 0;
  int n = JS.number(options["length"]).toInt();
  while (i < n) {
    JsValue pv = propValuesOf(options[i]);
    JsValue values = undef();
    if (isObj(pv) && hasOwn(pv, disc)) values = pv[disc];
    if (isUndef(values)) {
      throw newError("Invalid discriminated union option at index \"" + toStr(i) + "\"");
    }
    if (JS.isNullish(values)) {
      throw newError("Invalid discriminated union option at index \"" + toStr(i) + "\"");
    }
    if (JS.number(values["size"]).toInt() == 0) {
      throw newError("Invalid discriminated union option at index \"" + toStr(i) + "\"");
    }
    JsValue list = invoke1(gArray(), "from", values);
