    if (hasOwn(parsed, "typ") && toStr(parsed["typ"]) != "JWT") return false;
    if (isUndef(parsed["alg"])) return false;
    if (!isUndef(alg) && !JS.isNullish(alg) && isStr(alg)) {
      if (toStr(parsed["alg"]) != toStr(alg)) return false;
    }
    return true;
  } catch (auto _e) {
    return false;
  }
}

bool isValidBase64(string data) {
  if (data.length == 0) return true;
  if (regexTest(newRegex("\\s", ""), data)) return false;
  int rem = 0;
  int i = 0;
  while (i < data.length) {
    rem = rem + 1;
    if (rem == 4) rem = 0;
    i = i + 1;
  }
  if (rem != 0) return false;
  try {
    call1(gGlobal()["atob"], undef(), data);
    return true;
  } catch (auto _e) {
    return false;
  }
}

bool isValidBase64Url(string data) {
  if (!regexTest(newRegex("^[A-Za-z0-9_-]*$", ""), data)) return false;
  string b64 = toStr(invoke2(invoke2(data, "replace", newRegex("-", "g"), "+"), "replace", newRegex("_", "g"), "/"));
  int rem = 0;
  int i = 0;
  while (i < b64.length) {
    rem = rem + 1;
    if (rem == 4) rem = 0;
    i = i + 1;
  }
  if (rem == 1) b64 = b64 + "===";
  if (rem == 2) b64 = b64 + "==";
  if (rem == 3) b64 = b64 + "=";
  return isValidBase64(b64);
}

bool isValidIPv6(string value) {
  if (!regexTest(newRegex("^[0-9a-fA-F:.]+$", ""), value)) return false;
  try {
