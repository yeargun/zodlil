    push(curr["errors"], errorMapper(mapper, issue));
  });
  return result;
}

export JsValue toDotPath(JsValue path) {
  if (!isArr(path)) return "";
  JsValue[] list = JS.assume(path);
  string[] segs = [];
  list.forEach((JsValue part) => {
    JsValue seg = part;
    if (isObj(seg) && !isUndef(seg["key"])) seg = seg["key"];
    if (isNum(seg)) segs.push("[" + seg + "]");
    else if (isSym(seg)) segs.push("[" + JS.invoke(JSON, "stringify", toStringValue(seg)) + "]");
    else {
      string text = toStr(seg);
      if (regexTest(rx("[^\\w$]"), text)) segs.push("[" + JS.invoke(JSON, "stringify", text) + "]");
      else {
        if (segs.length > 0) segs.push(".");
        segs.push(text);
      }
    }
  });
  return segs.join("");
}

float pathLength(JsValue issue) {
  if (isArr(issue["path"])) return JS.number(issue["path"]["length"]);
