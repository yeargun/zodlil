  fail(payload, iss);
}

// Sets issues[start..][key] = value, where unset unless `force`.
void stampIssues(JsValue payload, int start, string key, JsValue value, bool force) {
  JsValue issues = payload["issues"];
  for (int i = start; i < JS.number(issues["length"]).toInt(); i++) {
    JsValue iss = issues[i];
    if (force || isUndef(iss[key])) iss[key] = value;
  }
}

// A normalized issue added through ctx.addIssue by a refinement or transform.
JsValue addedIssue(JsValue iss, JsValue input, JsValue inst, JsValue cont) {
  if (isStr(iss)) return JS.object("message", iss, "code", "custom", "input", input, "inst", inst);
  if (iss["fatal"].truthy()) iss["continue"] = false;
  if (isUndef(iss["code"])) iss["code"] = "custom";
  if (!JS.in("input", iss)) iss["input"] = input;
  if (isUndef(iss["inst"])) iss["inst"] = inst;
  if (isUndef(iss["continue"]) && !isUndef(cont)) iss["continue"] = cont;
  return iss;
}

void handleRefineResult(JsValue result, JsValue payload, JsValue input, JsValue inst, JsValue cdef, int before) {
  if (JS.number(payload["issues"]["length"]).toInt() != before || result.truthy()) return;
  JsValue path = JS.array();
  if (isArr(cdef["path"])) path = invoke0(cdef["path"], "slice");
  JsValue iss = JS.object("code", "custom", "input", input, "inst", inst, "path", path, "continue", !cdef["abort"].truthy());
  if (!isUndef(cdef["params"])) iss["params"] = cdef["params"];
  fail(payload, iss);
}

bool isValidCreditCard(string input) {
  if (!new Regex("^\\d(?:[ -]?\\d){11,18}$").test(input)) return false;
  string digits = input.replace(new Regex("\\D", "g"), "");
  int sum = 0;
  bool alt = false;
  for (int i = digits.length - 1; i >= 0; i--) {
    int d = digits.charCodeAt(i) - 48;
    if (alt) d = d * 2;
    if (d > 9) d = d - 9;
    sum = sum + d;
    alt = !alt;
  }
  return sum % 10 == 0;
}

bool isValidJwt(string token, JsValue alg) {
  string[] parts = token.split(".");
  if (parts.length != 3 || parts[0] == "") return false;
  try {
    JsValue parsed = JS.invoke(JSON, "parse", JS.invoke(gGlobal(), "atob", parts[0]));
    if (!isObj(parsed)) return false;
    if (hasOwn(parsed, "typ") && toStr(parsed["typ"]) != "JWT") return false;
    if (isUndef(parsed["alg"])) return false;
    return !isStr(alg) || toStr(parsed["alg"]) == toStr(alg);
  } catch (auto _e) {
    return false;
  }
}

bool isValidBase64(string data) {
  if (data == "") return true;
  if (new Regex("\\s").test(data) || data.length % 4 != 0) return false;
  try {
    JS.invoke(gGlobal(), "atob", data);
    return true;
  } catch (auto _e) {
    return false;
  }
}

bool isValidBase64Url(string data) {
  if (!new Regex("^[A-Za-z0-9_-]*$").test(data)) return false;
  string b64 = data.replace(new Regex("-", "g"), "+").replace(new Regex("_", "g"), "/");
  while (b64.length % 4 != 0) b64 = b64 + "=";
  return isValidBase64(b64);
}

bool isValidIPv6(string value) {
  if (!new Regex("^[0-9a-fA-F:.]+$").test(value)) return false;
  try {
    construct1(gURL(), "http://[" + value + "]");
    return true;
  } catch (auto _e) {
    return false;
  }
}

bool isValidCIDRv6(string value) {
  string[] parts = value.split("/");
  if (parts.length != 2) return false;
  string prefix = parts[1];
  JsValue n = toNumber(prefix);
  if (prefix == "" || toStr(n) != prefix || toNum(n) < 0.0 || toNum(n) > 128.0) return false;
  return isValidIPv6(parts[0]);
}

void runUrlFormat(JsValue cdef, JsValue payload, JsValue value) {
  string trimmed = toStr(value).trim();
  JsValue protocol = cdef["protocol"];
  if (!cdef["normalize"].truthy() && !JS.isNullish(protocol) && !new Regex("^https?:\\/\\/", "i").test(trimmed)) {
    failFormat(payload, "url", undef());
    return;
  }
  JsValue url = undef();
  try {
    url = construct1(gURL(), trimmed);
  } catch (auto _e) {
    failFormat(payload, "url", undef());
    return;
  }
  JsValue host = cdef["hostname"];
  if (!JS.isNullish(host)) {
    host["lastIndex"] = 0;
    if (!regexTest(host, toStr(url["hostname"]))) failFormat(payload, "url", JS.object("note", "Invalid hostname", "pattern", host["source"]));
  }
  if (!JS.isNullish(protocol)) {
    string p = toStr(url["protocol"]);
    if (p.endsWith(":")) p = p.slice(0, p.length - 1);
    protocol["lastIndex"] = 0;
    if (!regexTest(protocol, p)) failFormat(payload, "url", JS.object("note", "Invalid protocol", "pattern", protocol["source"]));
  }
  payload["value"] = trimmed.replace(new Regex("[\\t\\n\\r]", "g"), "");
  if (cdef["normalize"].truthy()) payload["value"] = url["href"];
}

bool stringFormatOk(string format, string s, JsValue cdef) {
  if (format == "credit_card") return isValidCreditCard(s);
  if (format == "base64") return isValidBase64(s);
  if (format == "base64url") return isValidBase64Url(s);
  if (format == "ipv6") return isValidIPv6(s);
  return isValidCIDRv6(s);
}

void runOfficialCheck(JsValue ch, JsValue payload, JsValue ctx) {
  if (isObj(ch) && isObj(ch["_zod"]) && isFn(ch["_zod"]["check"])) {
    JsValue result = call1(ch["_zod"]["check"], ch, payload);
    if (isPromise(result)) {
      syncGuard(ctx);
      payload["$pending"] = result;
    }
    return;
  }
  JsValue cdef = checkDef(ch);
  string name = toStr(cdef["check"]);
  JsValue value = payload["value"];
  // min/max_length, greater_than/less_than and number_format never reach here: fastpass attachJsCheck gives every
  // such check and schema its own _zod.check (the branch above)
  bool isLength = name == "length_equals";
  if (isLength || name == "min_size" || name == "max_size" || name == "size_equals") {
    float n = 0.0;
    string origin = "set";
    if (isArr(value)) {
      n = toNum(value["length"]);
      origin = "array";
    } else if (isLength) {
      if (!isStr(value)) return;
      n = toNum(invoke1(gArray(), "from", value)["length"]);
      origin = "string";
    } else if (isObj(value) && !isUndef(value["size"])) {
      n = toNum(value["size"]);
      if (isInstance(gMap(), value)) origin = "map";
      JsValue File = gGlobal()["File"];
      if (!isUndef(File) && isInstance(File, value)) origin = "file";
    } else return;
    if (name.startsWith("min")) {
      if (n < toNum(cdef["minimum"])) failSize(payload, false, origin, cdef["minimum"], true, false, value);
    } else if (name.startsWith("max")) {
      if (n > toNum(cdef["maximum"])) failSize(payload, true, origin, cdef["maximum"], true, false, value);
    } else {
      JsValue exact = cdef["size"];
      if (isLength) exact = cdef["length"];
      if (n != toNum(exact)) failSize(payload, n > toNum(exact), origin, exact, true, true, value);
    }
    return;
  }
  if (name == "multiple_of") {
    if (isBig(value)) {
      if (!JS.strictEqual(JS.mod(value, cdef["value"]), toBigInt(0))) fail(payload, JS.object("code", "not_multiple_of", "divisor", cdef["value"], "path", JS.array()));
    } else if (isNum(value) && floatSafeRemainder(toNum(value), toNum(cdef["value"])) != 0.0) {
      fail(payload, JS.object("origin", "number", "code", "not_multiple_of", "divisor", cdef["value"], "input", value));
    }
    return;
  }
  if (name == "includes" || name == "starts_with" || name == "ends_with") {
    if (!isStr(value)) return;
    string s = toStr(value);
    string key = "includes";
    if (name == "starts_with") key = "prefix";
    if (name == "ends_with") key = "suffix";
    string needle = toStr(cdef[key]);
    bool ok = s.endsWith(needle);
    if (name == "starts_with") ok = s.startsWith(needle);
    if (name == "includes") {
      if (isNum(cdef["position"])) s = s.slice(JS.number(cdef["position"]).toInt());
      ok = s.includes(needle);
    }
    if (!ok) {
      JsValue extra = JS.object();
      extra[key] = cdef[key];
      failFormat(payload, name, extra);
    }
    return;
  }
  if (name == "string_format" || name == "lowercase" || name == "uppercase") {
    if (!isStr(value)) return;
    string s = toStr(value);
    string format = name;
    if (name == "string_format") format = toStr(cdef["format"]);
    if (format == "lowercase" || format == "uppercase") {
      string expected = s.toUpperCase();
      if (format == "lowercase") expected = s.toLowerCase();
      if (s != expected) {
        failFormat(payload, format, undef());
        return;
      }
    }
    if (format == "url") {
      runUrlFormat(cdef, payload, value);
      return;
    }
    if (format == "jwt") {
      if (isValidJwt(s, cdef["alg"])) return;
      JsValue jwtIss = JS.object("code", "invalid_format", "format", "jwt", "input", value);
      if (!JS.isNullish(cdef["alg"])) jwtIss["algorithm"] = cdef["alg"];
      fail(payload, jwtIss);
      return;
    }
    if (["credit_card", "base64", "base64url", "ipv6", "cidrv6"].includes(format)) {
      if (!stringFormatOk(format, s, cdef)) failFormat(payload, format, undef());
      return;
    }
    if (isFn(cdef["fn"])) {
      JsValue ok = call1(cdef["fn"], undef(), value);
      JsValue issue = JS.object("code", "invalid_format", "format", format, "input", value, "continue", !cdef["abort"].truthy());
      if (isPromise(ok)) {
        payload["$pending"] = invoke1(ok, "then", (JsValue next) => {
          if (!next.truthy()) fail(payload, issue);
          return payload;
        });
      } else if (!ok.truthy()) fail(payload, issue);
      return;
    }
    JsValue pattern = cdef["pattern"];
    if (!isUndef(pattern)) {
      pattern["lastIndex"] = 0;
      if (!regexTest(pattern, s)) failFormat(payload, format, JS.object("pattern", invoke0(pattern, "toString")));
    }
    return;
  }
  if (name == "mime_type") {
    JsValue list = cdef["mime"];
    if (!isArr(list)) return;
    JsValue[] mimes = JS.assume(list);
    string typ = toStr(value["type"]);
    if (!mimes.some((JsValue m) => toStr(m) == typ)) failValue(payload, list, value["type"]);
    return;
  }
  if (name == "property") {
    Schema? propSchema = trySchema(cdef["schema"]);
    if (propSchema != null) {
      JsValue key = cdef["property"];
      JsValue inner = parsePayload(propSchema, value[key], ctx);
      if (isPromise(inner)) {
        payload["$pending"] = invoke1(inner, "then", (JsValue result) => {
          prefixAll(result["issues"], payload["issues"], key);
          return payload;
        });
      } else prefixAll(inner["issues"], payload["issues"], key);
    }
    return;
  }
  if (name == "overwrite") {
    if (isFn(cdef["transform"])) payload["value"] = call1(cdef["transform"], undef(), value);
    return;
  }
  if (name == "custom") {
    JsValue b = undef();
    if (isObj(ch["_zod"])) b = ch["_zod"]["bag"];
    if (isObj(b) && !isUndef(b["Class"])) {
      if (!isInstance(b["Class"], value)) failType(payload, toStr(b["Class"]["name"]), value);
      return;
    }
    if (!isFn(cdef["fn"])) return;
    JsValue issues = payload["issues"];
    JsValue refCtx = JS.object("value", value, "issues", issues);
    refCtx["addIssue"] = (JsValue issue) => {
      push(issues, addedIssue(issue, value, ch, !cdef["abort"].truthy()));
    };
    int before = JS.number(issues["length"]).toInt();
    JsValue ok = call2(cdef["fn"], undef(), value, refCtx);
    if (isPromise(ok)) {
      syncGuard(ctx);
      payload["$pending"] = invoke1(ok, "then", (JsValue result) => {
        handleRefineResult(result, payload, value, ch, cdef, before);
        return payload;
      });
      return;
    }
    handleRefineResult(ok, payload, value, ch, cdef, before);
  }
}

JsValue takePending(JsValue payload) {
  JsValue pending = payload["$pending"];
  if (!isPromise(pending)) return undef();
  JS.delete(payload, "$pending");
  return pending;
}

// Whether a later check must not run: aborted, or an issue that does not (explicitly) continue.
bool payloadAborted(JsValue payload, bool explicitOnly) {
  if (payload["aborted"].truthy()) return true;
  JsValue[] issues = JS.assume(payload["issues"]);
  return issues.some((JsValue iss) => JS.strictEqual(iss["continue"], false) || !explicitOnly && !JS.strictEqual(iss["continue"], true));
}

JsValue runAttachedChecks(Schema schema, JsValue payload, JsValue ctx, int start) {
  JsValue checks = schema.def["checks"];
  if (!isArr(checks)) return payload;
  for (int i = start; i < JS.number(checks["length"]).toInt(); i++) {
    JsValue ch = checks[i];
    JsValue when = checkDef(ch)["when"];
    if (isFn(when)) {
      if (payloadAborted(payload, true) || !call1(when, undef(), payload).truthy()) continue;
    } else if (payloadAborted(payload, false)) continue;
    int before = JS.number(payload["issues"]["length"]).toInt();
    runOfficialCheck(ch, payload, ctx);
    JsValue pending = takePending(payload);
    int next = i + 1;
    if (isPromise(pending)) {
      return invoke1(pending, "then", (JsValue _p) => {
        stampIssues(payload, before, "inst", ch, false);
        stampIssues(payload, before, "schema", schema.handle, false);
        return runAttachedChecks(schema, payload, ctx, next);
      });
    }
    stampIssues(payload, before, "inst", ch, false);
    stampIssues(payload, before, "schema", schema.handle, false);
  }
  return payload;
}

JsValue runChecks(Schema schema, JsValue payload, JsValue ctx) {
  if (payload["memo"].truthy()) return payload;
  JsValue h = schema.handle;
  stampIssues(payload, 0, "inst", h, false);
  if (isStr(schema.def["check"])) {
    int before = JS.number(payload["issues"]["length"]).toInt();
    runOfficialCheck(h, payload, ctx);
    stampIssues(payload, before, "inst", h, false);
    stampIssues(payload, before, "continue", !schema.def["abort"].truthy(), true);
    JsValue pending = takePending(payload);
    if (isPromise(pending)) return invoke1(pending, "then", (JsValue _p) => runAttachedChecks(schema, payload, ctx, 0));
    if (schema.def["abort"].truthy() && JS.number(payload["issues"]["length"]).toInt() > before) return payload;
  }
  return runAttachedChecks(schema, payload, ctx, 0);
}

JsValue settleWaits(JsValue payload) {
  JsValue list = payload["$waits"];
  if (!isArr(list)) return payload;
  JS.delete(payload, "$waits");
  if (JS.number(list["length"]) == 0.0) return payload;
  return invoke1(promiseAll(list), "then", (JsValue _v) => payload);
}

// Applies a child result now, or once it settles (collected on payload.$waits).
void queueWait(JsValue payload, JsValue inner, func(JsValue)->void apply) {
  if (!isPromise(inner)) {
    apply(inner);
    return;
  }
  if (!isArr(payload["$waits"])) payload["$waits"] = JS.array();
  push(payload["$waits"], invoke1(inner, "then", apply));
}

JsValue afterParse(Schema schema, JsValue payload, JsValue ctx) {
  if (isContainer(schema)) memoLeave(schema, payload);
  if (!schema.hasChecks) return payload;
  return runChecks(schema, payload, ctx);
}

JsValue finishAfterParse(Schema schema, JsValue payload, JsValue ctx) {
  JsValue pending = takePending(payload);
  if (isPromise(pending)) return invoke1(pending, "then", (JsValue _p) => finishAfterParse(schema, payload, ctx));
  JsValue waited = settleWaits(payload);
  if (isPromise(waited)) return invoke1(waited, "then", (JsValue next) => afterParse(schema, next, ctx));
  return afterParse(schema, payload, ctx);
}

JsValue parseOnly(Schema schema, JsValue payload, JsValue ctx) {
  if (schema.kind == KPipe || schema.kind == KTransform) return parsePipe(schema, payload, ctx);
  parseKind(schema, payload, ctx);
  JsValue pending = takePending(payload);
  if (isPromise(pending)) return invoke1(pending, "then", (JsValue _p) => settleWaits(payload));
  return settleWaits(payload);
}

JsValue handleCanaryResult(Schema schema, JsValue canary, JsValue payload, JsValue ctx) {
  if (payloadAborted(canary, false)) {
    canary["aborted"] = true;
    return canary;
  }
  JsValue checked = runChecks(schema, payload, ctx);
  if (isPromise(checked)) {
    syncGuard(ctx);
    return invoke1(checked, "then", (JsValue next) => parseOnly(schema, next, ctx));
  }
  return parseOnly(schema, checked, ctx);
}

JsValue runOnPayload(Schema schema, JsValue payload, JsValue ctx) {
  Schema s = unwrapLazy(schema);
  if (isContainer(s)) {
    JsValue hit = memoEnter(s, payload, ctx);
    if (!isUndef(hit)) return runChecks(s, hit, ctx);
  }
  if (s.kind == KPromise) {
    if (isUndef(ctx) || JS.strictEqual(ctx["async"], false)) throw newError(syncPromiseMsg);
    return invoke1(promiseResolve(payload["value"]), "then", (JsValue inner) => {
      payload["value"] = inner;
      return runInner(childOf(s, "innerType"), payload, ctx);
    });
  }
  if (isObj(ctx) && ctx["skipChecks"].truthy()) return parseOnly(s, payload, ctx);
  if (isBackward(ctx) && s.hasChecks) {
    // Encoding parses without checks first; the checks then run on the input side.
    JsValue canaryCtx = objectAssign(JS.object(), ctx);
    canaryCtx["skipChecks"] = true;
    JsValue canary = parseOnly(s, JS.object("value", payload["value"], "issues", JS.array()), canaryCtx);
    if (isPromise(canary)) {
      syncGuard(ctx);
      return invoke1(canary, "then", (JsValue next) => handleCanaryResult(s, next, payload, ctx));
    }
    return handleCanaryResult(s, canary, payload, ctx);
  }
  JsValue ran = payload;
  if (s.kind == KPipe || s.kind == KTransform) ran = parsePipe(s, payload, ctx);
  else parseKind(s, payload, ctx);
  if (isPromise(ran)) return invoke1(ran, "then", (JsValue next) => finishAfterParse(s, next, ctx));
  return finishAfterParse(s, payload, ctx);
}

JsValue parsePayload(Schema schema, JsValue value, JsValue ctx) {
  return JS.invoke(schema.handle["_zod"], "run", JS.object("value", value, "issues", JS.array()), ctx);
}

JsValue parseOpt(Schema? schema, JsValue value, JsValue ctx) {
  if (schema != null) return parsePayload(schema, value, ctx);
  return JS.object("value", value, "issues", JS.array());
}

// Runs the payload through `inner` in place (a missing inner leaves it untouched).
JsValue runInner(Schema? inner, JsValue payload, JsValue ctx) {
  if (inner != null) return runOnPayload(inner, payload, ctx);
  return payload;
}

export JsValue handleOf(Schema? schema, JsValue fallback) {
  if (schema != null) return schema.handle;
  return fallback;
}

void queueInner(JsValue payload, JsValue inner) {
  if (isPromise(inner)) payload["$pending"] = inner;
}

// Post-processes the payload after an in-place inner run, sync or once it settles.
void afterInner(JsValue payload, JsValue ran, func(JsValue)->void after) {
  if (isPromise(ran)) {
    payload["$pending"] = invoke1(ran, "then", (JsValue next) => {
      after(next);
      return next;
    });
  } else after(payload);
}

void clearIssues(JsValue payload) {
  payload["issues"]["length"] = 0;
  payload["aborted"] = false;
}

void applyCatchResult(JsValue payload, Schema s, JsValue ctx) {
  if (JS.number(payload["issues"]["length"]) == 0.0) return;
  JsValue fallback = s.def["catchValue"];
  if (isUndef(fallback)) fallback = s.def["defaultValue"];
  if (isFn(fallback)) {
    JsValue finalized = finalizeAll(payload["issues"], s, ctx);
    fallback = call1(fallback, undef(), JS.object(
      "value", payload["value"],
      "issues", payload["issues"],
      "error", JS.object("issues", finalized),
      "input", payload["value"]
    ));
  }
  payload["value"] = fallback;
  clearIssues(payload);
}

void parseKind(Schema schema, JsValue payload, JsValue ctx) {
  Schema s = unwrapLazy(schema);
  JsValue value = payload["value"];
  float kind = s.kind;
  JsValue def = s.def;
  Schema? inner = childOf(s, "innerType");
  if (kind == KAny || kind == KUnknown) return;
  if (kind <= KVoid) {
    if (def["coerce"].truthy() && kind <= KDate && kind != KSymbol) {
      try {
        JsValue coerced = undef();
        if (kind == KString) coerced = toStringValue(value);
        else if (kind == KNumber) coerced = toNumber(value);
        else if (kind == KBoolean) coerced = toBoolean(value);
        else if (kind == KBigint) coerced = toBigInt(value);
        else coerced = construct1(gDate(), value);
        payload["value"] = coerced;
        value = coerced;
      } catch (auto _e) {
        if (kind == KBigint) {
          failType(payload, "bigint", value);
          return;
        }
      }
    }
    bool ok = false;
    if (kind == KString) ok = isStr(value);
    if (kind == KNumber) ok = numberIs("isFinite", value);
    if (kind == KBoolean) ok = isBool(value);
    if (kind == KBigint) ok = isBig(value);
    if (kind == KSymbol) ok = isSym(value);
    if (kind == KDate) ok = isDate(value) && !numberIs("isNaN", invoke0(value, "getTime"));
    if (kind == KNan) ok = numberIs("isNaN", value);
    if (kind == KUndefined || kind == KVoid) ok = isUndef(value);
    if (kind == KNull) ok = JS.strictEqual(value, null);
    if (!ok) failType(payload, typeNameOf(kind.toInt()), value);
    return;
  }
  if (kind == KLiteral || kind == KEnum) {
    JsValue values = s.handle["_zod"]["values"];
    if (!setHas(values, value).truthy()) failValue(payload, invoke1(gArray(), "from", values), value);
    return;
  }
  bool backward = isBackward(ctx);
  if (kind == KNullable && JS.strictEqual(value, null)) return;
  if (kind == KNullable || kind == KOptional && (def["exact"].truthy() || !isUndef(value)) || backward && (kind == KDefault || kind == KPrefault || kind == KCatch || kind == KReadonly)) {
    queueInner(payload, runInner(inner, payload, ctx));
    return;
  }
  if (kind == KOptional) {
    // Only a defaulted inner substitutes a value for absence.
    if (inner != null && JS.strictEqual(inner.handle["_zod"]["optin"], "defaulted")) {
      afterInner(payload, runOnPayload(inner, payload, ctx), (JsValue p) => {
        if (JS.number(p["issues"]["length"]) > 0.0) {
          p["value"] = undef();
          clearIssues(p);
        }
      });
    }
    return;
  }
  if (kind == KDefault || kind == KPrefault) {
    if (isUndef(value)) {
      payload["value"] = resolveDefault(s);
      if (kind == KPrefault) queueInner(payload, runInner(inner, payload, ctx));
      return;
    }
    afterInner(payload, runInner(inner, payload, ctx), (JsValue p) => {
      if (kind == KDefault && isUndef(p["value"])) p["value"] = resolveDefault(s);
    });
    return;
  }
  if (kind == KCatch) {
    if (inner != null) afterInner(payload, runOnPayload(inner, payload, ctx), (JsValue p) => applyCatchResult(p, s, ctx));
    return;
  }
  if (kind == KNonoptional) {
    afterInner(payload, runInner(inner, payload, ctx), (JsValue p) => {
      if (JS.number(p["issues"]["length"]) == 0.0 && isUndef(p["value"])) {
        fail(p, JS.object("code", "invalid_type", "expected", "nonoptional", "input", p["value"]));
      }
    });
    return;
  }
  if (kind == KReadonly) {
    if (inner != null) {
      afterInner(payload, runOnPayload(inner, payload, ctx), (JsValue p) => {
        if (!p["memo"].truthy()) p["value"] = JS.invoke(gObject(), "freeze", p["value"]);
      });
    }
    return;
  }
  if (kind == KArray) parseArray(s, payload, ctx);
  else if (kind == KTuple) parseTuple(s, payload, ctx);
  else if (kind == KObject) parseObject(s, payload, ctx);
  else if (kind == KRecord) parseRecord(s, payload, ctx);
  else if (kind == KUnion || kind == KXor) parseUnion(s, payload, ctx);
  else if (kind == KIntersection) parseIntersection(s, payload, ctx);
  else if (kind == KMap) parseMap(s, payload, ctx);
  else if (kind == KSet) parseSet(s, payload, ctx);
  else if (kind == KFunction) parseFunction(s, payload, ctx);
  else if (kind == KTemplateLiteral) {
    if (!isStr(value)) {
      failType(payload, "string", value);
      return;
    }
    JsValue pat = s.handle["_zod"]["pattern"];
    if (!JS.isNullish(pat)) {
      pat["lastIndex"] = 0;
      if (!regexTest(pat, toStr(value))) failFormat(payload, "template_literal", JS.object("pattern", pat["source"]));
    }
  } else if (kind == KSuccess) {
    if (inner != null) payload["value"] = JS.number(parseOpt(inner, value, ctx)["issues"]["length"]) == 0.0;
  } else if (kind == KFile) {
    JsValue File = gGlobal()["File"];
    if (isUndef(File) || !isInstance(File, value)) failType(payload, "file", value);
  }
}

void prefixAll(JsValue issues, JsValue into, JsValue part) {
  JsValue[] list = JS.assume(issues);
  list.forEach((JsValue iss) => {
    prefixPath(iss, part);
    push(into, iss);
  });
}

// Folds a child result into the container output at `key` (array slot or record key).
void applyIndexedField(JsValue payload, JsValue out, JsValue key, JsValue inner) {
  prefixAll(inner["issues"], payload["issues"], key);
  out[key] = inner["value"];
}

void parseArray(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isArr(value)) {
    failType(payload, "array", value);
    return;
  }
  Schema? el = childOf(schema, "element");
  JsValue out = memoAlloc(schema, payload, JS.array());
  for (int i = 0; i < JS.number(value["length"]).toInt(); i++) {
    JsValue idx = i;
    if (el != null) queueWait(payload, parsePayload(el, value[i], ctx), (JsValue r) => applyIndexedField(payload, out, idx, r));
    else push(out, value[i]);
  }
  payload["value"] = out;
}

// The internals of items[i] (empty for a non-schema item).
JsValue itemZod(JsValue items, int i) {
  JsValue item = items[i];
  if (isObj(item) && isObj(item["_zod"])) return item["_zod"];
  return JS.object();
}

int tupleOptStart(JsValue items, bool forIn) {
  for (int i = JS.number(items["length"]).toInt() - 1; i >= 0; i--) {
    JsValue z = itemZod(items, i);
    bool omittable = JS.strictEqual(z["optout"], "optional");
    if (forIn) omittable = !isUndef(z["optin"]);
    if (!omittable) return i + 1;
  }
  return 0;
}

JsValue tupleBoundIssue(bool tooBig, int bound, JsValue input) {
  if (tooBig) return JS.object("code", "too_big", "maximum", bound, "inclusive", true, "input", input, "origin", "array");
  return JS.object("code", "too_small", "minimum", bound, "inclusive", true, "input", input, "origin", "array");
}

void finishTuple(JsValue payload, JsValue items, JsValue input, JsValue results, int optoutStart) {
  JsValue out = payload["value"];
  int n = JS.number(input["length"]).toInt();
  for (int i = 0; i < JS.number(items["length"]).toInt(); i++) {
    JsValue r = results[i];
    bool absentTail = i >= n && i >= optoutStart;
    // An absent optional slot truncates the tail instead of materializing undefined.
    if (absentTail && JS.strictEqual(itemZod(items, i)["optin"], "optional")) {
      out["length"] = i;
      break;
    }
    if (!JS.isNullish(r)) {
      if (JS.number(r["issues"]["length"]) > 0.0) {
        if (absentTail) {
          out["length"] = i;
          break;
        }
        prefixAll(r["issues"], payload["issues"], i);
      }
      out[i] = r["value"];
    }
  }
  for (int i = JS.number(out["length"]).toInt() - 1; i >= n; i--) {
    if (!JS.strictEqual(itemZod(items, i)["optout"], "optional") || !isUndef(out[i])) break;
    out["length"] = i;
  }
}

void parseTuple(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isArr(value)) {
    failType(payload, "tuple", value);
    return;
  }
  JsValue items = schema.def["items"];
  if (!isArr(items)) items = JS.array();
  int n = JS.number(value["length"]).toInt();
  int want = JS.number(items["length"]).toInt();
  int optinStart = tupleOptStart(items, true);
  int optoutStart = tupleOptStart(items, false);
  Schema? rest = childOf(schema, "rest");
  if (rest == null) {
    if (n < optinStart) {
      fail(payload, tupleBoundIssue(false, optinStart, value));
      return;
    }
    if (n > want) fail(payload, tupleBoundIssue(true, want, value));
  }
  JsValue out = memoAlloc(schema, payload, JS.array());
  payload["value"] = out;
  JsValue results = JS.array();
  JsValue proms = JS.array();
  for (int i = 0; i < want; i++) {
    JsValue idx = i;
    JsValue r = parseOpt(trySchema(items[i]), value[i], ctx);
    if (isPromise(r)) {
      push(proms, invoke1(r, "then", (JsValue parsed) => {
        results[idx] = parsed;
      }));
    } else results[idx] = r;
  }
  if (rest != null) {
    for (int i = want; i < n; i++) {
      JsValue idx = i;
      JsValue r = parseOpt(rest, value[i], ctx);
      if (isPromise(r)) {
        push(proms, invoke1(r, "then", (JsValue parsed) => {
          applyIndexedField(payload, out, idx, parsed);
        }));
      } else applyIndexedField(payload, out, idx, r);
    }
  }
  if (JS.number(proms["length"]) > 0.0) {
    payload["$pending"] = invoke1(promiseAll(proms), "then", (JsValue _v) => {
      finishTuple(payload, items, value, results, optoutStart);
      return payload;
    });
    return;
  }
  finishTuple(payload, items, value, results, optoutStart);
}

void applyObjField(JsValue payload, JsValue out, string key, bool present, JsValue optin, JsValue optout, JsValue r) {
  bool failed = JS.number(r["issues"]["length"]) > 0.0;
  if (present && !failed) {
    out[key] = r["value"];
    return;
  }
  bool optionalOut = JS.strictEqual(optout, "optional");
  if (!present && optionalOut && JS.strictEqual(optin, "optional")) return;
  if (failed) {
    if (!isUndef(optin) && optionalOut && !present) return;
    prefixAll(r["issues"], payload["issues"], key);
  }
  if (!present && isUndef(optin)) {
    if (!failed) fail(payload, JS.object("expected", "nonoptional", "code", "invalid_type", "input", undef(), "path", JS.array(key)));
    return;
  }
  if (present || !isUndef(r["value"])) out[key] = r["value"];
}

void parseObject(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isObj(value) || isArr(value)) {
    failType(payload, "object", value);
    return;
  }
  JsValue shape = JS.or(schema.def["shape"], JS.object());
  JsValue out = memoAlloc(schema, payload, JS.object());
  string[] keys = JS.assume(objectKeys(shape));
  keys.forEach((string key) => {
    Schema? field = trySchema(shape[key]);
    if (field != null && key != "__proto__") {
      bool present = JS.in(key, value);
      JsValue fieldValue = undef();
      if (present) fieldValue = value[key];
      JsValue r = parsePayload(field, fieldValue, ctx);
      JsValue fz = field.handle["_zod"];
      JsValue optin = fz["optin"];
      JsValue optout = fz["optout"];
      queueWait(payload, r, (JsValue parsed) => applyObjField(payload, out, key, present, optin, optout, parsed));
    }
  });
  JsValue catchall = schema.def["catchall"];
  if (!JS.isNullish(catchall)) {
    Schema? extra = trySchema(catchall);
    JsValue unknownKeys = JS.array();
    string[] valueKeys = JS.assume(objectKeys(value));
    valueKeys.forEach((string key) => {
      if (!hasOwn(shape, key)) {
        if (extra != null && extra.kind == KNever) push(unknownKeys, key);
        else if (key != "__proto__") {
          if (extra == null) out[key] = value[key];
          else {
            JsValue r = parsePayload(extra, value[key], ctx);
            if (JS.number(r["issues"]["length"]) > 0.0) prefixAll(r["issues"], payload["issues"], key);
            else out[key] = r["value"];
          }
        }
      }
    });
    if (JS.number(unknownKeys["length"]) > 0.0) {
      fail(payload, JS.object("code", "unrecognized_keys", "keys", unknownKeys, "input", value, "path", JS.array(), "continue", true));
    }
  }
  payload["value"] = out;
}

bool isPlainObject(JsValue value) {
  if (!isObj(value) || isArr(value)) return false;
  JsValue proto = getPrototypeOf(value);
  return JS.isNullish(proto) || JS.strictEqual(proto, gObject()["prototype"]);
}

void writeRecordValue(JsValue payload, JsValue out, JsValue key, JsValue inner) {
  prefixAll(inner["issues"], payload["issues"], key);
  assignProp(out, key, inner["value"]);
}

void failKey(JsValue payload, JsValue issues, JsValue key) {
  fail(payload, JS.object("code", "invalid_key", "origin", "record", "issues", issues, "input", key, "path", JS.array(key)));
}

void parseRecord(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isPlainObject(value)) {
    failType(payload, "record", value);
    return;
  }
  JsValue out = memoAlloc(schema, payload, JS.object());
  payload["value"] = out;
  JsValue def = schema.def;
  bool loose = JS.strictEqual(def["mode"], "loose");
  Schema? keySchema = childOf(schema, "keyType");
  Schema? valSchema = childOf(schema, "valueType");
  JsValue keyValues = undef();
  if (keySchema != null) {
    JsValue kv = keySchema.handle["_zod"]["values"];
    if (!isUndef(kv)) keyValues = invoke1(gArray(), "from", kv);
  }
  JsValue unknownKeys = JS.array();
  // Parses an entry's value under its parsed key (a key parsing to "__proto__" is dropped).
  func(JsValue, JsValue)->void writeEntry = (JsValue keyR, JsValue entryValue) => {
    JsValue outKey = keyR["value"];
    if (!JS.strictEqual(outKey, "__proto__")) {
      queueWait(payload, parseOpt(valSchema, entryValue, ctx), (JsValue parsed) => writeRecordValue(payload, out, outKey, parsed));
    }
  };
  if (!isUndef(keyValues) && !def["partial"].truthy()) {
    // Exhaustive keys: every enumerated key is parsed, present or not.
    JsValue recordKeys = newSet();
    JsValue[] expected = JS.assume(keyValues);
    expected.forEach((JsValue key) => {
      if (isStr(key) || isNum(key) || isSym(key)) {
        JsValue k = key;
        if (isNum(key)) k = toStr(key);
        setAdd(recordKeys, k);
        if (!JS.strictEqual(k, "__proto__")) {
          JsValue keyR = parseOpt(keySchema, key, ctx);
          if (isPromise(keyR)) {
          } else if (JS.number(keyR["issues"]["length"]) > 0.0) failKey(payload, finalizeAll(keyR["issues"], keySchema, ctx), key);
          else writeEntry(keyR, getProp(value, key));
        }
      }
    });
    string[] keys = JS.assume(objectKeys(value));
    keys.forEach((string key) => {
      if (!setHas(recordKeys, key).truthy()) {
        if (!loose) push(unknownKeys, key);
        else if (key != "__proto__") out[key] = value[key];
      }
    });
  } else {
    JsValue[] keys = JS.assume(ownKeys(value));
    keys.forEach((JsValue key) => {
      if (!JS.strictEqual(key, "__proto__") && propertyIsEnumerable(value, key)) {
        JsValue keyR = parseOpt(keySchema, key, ctx);
        if (!isPromise(keyR) && JS.number(keyR["issues"]["length"]) > 0.0 && isStr(key)) {
          // A numeric-looking string key may satisfy a numeric key schema.
          JsValue num = toNumber(key);
          if (numberIs("isFinite", num) && toStr(num) == toStr(key)) {
            JsValue retry = parseOpt(keySchema, num, ctx);
            if (!isPromise(retry) && JS.number(retry["issues"]["length"]) == 0.0) keyR = retry;
          }
        }
        if (isPromise(keyR) || JS.number(keyR["issues"]["length"]) > 0.0) {
          if (loose) out[key] = value[key];
          else if (!isUndef(keyValues)) push(unknownKeys, key);
          else {
            JsValue finalized = JS.array();
            if (!isPromise(keyR)) finalized = finalizeAll(keyR["issues"], keySchema, ctx);
            failKey(payload, finalized, key);
          }
        } else writeEntry(keyR, value[key]);
      }
    });
