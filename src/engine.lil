export JsValue flattenError(JsValue error, JsValue mapper) {
  JsValue fieldErrors = JS.object();
  JsValue formErrors = JS.array();
  JsValue[] issues = JS.assume(error["issues"]);
  issues.forEach((JsValue issue) => {
