// Every constructor `z` exposes, keyed by its name; entry.lil copies them onto `z`.
export JsValue ctors = JS.object();

JsValue pubOf(string name, JsValue parent) {
  JsValue ctor = makeCtor(name, parent);
  ctors[name] = ctor;
  return ctor;
}

export JsValue ZodType = pubOf("ZodType", undef());

JsValue pub(string name) {
  return pubOf(name, ZodType);
}

export JsValue ZodString = pub("ZodString");
export JsValue ZodNumber = pub("ZodNumber");
export JsValue ZodBoolean = pub("ZodBoolean");
export JsValue ZodBigInt = pub("ZodBigInt");
export JsValue ZodSymbol = pub("ZodSymbol");
export JsValue ZodDate = pub("ZodDate");
export JsValue ZodNaN = pub("ZodNaN");
export JsValue ZodUndefined = pub("ZodUndefined");
export JsValue ZodNull = pub("ZodNull");
export JsValue ZodAny = pub("ZodAny");
