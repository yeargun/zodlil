  if (JS.number(unknownKeys["length"]) > 0.0) {
    fail(payload, JS.object("code", "unrecognized_keys", "keys", unknownKeys, "input", value, "continue", true));
  }
}

JsValue computePropValues(Schema s) {
  float k = s.kind;
  JsValue def = s.def;
  if (k == KPipe) return propValuesOf(def["in"]);
  if (k == KLazy) return propValuesOf(unwrapLazy(s).handle);
  JsValue pv = JS.object();
  if (k == KObject) {
    JsValue shape = def["shape"];
    if (isObj(shape)) {
      string[] keys = JS.assume(objectKeys(shape));
      keys.forEach((string key) => {
        JsValue field = shape[key];
        if (isObj(field) && isObj(field["_zod"]) && !isUndef(field["_zod"]["values"])) {
          JsValue fz = field["_zod"];
          JsValue set = construct1(gSet(), fz["values"]);
          // An omittable slot reads back as undefined at a discriminator lookup.
          if (!isUndef(fz["optin"])) setAdd(set, undef());
          assignProp(pv, key, set);
        }
      });
    }
    return pv;
  }
  if (k != KUnion && k != KXor || !isArr(def["options"])) return undef();
  JsValue[] options = JS.assume(def["options"]);
  for (int i = 0; i < options.length; i++) {
    JsValue child = propValuesOf(options[i]);
    if (!isObj(child) || JS.number(objectKeys(child)["length"]) == 0.0) {
      throw newError("Invalid discriminated union option at index \"" + i + "\"");
    }
    string[] keys = JS.assume(objectKeys(child));
    keys.forEach((string key) => {
      if (!hasOwn(pv, key)) assignProp(pv, key, newSet());
      JsValue into = pv[key];
      if (!JS.isNullish(child[key])) invoke1(child[key], "forEach", (JsValue v) => setAdd(into, v));
    });
  }
  return pv;
}

export JsValue propValuesOf(JsValue inst) {
  if (!isObj(inst) || isUndef(inst["_zod"])) return undef();
  return inst["_zod"]["propValues"];
}

JsValue discMapOf(Schema schema) {
  JsValue b = schema.handle["_zod"]["bag"];
  if (!isUndef(b["optionsMap"])) return b["optionsMap"];
  JsValue map = newMap();
  JsValue disc = schema.def["discriminator"];
  JsValue[] options = JS.assume(schema.def["options"]);
  for (int i = 0; i < options.length; i++) {
    JsValue option = options[i];
    JsValue pv = propValuesOf(option);
    JsValue values = undef();
    if (isObj(pv) && hasOwn(pv, disc)) values = pv[disc];
    if (JS.isNullish(values) || JS.number(values["size"]) == 0.0) {
      throw newError("Invalid discriminated union option at index \"" + i + "\"");
    }
    invoke1(values, "forEach", (JsValue v) => {
      if (mapHas(map, v)) throw newError("Duplicate discriminator value \"" + sv(v) + "\"");
      mapSet(map, v, option);
    });
  }
  b["optionsMap"] = map;
  return map;
}

export JsValue getDiscriminatedOption(JsValue union, JsValue value) {
  return mapGet(discMapOf(schemaOf(union)), value);
}

void takeUnionResult(JsValue payload, JsValue result) {
  payload["value"] = result["value"];
  pushAll(payload["issues"], result["issues"]);
}

bool succeeded(JsValue r) {
  return !JS.isNullish(r) && JS.number(r["issues"]["length"]) == 0.0;
}

void finishUnion(Schema schema, JsValue payload, JsValue results, JsValue ctx) {
  JsValue[] list = JS.assume(results);
  JsValue[] ok = list.filter((JsValue r) => succeeded(r));
  if (ok.length > 0) {
    takeUnionResult(payload, ok[0]);
    return;
  }
  JsValue[] alive = list.filter((JsValue r) => !JS.isNullish(r) && !payloadAborted(r, false));
  if (alive.length == 1) {
    takeUnionResult(payload, alive[0]);
    return;
  }
  JsValue errors = list.map((JsValue r) => {
    if (JS.isNullish(r)) return JS.array();
    return finalizeAll(r["issues"], schema, ctx);
  });
  fail(payload, JS.object("code", "invalid_union", "errors", errors, "path", JS.array()));
}

void parseUnion(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  JsValue def = schema.def;
  JsValue options = def["options"];
  if (!isArr(options)) options = JS.array();
  JsValue disc = def["discriminator"];
  int n = JS.number(options["length"]).toInt();
  if (isStr(disc) && toStr(disc) != "") {
    if (!isObj(value) || isArr(value)) {
      failType(payload, "object", value);
      return;
    }
    JsValue map = discMapOf(schema);
    JsValue opt = mapGet(map, value[disc]);
    if (!JS.isNullish(opt)) {
      JsValue r = parsePayload(schemaOf(opt), value, ctx);
      if (isPromise(r)) {
        payload["$pending"] = invoke1(r, "then", (JsValue next) => {
          takeUnionResult(payload, next);
          return payload;
        });
      } else takeUnionResult(payload, r);
      return;
    }
    if (!def["unionFallback"].truthy() && !isBackward(ctx)) {
      fail(payload, JS.object(
        "code", "invalid_union",
        "errors", JS.array(),
        "note", "No matching discriminator",
        "discriminator", disc,
        "options", invoke1(gArray(), "from", invoke0(map, "keys")),
        "path", JS.array(disc)
      ));
      return;
    }
  }
  bool xor = schema.kind == KXor;
  JsValue results = JS.array();
  JsValue matches = JS.array();
  JsValue proms = JS.array();
  for (int i = 0; i < n; i++) {
    JsValue idx = i;
    JsValue r = parseOpt(trySchema(options[i]), value, ctx);
    if (isPromise(r)) {
      push(proms, invoke1(r, "then", (JsValue parsed) => {
        results[idx] = parsed;
      }));
    } else {
      results[idx] = r;
      if (succeeded(r)) {
        if (!xor) {
          takeUnionResult(payload, r);
          return;
        }
        push(matches, idx);
      }
    }
  }
  if (JS.number(proms["length"]) > 0.0) {
    payload["$pending"] = invoke1(promiseAll(proms), "then", (JsValue _v) => {
      JsValue[] list = JS.assume(results);
      JsValue[] ok = list.filter((JsValue r) => succeeded(r));
      if (xor && ok.length == 1) takeUnionResult(payload, ok[0]);
      else finishUnion(schema, payload, results, ctx);
      return payload;
    });
    return;
  }
  if (!xor) {
    finishUnion(schema, payload, results, ctx);
    return;
  }
  int matched = JS.number(matches["length"]).toInt();
  if (matched == 1) payload["value"] = results[matches[0]]["value"];
  else if (matched == 0) {
    JsValue errors = JS.array();
    for (int i = 0; i < n; i++) {
      Schema? opt = trySchema(options[i]);
      Schema owner = schema;
      if (opt != null) owner = opt;
      push(errors, finalizeAll(results[i]["issues"], owner, ctx));
    }
    fail(payload, JS.object("code", "invalid_union", "errors", errors, "path", JS.array()));
  } else fail(payload, JS.object("code", "invalid_union", "errors", JS.array(), "inclusive", false, "matches", matches, "path", JS.array()));
}

JsValue mergeResult(bool valid, string key, JsValue value) {
  JsValue r = JS.object("valid", valid);
  r[key] = value;
  return r;
}

JsValue mergeValues(JsValue a, JsValue b) {
  if (objectIs(a, b) || isDate(a) && isDate(b) && JS.strictEqual(invoke0(a, "getTime"), invoke0(b, "getTime"))) {
    return mergeResult(true, "data", a);
  }
  if (isPlainObject(a) && isPlainObject(b)) {
    JsValue merged = JS.object();
    JsValue[] sources = [a, b];
    sources.forEach((JsValue src) => {
      JsValue[] srcKeys = JS.assume(ownKeys(src));
      srcKeys.forEach((JsValue key) => {
        if (!JS.strictEqual(key, "__proto__")) assignProp(merged, key, src[key]);
      });
    });
    string[] bKeys = JS.assume(objectKeys(b));
    string[] aKeys = JS.assume(objectKeys(a));
    for (string key of aKeys) {
      if (key != "__proto__" && bKeys.includes(key)) {
        JsValue inner = mergeValues(a[key], b[key]);
        if (!inner["valid"].truthy()) return mergeResult(false, "mergeErrorPath", invoke1(JS.array(key), "concat", inner["mergeErrorPath"]));
        merged[key] = inner["data"];
      }
    }
    return mergeResult(true, "data", merged);
  }
  if (isArr(a) && isArr(b) && JS.number(a["length"]) == JS.number(b["length"])) {
    JsValue next = JS.array();
    for (int i = 0; i < JS.number(a["length"]).toInt(); i++) {
      JsValue inner = mergeValues(a[i], b[i]);
      if (!inner["valid"].truthy()) return mergeResult(false, "mergeErrorPath", invoke1(JS.array(i), "concat", inner["mergeErrorPath"]));
      push(next, inner["data"]);
    }
    return mergeResult(true, "data", next);
  }
  return mergeResult(false, "mergeErrorPath", JS.array());
}

void parseIntersection(Schema schema, JsValue payload, JsValue ctx) {
  Schema? left = childOf(schema, "left");
  Schema? right = childOf(schema, "right");
  if (left == null || right == null) return;
  JsValue a = parseOpt(left, payload["value"], ctx);
  JsValue b = parseOpt(right, payload["value"], ctx);
  if (isPromise(a) || isPromise(b)) {
    payload["$pending"] = invoke1(promiseAll(JS.array(a, b)), "then", (JsValue pair) => {
      finishIntersection(payload, pair[0], pair[1]);
      return payload;
    });
    return;
  }
  finishIntersection(payload, a, b);
}

void finishIntersection(JsValue payload, JsValue left, JsValue right) {
  // Unrecognized keys (and record key issues) are reported only when both sides reject a key.
  JsValue unrec = objectCreate(null);
  JsValue unrecIssue = undef();
  JsValue[] sides = [left, right];
  sides.forEach((JsValue side) => {
    string mark = "r";
    if (JS.strictEqual(side, left)) mark = "l";
    JsValue[] issues = JS.assume(side["issues"]);
    issues.forEach((JsValue iss) => {
      JsValue path = iss["path"];
      bool noPath = JS.isNullish(path) || JS.number(path["length"]) == 0.0;
      JsValue[] keys = [];
      if (JS.strictEqual(iss["code"], "unrecognized_keys") && noPath) {
        keys = JS.assume(iss["keys"]);
        if (isUndef(unrecIssue)) unrecIssue = iss;
      } else if (JS.strictEqual(iss["code"], "invalid_key") && JS.strictEqual(iss["origin"], "record") && !isUndef(path) && JS.number(path["length"]) == 1.0) {
        keys = [path[0]];
      } else push(payload["issues"], iss);
      keys.forEach((JsValue key) => {
        string k = toStr(key);
        if (JS.isNullish(unrec[k])) unrec[k] = JS.object();
        unrec[k][mark] = true;
      });
    });
  });
  if (!isUndef(unrecIssue)) {
    JsValue[] src = JS.assume(unrecIssue["keys"]);
    string[] unrecKeys = JS.assume(objectKeys(unrec));
    string[] both = unrecKeys.filter((string k) => unrec[k]["l"].truthy() && unrec[k]["r"].truthy() && src.some((JsValue s) => toStr(s) == k));
    if (both.length > 0) {
      JsValue next = objectAssign(JS.object(), unrecIssue);
      next["keys"] = both;
      push(payload["issues"], next);
    }
  }
  JsValue merged = mergeValues(left["value"], right["value"]);
  if (merged["valid"].truthy()) payload["value"] = merged["data"];
  else if (!payloadAborted(payload, false)) {
    throw newError("Unmergable intersection. Error path: " + JS.invoke(JSON, "stringify", merged["mergeErrorPath"]));
  }
}

bool isPropertyKey(JsValue key) {
  return isStr(key) || isNum(key) || isSym(key);
}

void handleMapResult(JsValue kr, JsValue vr, JsValue payload, JsValue key, JsValue input, JsValue ctx) {
  if (JS.number(kr["issues"]["length"]) > 0.0) {
    if (isPropertyKey(key)) prefixAll(kr["issues"], payload["issues"], key);
    else fail(payload, JS.object("code", "invalid_key", "origin", "map", "issues", finalizeAll(kr["issues"], null, ctx), "input", input, "path", JS.array()));
  }
  if (JS.number(vr["issues"]["length"]) > 0.0) {
    if (isPropertyKey(key)) prefixAll(vr["issues"], payload["issues"], key);
    else fail(payload, JS.object("code", "invalid_element", "origin", "map", "key", key, "issues", finalizeAll(vr["issues"], null, ctx), "input", input, "path", JS.array()));
  }
}

void parseMap(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isInstance(gMap(), value)) {
    failType(payload, "map", value);
    return;
  }
  JsValue out = memoAlloc(schema, payload, newMap());
  Schema? keySchema = childOf(schema, "keyType");
  Schema? valSchema = childOf(schema, "valueType");
  JsValue waits = JS.array();
  JsValue[] entries = JS.assume(invoke1(gArray(), "from", value));
  entries.forEach((JsValue entry) => {
    JsValue key = entry[0];
    JsValue kr = parseOpt(keySchema, key, ctx);
    JsValue vr = parseOpt(valSchema, entry[1], ctx);
    if (isPromise(kr) || isPromise(vr)) {
      push(waits, invoke1(promiseAll(JS.array(kr, vr)), "then", (JsValue both) => {
        handleMapResult(both[0], both[1], payload, key, value, ctx);
        mapSet(out, both[0]["value"], both[1]["value"]);
      }));
    } else {
      handleMapResult(kr, vr, payload, key, value, ctx);
      mapSet(out, kr["value"], vr["value"]);
    }
  });
  payload["value"] = out;
  if (JS.number(waits["length"]) > 0.0) {
    payload["$pending"] = invoke1(promiseAll(waits), "then", (JsValue _v) => {
      payload["value"] = out;
      return payload;
    });
  }
}

void parseSet(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isInstance(gSet(), value)) {
    failType(payload, "set", value);
    return;
  }
  JsValue out = memoAlloc(schema, payload, newSet());
  Schema? el = childOf(schema, "valueType");
  JsValue[] items = JS.assume(invoke1(gArray(), "from", invoke0(value, "values")));
  items.forEach((JsValue item) => {
    if (el != null) {
      queueWait(payload, parsePayload(el, item, ctx), (JsValue parsed) => {
        pushAll(payload["issues"], parsed["issues"]);
        setAdd(out, parsed["value"]);
      });
    } else setAdd(out, item);
  });
  payload["value"] = out;
}

JsValue runTransform(Schema schema, JsValue payload, JsValue ctx, JsValue fn) {
  if (!isFn(fn)) return payload;
  JsValue input = payload["value"];
  JsValue ctxObj = JS.object("addIssue", (JsValue iss) => {
    push(payload["issues"], addedIssue(iss, payload["value"], schema.handle, undef()));
  }, "value", input, "issues", payload["issues"]);
  JsValue value = call2(fn, undef(), input, ctxObj);
  if (isPromise(value)) {
    syncGuard(ctx);
    return invoke1(value, "then", (JsValue next) => {
      payload["value"] = next;
      return payload;
    });
  }
  payload["value"] = value;
  return payload;
}

// Transforms (when fn is a function) then runs `next`; a pipe stops at issues other than unrecognized keys.
JsValue pipeStep(Schema schema, JsValue payload, JsValue ctx, bool checkBlocked, JsValue fn, Schema? next) {
  if (checkBlocked) {
    JsValue[] issues = JS.assume(payload["issues"]);
    if (issues.some((JsValue iss) => !JS.strictEqual(iss["code"], "unrecognized_keys"))) {
      payload["aborted"] = true;
      return payload;
    }
  }
  JsValue ran = runTransform(schema, payload, ctx, fn);
  if (isPromise(ran)) return invoke1(ran, "then", (JsValue mid) => runInner(next, mid, ctx));
  return runInner(next, payload, ctx);
}

JsValue parsePipe(Schema schema, JsValue payload, JsValue ctx) {
  JsValue def = schema.def;
  bool backward = isBackward(ctx);
  if (schema.kind == KTransform) {
    if (backward) throw construct1(ZodEncodeError, "ZodTransform");
    if (isObj(ctx)) {
      JsValue state = ctx["~memo"];
      if (isObj(state) && !JS.isNullish(state["backEdges"]) && setHas(state["backEdges"], payload["value"]).truthy()) {
        JsValue err = newError("Cannot parse a reference cycle that closes through a transform");
        err["name"] = "ZodCyclicError";
        throw err;
      }
    }
    return runTransform(schema, payload, ctx, def["transform"]);
  }
  // Encoding runs the pipe right to left through the reverse transform.
  Schema? first = childOf(schema, "in");
  Schema? second = childOf(schema, "out");
  JsValue fn = def["transform"];
  if (backward) {
    first = childOf(schema, "out");
    second = childOf(schema, "in");
    fn = def["reverseTransform"];
  }
  if (first != null) {
    JsValue parsed = runOnPayload(first, payload, ctx);
    if (isPromise(parsed)) return invoke1(parsed, "then", (JsValue next) => pipeStep(schema, next, ctx, true, fn, second));
  }
  return pipeStep(schema, payload, ctx, !backward || first != null, fn, second);
}

export JsValue implementFn(JsValue fn, JsValue input, JsValue output, bool asyncOut) {
  if (asyncOut) {
    return asyncImplement(
      (JsValue schema, JsValue data) => parseAsyncInst(schema, data, undef()),
      (JsValue f, JsValue self, JsValue args) => apply(f, self, args),
      input,
      output,
      fn
    );
  }
  return JS.methodRest((JsValue self, JsValue args) => {
    return parseInst(output, apply(fn, self, parseInst(input, invoke1(gArray(), "from", args), undef())), undef());
  });
}

void parseFunction(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isFn(value)) {
    failType(payload, "function", value);
    return;
  }
  JsValue output = schema.def["output"];
  Schema? out = trySchema(output);
  bool asyncOut = false;
  if (out != null) asyncOut = out.kind == KPromise;
  payload["value"] = implementFn(value, schema.def["input"], output, asyncOut);
}

JsValue toSafe(JsValue parsed) {
  if (JS.number(parsed["issues"]["length"]) > 0.0) return JS.object("success", false, "error", makeZodError(parsed["issues"]));
  return JS.object("success", true, "data", parsed["value"]);
}

// The payload, or its finalized form when it has issues.
JsValue finishRun(Schema schema, JsValue payload, JsValue ctx) {
  if (JS.number(payload["issues"]["length"]) == 0.0) return payload;
  ensureLocale();
  return JS.object("value", payload["value"], "issues", finalizeAll(payload["issues"], schema, ctx));
}

JsValue runInst(JsValue inst, JsValue data, JsValue ctx) {
  return JS.invoke(inst["_zod"], "run", JS.object("value", data, "issues", JS.array()), ctx);
}

export JsValue runParse(JsValue inst, JsValue data, JsValue ctx) {
  Schema schema = schemaOf(inst);
  JsValue payload = runInst(inst, data, ctx);
  if (isPromise(payload)) return invoke1(payload, "then", (JsValue next) => finishRun(schema, next, ctx));
  return finishRun(schema, payload, ctx);
}

JsValue withAsync(JsValue ctx, bool isAsync) {
  JsValue out = objectAssign(JS.object(), ctx);
  out["async"] = isAsync;
  return out;
}

// A finished synchronous parse of `inst` (finalized when it has issues).
JsValue syncRun(JsValue inst, JsValue data, JsValue ctx) {
  JsValue payload = runInst(inst, data, ctx);
  if (isPromise(payload)) throw newError(syncPromiseMsg);
  return finishRun(schemaOf(inst), payload, ctx);
}

export JsValue safeParseInst(JsValue inst, JsValue data, JsValue ctx) {
  JsValue parseCtx = withAsync(ctx, false);
  return toSafe(syncRun(inst, data, parseCtx));
}

JsValue raise(JsValue result, JsValue callee, JsValue fallback) {
  captureStackTrace(result["error"], JS.or(callee, fallback));
  throw result["error"];
}

export JsValue failSafeParsed(JsValue inst, JsValue payload, JsValue ctx) {
  ensureLocale();
  return toSafe(JS.object("value", payload["value"], "issues", finalizeAll(payload["issues"], schemaOf(inst), ctx)));
}

export JsValue throwParsed(JsValue inst, JsValue payload, JsValue ctx, JsValue callee) {
  return raise(failSafeParsed(inst, payload, ctx), callee, throwParsed);
}

export JsValue parseWithCallee(JsValue inst, JsValue data, JsValue ctx, JsValue callee) {
  JsValue result = toSafe(syncRun(inst, data, withAsync(ctx, false)));
  if (result["success"].truthy()) return result["data"];
  return raise(result, callee, parseWithCallee);
}

export JsValue parseInst(JsValue inst, JsValue data, JsValue ctx) {
  return parseWithCallee(inst, data, ctx, undef());
}

export JsValue safeParseAsyncInst(JsValue inst, JsValue data, JsValue ctx) {
  JsValue result = runParse(inst, data, withAsync(ctx, true));
  if (isPromise(result)) return invoke1(result, "then", (JsValue parsed) => toSafe(parsed));
  return promiseResolve(toSafe(result));
}

// A real async function, as upstream's parseAsync: the rejection is built after an await, so an async `callee` that
// awaits this call is still on the async stack when captureStackTrace looks for it.
export async JsValue parseAsyncWithCallee(JsValue inst, JsValue data, JsValue ctx, JsValue callee) {
  Task<JsValue> pending = JS.assume(safeParseAsyncInst(inst, data, ctx));
  JsValue result = await pending;
  if (result["success"].truthy()) return result["data"];
  return raise(result, callee, parseAsyncWithCallee);
}

export JsValue parseAsyncInst(JsValue inst, JsValue data, JsValue ctx) {
  return parseAsyncWithCallee(inst, data, ctx, undef());
}

export JsValue installLazy(JsValue proto, string key, JsValue make, bool enumerable) {
  defineProperty(proto, key, JS.object(
    "configurable", true,
    "get", JS.method0((JsValue self) => {
      JsValue value = call1(make, undef(), self);
      defineProperty(self, key, JS.object("configurable", true, "writable", true, "enumerable", enumerable, "value", value));
      return value;
    }),
    "set", JS.method1((JsValue self, JsValue value) => {
      defineProperty(self, key, JS.object("configurable", true, "writable", true, "enumerable", true, "value", value));
      return undef();
    })
  ));
  return proto;
}

// Enum values: array entries as given; for an object, its values minus the reverse
// mappings of numeric members (upstream util.getEnumValues).
export JsValue enumValues(JsValue entries) {
  if (isArr(entries)) return invoke0(entries, "slice");
  if (!isObj(entries)) return JS.array();
  string[] keys = JS.assume(objectKeys(entries));
  JsValue[] values = keys.map((string k) => entries[k]);
  JsValue[] numeric = values.filter((JsValue v) => isNum(v));
  return keys.filter((string k) => numeric.indexOf(toNumber(k)) < 0).map((string k) => entries[k]);
}

export JsValue shapePhase(JsValue def) {
  return mapGet(propShapes, def);
}

// def.shape becomes a getter that snapshots the (possibly getter-defined) fields on first read.
void wrapObjectShape(JsValue def) {
  JsValue desc = getDescriptor(def, "shape");
  if (!JS.isNullish(desc) && isFn(desc["get"])) return;
  JsValue sh = JS.or(def["shape"], JS.object());
  mapSet(propShapes, def, sh);
  defineProperty(def, "shape", JS.object(
    "configurable", true,
    "get", () => {
      JsValue snapshot = JS.object();
      JsValue[] keys = JS.assume(ownKeys(sh));
      keys.forEach((JsValue k) => assignProp(snapshot, k, getProp(sh, k)));
      defineProperty(def, "shape", JS.object("value", snapshot, "writable", true, "enumerable", true, "configurable", true));
      mapSet(propShapes, def, snapshot);
      return snapshot;
    }
  ));
}

// An enumerable prototype getter computed from the instance.
void protoGetter(JsValue proto, string key, func(JsValue)->JsValue get) {
  defineProperty(proto, key, JS.object("configurable", true, "enumerable", true, "get", JS.method0((JsValue self) => get(self))));
}

void defField(JsValue proto, string key) {
  protoGetter(proto, key, (JsValue self) => self["_zod"]["def"][key]);
}

export void installCtorAccessors(JsValue ctor, string name) {
  JsValue proto = ctor["prototype"];
  if (name == "ZodArray") defField(proto, "element");
  if (name == "ZodRecord" || name == "ZodMap") defField(proto, "keyType");
  if (name == "ZodRecord" || name == "ZodMap" || name == "ZodSet") defField(proto, "valueType");
  if (name == "ZodUnion" || name == "ZodDiscriminatedUnion" || name == "ZodXor") {
    defField(proto, "options");
    defField(proto, "discriminator");
  }
  if (name == "ZodPipe" || name == "ZodCodec" || name == "ZodPreprocess") {
    defField(proto, "in");
    defField(proto, "out");
  }
  if (name == "ZodEnum") {
    protoGetter(proto, "enum", (JsValue self) => {
      JsValue entries = self["_zod"]["def"]["entries"];
      if (isObj(entries) && !isArr(entries)) return entries;
      JsValue obj = JS.object();
      if (isArr(entries)) {
        JsValue[] list = JS.assume(entries);
        list.forEach((JsValue e) => obj[e] = e);
      }
      return obj;
    });
    protoGetter(proto, "options", (JsValue self) => enumValues(self["_zod"]["def"]["entries"]));
  }
  if (name == "ZodLiteral") {
    protoGetter(proto, "values", (JsValue self) => self["_zod"]["values"]);
    protoGetter(proto, "value", (JsValue self) => {
      JsValue list = self["_zod"]["def"]["values"];
      if (!isArr(list)) list = invoke1(gArray(), "from", self["_zod"]["values"]);
      if (JS.number(list["length"]) > 1.0) throw newError("This schema contains multiple valid literal values. Use `.values` instead.");
      return list[0];
    });
  }
}

void addTrait(JsValue traits, string name) {
  if (name.length > 0) {
    setAdd(traits, name);
    setAdd(traits, "$" + name);
  }
}

// The constructor chain's names (each also $-prefixed), leaf first, then ZodType/$ZodType.
JsValue traitsFor(string name, JsValue ctor) {
  JsValue traits = newSet();
  addTrait(traits, name);
  JsValue cur = ctor["__parent"];
  for (int guard = 0; !JS.isNullish(cur) && guard < 8; guard++) {
    addTrait(traits, toStr(cur["name"]));
    cur = cur["__parent"];
  }
  addTrait(traits, "ZodType");
  return traits;
}

// Bag bound: keeps the tighter of the current and the new bound.
void bagBound(JsValue b, string key, JsValue v, bool upper) {
  JsValue curr = b[key];
  if (isUndef(curr) || upper && JS.lessThan(v, curr) || !upper && JS.greaterThan(v, curr)) b[key] = v;
}

JsValue bagPatterns(JsValue b) {
  if (isUndef(b["patterns"])) b["patterns"] = newSet();
  return b["patterns"];
}

JsValue numberRanges = JS.object(
  "safeint", JS.array(-9007199254740991.0, 9007199254740991.0),
  "int", JS.array(-9007199254740991.0, 9007199254740991.0),
  "int32", JS.array(-2147483648.0, 2147483647.0),
  "uint32", JS.array(0, 4294967295.0),
  "float32", JS.array(-3.4028234663852886e38, 3.4028234663852886e38),
  "float64", JS.array(-1.7976931348623157e308, 1.7976931348623157e308)
);

void applyOneCheckBag(JsValue b, JsValue cdef) {
  string name = toStr(cdef["check"]);
  if (name == "min_length" || name == "min_size") bagBound(b, "minimum", cdef["minimum"], false);
  if (name == "max_length" || name == "max_size") bagBound(b, "maximum", cdef["maximum"], true);
  if (name == "length_equals" || name == "size_equals") {
    string key = "size";
    if (name == "length_equals") key = "length";
    b["minimum"] = cdef[key];
    b["maximum"] = cdef[key];
    b[key] = cdef[key];
  }
  if (name == "greater_than" || name == "less_than") {
    bool upper = name == "less_than";
    string key = "minimum";
    if (upper) key = "maximum";
    if (JS.strictEqual(cdef["inclusive"], false)) {
      key = "exclusiveMinimum";
      if (upper) key = "exclusiveMaximum";
    }
    bagBound(b, key, cdef["value"], upper);
  }
  if (name == "multiple_of" && isUndef(b["multipleOf"])) b["multipleOf"] = cdef["value"];
  if (name == "number_format") {
    b["format"] = cdef["format"];
    string fmt = toStr(cdef["format"]);
    JsValue range = numberRanges[fmt];
    if (isArr(range)) {
      b["minimum"] = range[0];
      b["maximum"] = range[1];
    }
    if (fmt.includes("int")) b["pattern"] = rx("^-?\\d+$");
  }
  if (name == "string_format" || name == "lowercase" || name == "uppercase") {
    b["format"] = name;
    if (name == "string_format") b["format"] = cdef["format"];
    if (!JS.isNullish(cdef["pattern"]) && !JS.strictEqual(b["format"], "jwt")) setAdd(bagPatterns(b), cdef["pattern"]);
    if (JS.strictEqual(b["format"], "base64")) b["contentEncoding"] = "base64";
  }
  if (name == "starts_with") setAdd(bagPatterns(b), rx("^" + escapeRegex(toStr(cdef["prefix"])) + ".*"));
  if (name == "ends_with") setAdd(bagPatterns(b), rx(".*" + escapeRegex(toStr(cdef["suffix"])) + "$"));
  if (name == "includes") {
    string src = escapeRegex(toStr(cdef["includes"]));
    if (isNum(cdef["position"])) src = "^.{" + cdef["position"] + "}" + src;
    setAdd(bagPatterns(b), rx(src));
  }
  if (name == "mime_type") b["mime"] = cdef["mime"];
}

void applyChecksBag(JsValue inst, JsValue def) {
  JsValue b = inst["_zod"]["bag"];
  if (isStr(def["check"])) applyOneCheckBag(b, def);
  if (isStr(def["format"]) && isUndef(b["format"])) b["format"] = def["format"];
  if (isArr(def["checks"])) {
    JsValue[] checks = JS.assume(def["checks"]);
    checks.forEach((JsValue ch) => applyOneCheckBag(b, checkDef(ch)));
  }
}

export void hydrateInst(JsValue inst, JsValue def, JsValue ctor, string trait) {
  ensureLocale();
  if (isObj(inst["_zod"]) && !isUndef(inst["_zod"]["id"])) return;
  Schema schema = new Schema(def);
  schema.ctor = ctor;
  JsValue traits = traitsFor(trait, ctor);
  if (isStr(def["check"])) setAdd(traits, "$ZodCheck");
  attachInternals(inst, schema, traits);
  if (schema.kind == KObject) wrapObjectShape(def);
  applyChecksBag(inst, def);
  installDerived(schema);
}

JsValue hasTraitFn(string name) {
  return (JsValue inst) => isObj(inst) && !JS.isNullish(inst["_zod"]) && setHas(inst["_zod"]["traits"], name).truthy();
}

export JsValue makeCtor(string name, JsValue parent) {
  JsValue ctor = JS.methodRest((JsValue self, JsValue args) => {
    if (!isObj(self)) self = objectCreate(ctor["prototype"]);
    JsValue def = args[0];
    if (isObj(def) && isStr(def["type"])) hydrateInst(self, def, ctor, name);
    return self;
  });
  JsValue proto = ctor["prototype"];
  ctor["__parent"] = parent;
  // Lazy internals install on this per-constructor prototype of `_zod` (upstream $constructor).
  ctor["_zodProto"] = JS.object();
  if (!isUndef(parent)) setPrototypeOf(proto, parent["prototype"]);
  protoGetter(proto, "def", (JsValue self) => self["_zod"]["def"]);
  protoGetter(proto, "type", (JsValue self) => self["_zod"]["def"]["type"]);
  defConst(ctor, "name", name);
  defConst(ctor, "init", ((JsValue inst, JsValue def) => {
    if (isObj(def)) hydrateInst(inst, def, ctor, name);
    return inst;
  }));
  defConst(ctor, gSymbol()["hasInstance"], hasTraitFn(name));
  return ctor;
}

export void attachInternals(JsValue inst, Schema schema, JsValue traits) {
  schema.handle = inst;
  JsValue intern = objectCreate(JS.or(schema.ctor["_zodProto"], JS.object()));
  intern["id"] = schema.id;
  intern["def"] = schema.def;
  intern["bag"] = JS.object();
  intern["version"] = versionObj;
  intern["traits"] = traits;
  intern["constr"] = schema.ctor;
  JsValue parseFallback = (JsValue payload, JsValue ctx) => parseOnly(schema, payload, ctx);
  JsValue runFallback = (JsValue payload, JsValue ctx) => runOnPayload(schema, payload, ctx);
  intern["parse"] = parseFallback;
  intern["run"] = runFallback;
  if (isContainer(schema)) intern["memoizer"] = JS.object("open", JS.array());
  defineProperty(intern, "propValues", JS.object(
    "enumerable", true,
    "configurable", true,
    "get", () => {
      JsValue pv = computePropValues(schema);
      if (!isUndef(pv)) defineProperty(intern, "propValues", JS.object("enumerable", true, "configurable", true, "writable", true, "value", pv));
      return pv;
    }
  ));
  defineProperty(inst, "_zod", hiddenValue(intern));
  specializeInst(inst, schema, intern, parseFallback, runFallback);
}

void specializeInst(JsValue inst, Schema schema, JsValue intern, JsValue parseFallback, JsValue runFallback) {
  attachJsCheck(inst);
  float kind = schema.kind;
  JsValue parseFn = parseFallback;
  if (kind == KObject) parseFn = objectParseFor(parseFallback, runFallback, inst);
  else if (kind == KArray) parseFn = arrayParseFor(parseFallback, runFallback, inst);
  else if (kind <= KBoolean) {
    parseFn = call1(stringParseFact, undef(), inst);
    intern["parse"] = parseFn;
  } else return;
  intern["~pf"] = parseFallback;
  intern["~rf"] = runFallback;
  intern["run"] = bindRun(parseFn, collectJsChecks(inst), runFallback, intern, inst);
}

export JsValue paramMessage(JsValue params) {
  if (isStr(params)) return params;
  if (isObj(params)) {
    if (isStr(params["error"])) return params["error"];
    if (isStr(params["message"])) return params["message"];
  }
  return "";
}

export JsValue paramErrorMap(JsValue params) {
  if (isFn(params)) return params;
  if (isObj(params) && isFn(params["error"])) return params["error"];
  return undef();
}

export JsValue normalizeParams(JsValue params) {
  if (isStr(params)) return JS.object("error", () => params);
  if (isFn(params)) return JS.object("error", params);
  if (!isObj(params)) return JS.object();
  if (!isUndef(params["message"])) {
    if (!isUndef(params["error"])) throw newError("Cannot specify both `message` and `error` params");
    params["error"] = params["message"];
  }
  JS.delete(params, "message");
  JsValue text = params["error"];
  if (!isStr(text)) return params;
  JsValue out = objectAssign(JS.object(), params);
  out["error"] = () => text;
  return out;
}

export Regex emailRe = new Regex("^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$");
export Regex uuidRe = new Regex("^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$");
export Regex guidRe = new Regex("^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$");
export Regex cuidRe = new Regex("^[cC][0-9a-z]{6,}$");
export Regex cuid2Re = new Regex("^[0-9a-z]+$");
export Regex ulidRe = new Regex("^[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{26}$");
export Regex nanoidRe = new Regex("^[a-zA-Z0-9_-]{21}$");
export Regex ipv4Re = new Regex("^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$");
string ipv6Source = "(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))";
export Regex ipv6Re = new Regex("^" + ipv6Source + "$");
string dateSource = "(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))";

string timeSource(JsValue precision) {
  string hhmm = "(?:[01]\\d|2[0-3]):[0-5]\\d";
  if (!isNum(precision)) return hhmm + "(?::[0-5]\\d(?:\\.\\d+)?)?";
  int p = JS.number(precision).toInt();
  if (p == -1) return hhmm;
  if (p == 0) return hhmm + ":[0-5]\\d";
  return hhmm + ":[0-5]\\d\\.\\d{" + p + "}";
}

JsValue param(JsValue params, string key) {
  if (isObj(params)) return params[key];
  return undef();
}

export JsValue dateRegex() {
  return rx("^" + dateSource + "$");
}

export JsValue timeRegex(JsValue params) {
  return rx("^" + timeSource(param(params, "precision")) + "$");
}

export JsValue datetimeRegex(JsValue params) {
  string opts = "Z";
  if (param(params, "offset").truthy()) opts = "Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)";
  string tail = "(?:" + opts + ")";
  if (param(params, "local").truthy()) tail = tail + "?";
  return rx("^" + dateSource + "T(?:" + timeSource(param(params, "precision")) + tail + ")$");
}

export Regex isoDateRe = new Regex("^" + dateSource + "$");
export Regex durationRe = new Regex("^P(?:(\\d+W)|(?!.*W)(?=\\d|T\\d)(\\d+Y)?(\\d+M)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+([.,]\\d+)?S)?)?)$");
export Regex xidRe = new Regex("^[0-9a-vA-V]{20}$");
export Regex ksuidRe = new Regex("^[A-Za-z0-9]{27}$");
export Regex e164Re = new Regex("^\\+[1-9]\\d{6,14}$");
export Regex emojiRe = new Regex("^[\\p{Extended_Pictographic}\\p{Emoji_Component}]+$", "u");
export Regex base64urlRe = new Regex("^[A-Za-z0-9_-]*$");
export Regex cidrv4Re = new Regex("^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\/([0-9]|[1-2][0-9]|3[0-2])$");
export Regex cidrv6Re = new Regex("^" + ipv6Source + "\\/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$");
export Regex creditCardRe = new Regex("^\\d(?:[ -]?\\d){11,18}$");
export Regex hexRe = new Regex("^[0-9a-fA-F]*$");
export Regex hostnameRe = new Regex("^(?=.{1,253}\\.?$)[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\\.[a-zA-Z0-9](?:[-0-9a-zA-Z]{0,61}[0-9a-zA-Z])?)*\\.?$");
export Regex httpProtocolRe = new Regex("^https?$");
export Regex domainRe = new Regex("^(?=.{1,253}$)([a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$");
export Regex md5HexRe = new Regex("^[0-9a-fA-F]{32}$");
export Regex sha1HexRe = new Regex("^[0-9a-fA-F]{40}$");
export Regex sha256HexRe = new Regex("^[0-9a-fA-F]{64}$");
export Regex sha384HexRe = new Regex("^[0-9a-fA-F]{96}$");
export Regex sha512HexRe = new Regex("^[0-9a-fA-F]{128}$");

export JsValue regexJs(Regex re) {
  return JS.assume(re);
}

export void setCoerce(JsValue inst) {
  schemaOf(inst).def["coerce"] = true;
  JsValue intern = inst["_zod"];
  if (isUndef(intern["~pf"]) || isUndef(intern["~rf"])) return;
  intern["parse"] = intern["~pf"];
  intern["run"] = intern["~rf"];
}
