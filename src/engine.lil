    JsValue aKeys = objectKeys(a);
    JsValue bKeys = objectKeys(b);
    int i = 0;
    int n = JS.number(aKeys["length"]).toInt();
    while (i < n) {
      string key = toStr(aKeys[i]);
      if (key != "__proto__") {
        bool shared = false;
        int j = 0;
        int jn = JS.number(bKeys["length"]).toInt();
        while (j < jn) {
          if (toStr(bKeys[j]) == key) shared = true;
          j = j + 1;
        }
        if (shared) {
          JsValue inner = mergeValues(a[key], b[key]);
          if (!inner["valid"].truthy()) {
            JsValue path = newArray();
            push(path, key);
            JsValue rest = inner["mergeErrorPath"];
            if (isArr(rest)) {
              int ri = 0;
              int rn = JS.number(rest["length"]).toInt();
              while (ri < rn) {
                push(path, rest[ri]);
                ri = ri + 1;
              }
            }
            return JS.object("valid", false, "mergeErrorPath", path);
          }
          newObj[key] = inner["data"];
        }
      }
      i = i + 1;
    }
    return JS.object("valid", true, "data", newObj);
  }
  if (isArr(a) && isArr(b)) {
    if (JS.number(a["length"]).toInt() != JS.number(b["length"]).toInt()) {
      return JS.object("valid", false, "mergeErrorPath", newArray());
    }
    JsValue next = newArray();
    int i = 0;
    int n = JS.number(a["length"]).toInt();
    while (i < n) {
      JsValue inner = mergeValues(a[i], b[i]);
      if (!inner["valid"].truthy()) {
        JsValue path = newArray();
        push(path, i);
        JsValue rest = inner["mergeErrorPath"];
        if (isArr(rest)) {
          int ri = 0;
          int rn = JS.number(rest["length"]).toInt();
          while (ri < rn) {
            push(path, rest[ri]);
            ri = ri + 1;
          }
        }
        return JS.object("valid", false, "mergeErrorPath", path);
      }
      push(next, inner["data"]);
      i = i + 1;
    }
    return JS.object("valid", true, "data", next);
  }
