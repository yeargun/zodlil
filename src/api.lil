        JsValue list = newArray();
        push(list, types);
        types = list;
      }
      return checked(self, "mime_type", JS.object("mime", types), args[1]);
    });
  }), true);
  installArrayMethods();
  installObjectMethods();
  installEnumMethods();
  installWrapperMethods();
  installFunctionMethods();
  installCtorAccessors(ZodArray, "ZodArray");
  installCtorAccessors(ZodRecord, "ZodRecord");
  installCtorAccessors(ZodMap, "ZodMap");
  installCtorAccessors(ZodSet, "ZodSet");
  installCtorAccessors(ZodUnion, "ZodUnion");
  installCtorAccessors(ZodDiscriminatedUnion, "ZodDiscriminatedUnion");
  installCtorAccessors(ZodXor, "ZodXor");
  installCtorAccessors(ZodPipe, "ZodPipe");
  installCtorAccessors(ZodCodec, "ZodCodec");
  installCtorAccessors(ZodPreprocess, "ZodPreprocess");
  installCtorAccessors(ZodEnum, "ZodEnum");
  installCtorAccessors(ZodLiteral, "ZodLiteral");
}

export JsValue localesEn() {
  return JS.object("localeError", defaultLocale());
}

export JsValue configApi(JsValue next) {
  return setConfig(next);
}

export JsValue parseApi(JsValue schema, JsValue data, JsValue ctx) {
  return parseWithCallee(schema, data, ctx, parseApi);
}

export JsValue safeParseApi(JsValue schema, JsValue data, JsValue ctx) {
  return safeParseInst(schema, data, ctx);
}

export JsValue parseAsyncApi(JsValue schema, JsValue data, JsValue ctx) {
  return parseAsyncWithCallee(schema, data, ctx, parseAsyncApi);
}

JsValue dirCtx(JsValue ctx, string direction) {
  JsValue next = ctx;
  if (isUndef(ctx) || JS.isNullish(ctx)) next = JS.object();
  else next = objectAssign(JS.object(), ctx);
  next["direction"] = direction;
  return next;
}

export JsValue encodeApi(JsValue schema, JsValue data, JsValue ctx) {
  return parseWithCallee(schema, data, dirCtx(ctx, "backward"), encodeApi);
}

export JsValue decodeApi(JsValue schema, JsValue data, JsValue ctx) {
  return parseWithCallee(schema, data, dirCtx(ctx, "forward"), decodeApi);
}

export JsValue encodeAsyncApi(JsValue schema, JsValue data, JsValue ctx) {
  return parseAsyncWithCallee(schema, data, dirCtx(ctx, "backward"), encodeAsyncApi);
}

export JsValue decodeAsyncApi(JsValue schema, JsValue data, JsValue ctx) {
  return parseAsyncWithCallee(schema, data, dirCtx(ctx, "forward"), decodeAsyncApi);
}

export JsValue safeParseAsyncApi(JsValue schema, JsValue data, JsValue ctx) {
  return safeParseAsyncInst(schema, data, ctx);
}

export JsValue treeifyApi = treeifyError;
export JsValue prettifyApi = prettifyError;
export JsValue formatApi = formatError;
export JsValue flattenApi = flattenError;
export JsValue registryApi = makeRegistry;
export JsValue globalRegistryApi = globalRegistry();
export JsValue versionApi = version();
export JsValue ZodErrorApi = ZodError;
export JsValue ZodRealErrorApi = ZodRealError;
export JsValue toDotPathApi = toDotPath;
export JsValue getDiscriminatedOptionApi = getDiscriminatedOption;
export JsValue getConfigApi = getConfig;

export JsValue schemaProperties(JsValue shape) {
  JsValue out = newArray();
  if (!isObj(shape) || JS.isNullish(shape)) return out;
  JsValue keys = objectKeys(shape);
  int i = 0;
  int n = JS.number(keys["length"]).toInt();
  while (i < n) {
    push(out, createCheck("property", JS.object("property", keys[i], "schema", shape[keys[i]])));
    i = i + 1;
  }
  return out;
}

export JsValue schemaExactOptional(JsValue inner) {
  return construct1(ZodExactOptional, JS.object("type", "optional", "innerType", inner, "exact", true));
}

export JsValue schemaSlugifyCheck() {
  return createCheck("overwrite", JS.object("transform", JS.method1((JsValue _x, JsValue v) => {
    JsValue lower = invoke0(invoke0(v, "toLowerCase"), "trim");
    JsValue stripped = invoke2(lower, "replace", newRegex("[^\\w\\s-]", "g"), "");
    JsValue dashed = invoke2(stripped, "replace", newRegex("[\\s_-]+", "g"), "-");
    return invoke2(dashed, "replace", newRegex("^-+|-+$", "g"), "");
  })));
}

export JsValue schemaTrimCheck() {
  return createCheck("overwrite", JS.object("transform", JS.method1((JsValue _x, JsValue v) => {
    return invoke0(v, "trim");
  })));
}

export JsValue schemaMaxLengthCheck(JsValue maximum, JsValue params) {
  JsValue fields = JS.object("maximum", maximum);
  if (isObj(params) && !isNullish(params)) objectAssign(fields, normalizeParams(params));
  return createCheck("max_length", fields);
}

export JsValue schemaMinLengthCheck(JsValue minimum, JsValue params) {
  JsValue fields = JS.object("minimum", minimum);
  if (isObj(params) && !isNullish(params)) objectAssign(fields, normalizeParams(params));
  return createCheck("min_length", fields);
}

export JsValue visitSchema(JsValue schema, JsValue fnOrHandlers) {
  return schema;
}

export JsValue schemaFromJSON(JsValue json, JsValue params) {
  return schemaUnknown();
}
