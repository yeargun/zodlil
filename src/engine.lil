      if (mapHas(map, list[t])) {
        throw newError("Duplicate discriminator value \"" + toStr(list[t]) + "\"");
      }
      mapSet(map, list[t], options[i]);
      t = t + 1;
    }
    i = i + 1;
  }
  bag["optionsMap"] = map;
  return map;
}

export JsValue getDiscriminatedOption(JsValue union, JsValue value) {
  Schema schema = schemaOf(union);
  return mapGet(discMapOf(schema), value);
}

void parseUnion(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  JsValue options = schema.def["options"];
  if (!isArr(options)) options = newArray();
  string disc = "";
  if (isStr(schema.def["discriminator"])) disc = toStr(schema.def["discriminator"]);
  int n = JS.number(options["length"]).toInt();
  if (disc.length > 0) {
    if (!isObj(value) || isArr(value)) {
      push(payload["issues"], typeIssue("object", value));
      return;
    }
    JsValue map = discMapOf(schema);
    JsValue opt = mapGet(map, value[disc]);
    if (!isUndef(opt) && !JS.isNullish(opt)) {
      JsValue inner = parsePayload(schemaOf(opt), value, ctx);
      if (isPromise(inner)) {
