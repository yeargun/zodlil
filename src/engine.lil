  issue["input"] = input;
  if (exact) issue["exact"] = true;
  issue["continue"] = true;
  return issue;
}

void fail(JsValue payload, JsValue issue) {
  push(payload["issues"], issue);
}

void failSize(JsValue payload, bool tooBig, string origin, JsValue bound, bool inclusive, bool exact, JsValue input) {
