  void applyObjField(JsValue payload, JsValue out, string key, bool present, int optin, int optout, JsValue inner) {
    if (present && JS.number(inner["issues"]["length"]).toInt() == 0) {
      if (isUndef(inner["value"])) out[key] = undef();
      else out[key] = inner["value"];
      return;
    }
    bool optionalOut = optout == 1;
    bool optionalIn = optin != 0;
    bool skip = false;
    if (!present && optionalOut && optin == 1) skip = true;
    if (!skip && JS.number(inner["issues"]["length"]).toInt() > 0) {
      if (optionalIn && optionalOut && !present) skip = true;
      else prefixAll(inner["issues"], payload["issues"], key);
    }
    if (!skip && !present && optin == 0) {
      if (JS.number(inner["issues"]["length"]).toInt() == 0) {
        JsValue iss = typeIssue("nonoptional", undef());
        prefixPath(iss, key);
        push(payload["issues"], iss);
