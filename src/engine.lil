void parseFunction(Schema schema, JsValue payload, JsValue ctx) {
  JsValue value = payload["value"];
  if (!isFn(value)) {
    failType(payload, "function", value);
    return;
  }
  JsValue input = schema.def["input"];
  JsValue output = schema.def["output"];
  bool asyncOut = false;
  Schema? outSch = trySchema(output);
  if (outSch != null) {
    Schema o = outSch;
    if (o.kind == KPromise) asyncOut = true;
  }
  payload["value"] = implementFn(value, input, output, asyncOut);
