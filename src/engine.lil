export JsValue pushIssue(JsValue issues, JsValue issue) {
  push(issues, issue);
  return issues;
}

export JsValue typeIssue(string expected, JsValue input) {
  JsValue issue = JS.object("expected", expected, "code", "invalid_type", "input", input);
  if (expected == "number" && isNum(input) && !numberIs("isFinite", input)) issue["received"] = toStr(input);
  if (expected == "date" && isDate(input) && numberIs("isNaN", invoke0(input, "getTime"))) issue["received"] = "Invalid Date";
  return issue;
}

export JsValue valueIssue(JsValue values, JsValue input) {
  return JS.object("code", "invalid_value", "values", values, "input", input);
}

export JsValue formatIssue(string format, JsValue input, string message) {
  JsValue issue = JS.object("code", "invalid_format", "format", format, "origin", "string", "input", input);
  if (message.length > 0) issue["message"] = message;
