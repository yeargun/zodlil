export JsValue unwrapMessage(JsValue mapped) {
  if (isStr(mapped)) return mapped;
  if (isObj(mapped) && isStr(mapped["message"])) return mapped["message"];
  return undef();
}

JsValue errorFnOf(JsValue inst) {
  if (!isObj(inst) || JS.isNullish(inst["_zod"])) return undef();
  return inst["_zod"]["def"]["error"];
