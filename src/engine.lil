        this.values = inn.values;
      }
    } else if (t == "transform") {
      this.optin = 1;
    } else if (t == "pipe") {
      Schema? inner = childOf(this, "in");
      if (inner != null) {
        Schema inn = inner;
        this.values = inn.values;
        this.optin = inn.optin;
        this.optout = inn.optout;
      }
    } else if (t == "union") {
      JsValue options = def["options"];
      if (isArr(options)) {
        int n = JS.number(options["length"]).toInt();
        bool allVals = n > 0;
        bool anyDef = false;
        bool anyIn = false;
        bool anyOut = false;
        JsValue set = newSet();
        int i = 0;
        while (i < n) {
          Schema? opt = trySchema(options[i]);
          if (opt != null) {
            Schema o = opt;
            if (o.optin == 2) anyDef = true;
            if (o.optin != 0) anyIn = true;
            if (o.optout == 1) anyOut = true;
            if (isUndef(o.values)) allVals = false;
            else {
