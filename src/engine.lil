  if (isPlainObject(a) && isPlainObject(b)) {
    JsValue newObj = JS.object();
    JsValue srcs = newArray();
    push(srcs, a);
    push(srcs, b);
    int si = 0;
    while (si < 2) {
      JsValue src = srcs[si];
      JsValue keys = ownKeys(src);
      int ki = 0;
      int kn = JS.number(keys["length"]).toInt();
      while (ki < kn) {
        JsValue key = keys[ki];
        bool skipProto = false;
        if (isStr(key)) {
