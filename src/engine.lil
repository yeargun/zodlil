}

export JsValue treeifyError(JsValue error, JsValue mapper) {
  JsValue result = JS.object("errors", JS.array());
  walkIssues(error["issues"], JS.array(), (JsValue full, JsValue issue) => {
    JsValue curr = result;
    JsValue[] path = JS.assume(full);
    path.forEach((JsValue el) => {
      if (isStr(el)) {
