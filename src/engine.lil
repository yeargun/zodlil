}

void parseIntersection(Schema schema, JsValue payload, JsValue ctx) {
  Schema? left = childOf(schema, "left");
  Schema? right = childOf(schema, "right");
  if (left == null || right == null) return;
  JsValue a = parseOpt(left, payload["value"], ctx);
  JsValue b = parseOpt(right, payload["value"], ctx);
