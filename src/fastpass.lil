      return invoke1(result, "then", JS.method1((JsValue _r, JsValue next) => {
        return call2(slot["go"], undef(), next, JS.number(0.0));
      }));
    }
    return call2(slot["go"], undef(), result, JS.number(0.0));
  });
}

