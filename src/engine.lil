  int i = 0;
  int kn = JS.number(shapeKeys["length"]).toInt();
  while (i < kn) {
    string key = toStr(shapeKeys[i]);
    int fid = JS.number(fieldIds[i]).toInt();
    if (key == "__proto__" || fid < 0) {
      i = i + 1;
      continue;
    }
    Schema field = bag[fid];
    bool present = inOp(key, value);
    JsValue fieldVal = undef();
    if (present) fieldVal = value[key];
    JsValue inner = parseFieldSync(field, fieldVal, ctx, scratch);
    if (isPromise(inner)) {
