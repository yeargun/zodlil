float floatSafeRemainder(float val, float step) {
  float ratio = val / step;
  float diff = ratio - ratio.round();
  if (diff.abs() < toNum(gNumber()["EPSILON"]) * ratio.abs().max(1.0)) return 0.0;
  return diff;
