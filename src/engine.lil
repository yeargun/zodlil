bool isValidCreditCard(string input) {
  if (!regexTest(newRegex("^\\d(?:[ -]?\\d){11,18}$", ""), input)) return false;
  string digits = "";
  int i = 0;
  int n = input.length;
  while (i < n) {
    string ch = input.slice(i, i + 1);
    if (ch >= "0" && ch <= "9") digits = digits + ch;
    i = i + 1;
  }
  int sum = 0;
  bool alt = false;
  i = digits.length - 1;
  while (i >= 0) {
    int d = JS.number(toNumber(digits.slice(i, i + 1))).toInt();
    if (alt) {
      d = d * 2;
      if (d > 9) d = d - 9;
    }
    sum = sum + d;
    if (alt) alt = false;
    else alt = true;
    i = i - 1;
  }
  while (sum >= 10) sum = sum - 10;
  return sum == 0;
}

