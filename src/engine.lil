      bool present2 = present;
      int optin = field.internOptin();
      int optout = field.internOptout();
      queueWait(payload, inner, JS.method1((JsValue _s, JsValue parsed) => {
        schema.applyObjField(payload, out, k, present2, optin, optout, parsed);
        return undef();
      }));
    } else {
