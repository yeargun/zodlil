JsValue finalizeParsed(JsValue payload, Schema schema, JsValue ctx) {
  JsValue finalized = newArray();
  int i = 0;
  int n = JS.number(payload["issues"]["length"]).toInt();
  while (i < n) {
    push(finalized, finalizeIssue(payload["issues"][i], schema, ctx));
    i = i + 1;
  }
  return JS.object("value", payload["value"], "issues", finalized);
}

JsValue toSafe(JsValue parsed) {
  if (JS.number(parsed["issues"]["length"]).toInt() > 0) {
    return JS.object("success", false, "error", makeZodError(parsed["issues"]));
  }
  return JS.object("success", true, "data", parsed["value"]);
}

JsValue finishRun(Schema schema, JsValue payload, JsValue ctx) {
  if (JS.number(payload["issues"]["length"]).toInt() == 0) return payload;
  ensureLocale();
  return finalizeParsed(payload, schema, ctx);
}

JsValue runInst(JsValue inst, JsValue data, JsValue ctx) {
  return call2(inst["_zod"]["run"], inst["_zod"], JS.object("value", data, "issues", newArray()), ctx);
}

export JsValue runParse(JsValue inst, JsValue data, JsValue ctx) {
  Schema schema = schemaOf(inst);
  JsValue payload = runInst(inst, data, ctx);
  if (isPromise(payload)) {
    return invoke1(payload, "then", JS.method1((JsValue _s, JsValue next) => {
      return finishRun(schema, next, ctx);
    }));
  }
  return finishRun(schema, payload, ctx);
}

JsValue syncParseCtx(JsValue ctx) {
  if (isUndef(ctx) || JS.isNullish(ctx)) return JS.object("async", false);
  JsValue parseCtx = objectAssign(JS.object(), ctx);
  parseCtx["async"] = false;
  return parseCtx;
}

export JsValue safeParseInst(JsValue inst, JsValue data, JsValue ctx) {
  JsValue parseCtx = syncParseCtx(ctx);
  JsValue payload = runInst(inst, data, parseCtx);
  if (isPromise(payload)) {
    throw construct1(gError(), "Encountered Promise during synchronous parse. Use .parseAsync() instead.");
  }
  if (JS.number(payload["issues"]["length"]).toInt() == 0) {
    return JS.object("success", true, "data", payload["value"]);
  }
  ensureLocale();
  return toSafe(finalizeParsed(payload, schemaOf(inst), parseCtx));
}

export JsValue throwParsed(JsValue inst, JsValue payload, JsValue ctx, JsValue callee) {
  ensureLocale();
  JsValue result = toSafe(finalizeParsed(payload, schemaOf(inst), ctx));
  JsValue skip = callee;
  if (isUndef(skip) || JS.isNullish(skip)) skip = throwParsed;
  captureStackTrace(result["error"], skip);
  throw result["error"];
}

export JsValue failSafeParsed(JsValue inst, JsValue payload, JsValue ctx) {
  ensureLocale();
  return toSafe(finalizeParsed(payload, schemaOf(inst), ctx));
}

export JsValue parseWithCallee(JsValue inst, JsValue data, JsValue ctx, JsValue callee) {
  JsValue parseCtx = syncParseCtx(ctx);
  JsValue payload = runInst(inst, data, parseCtx);
  if (isPromise(payload)) {
    throw construct1(gError(), "Encountered Promise during synchronous parse. Use .parseAsync() instead.");
  }
  if (JS.number(payload["issues"]["length"]).toInt() == 0) return payload["value"];
  ensureLocale();
  JsValue result = toSafe(finalizeParsed(payload, schemaOf(inst), parseCtx));
  JsValue skip = callee;
  if (isUndef(skip) || JS.isNullish(skip)) skip = parseWithCallee;
  captureStackTrace(result["error"], skip);
  throw result["error"];
}

export JsValue parseInst(JsValue inst, JsValue data, JsValue ctx) {
  return parseWithCallee(inst, data, ctx, undef());
}

export JsValue safeParseAsyncInst(JsValue inst, JsValue data, JsValue ctx) {
  JsValue parseCtx = ctx;
  if (isUndef(ctx) || JS.isNullish(ctx)) parseCtx = JS.object("async", true);
  else {
    parseCtx = objectAssign(JS.object(), ctx);
    parseCtx["async"] = true;
  }
