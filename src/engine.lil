  yes
} from "./host.lil";
import {
  arrayParseFor,
  attachJsCheck,
  bindRun,
  collectJsChecks,
  objectParseFor,
  stringParseFact
} from "./fastpass.lil";

extern JsValue JSON;

export int KString = 0;
export int KNumber = 1;
export int KBoolean = 2;
export int KBigint = 3;
export int KSymbol = 4;
export int KDate = 5;
export int KNan = 6;
export int KUndefined = 7;
export int KNull = 8;
export int KAny = 9;
export int KUnknown = 10;
export int KNever = 11;
export int KVoid = 12;
export int KLiteral = 13;
export int KEnum = 14;
export int KObject = 15;
export int KArray = 16;
export int KTuple = 17;
export int KRecord = 18;
export int KMap = 19;
export int KSet = 20;
export int KUnion = 21;
export int KIntersection = 22;
export int KOptional = 23;
export int KNullable = 24;
export int KDefault = 25;
export int KPrefault = 26;
export int KCatch = 27;
export int KNonoptional = 28;
export int KLazy = 29;
export int KPromise = 30;
export int KTransform = 31;
export int KPipe = 32;
export int KReadonly = 33;
export int KCustom = 34;
export int KFile = 35;
export int KInstanceof = 36;
export int KSuccess = 37;
export int KXor = 38;
export int KFunction = 39;
export int KTemplateLiteral = 40;

// The def type name of every kind, indexed by the K constants above (instanceof is a
// custom schema, xor a union); kindOfType is the reverse lookup.
string[] typeNames = "string number boolean bigint symbol date nan undefined null any unknown never void literal enum object array tuple record map set union intersection optional nullable default prefault catch nonoptional lazy promise transform pipe readonly custom file custom success union function template_literal".split(" ");

Schema[] bag = [];
JsValue installingZod = undef();
bool brokeInternal = false;
// Shadows a lazy internal while it computes; a re-entrant read resolves to undefined.
// Also the "evaluating" sentinel of the lazy innerType getter.
JsValue breakerDesc = JS.object("configurable", true, "get", () => {
  brokeInternal = true;
  return undef();
});
JsValue recCache = newWeakMap();
JsValue propShapes = newWeakMap();
string syncPromiseMsg = "Encountered Promise during synchronous parse. Use .parseAsync() instead.";

export class Schema {
  int id;
  float kind;
  JsValue handle;
  JsValue def;
  JsValue ctor;
  string typeName;
  bool hasChecks;

  init(JsValue def) {
    string t = toStr(def["type"]);
    int k = kindOfType(t);
    if (k == KUnion && !isStr(def["discriminator"]) && JS.strictEqual(def["inclusive"], false)) k = KXor;
    JsValue checks = def["checks"];
    this.id = bag.length;
    this.kind = k;
    this.def = def;
    this.typeName = t;
    if (t == "int") this.typeName = "number";
    this.hasChecks = isStr(def["check"]) || isArr(checks) && JS.number(checks["length"]) > 0.0;
    bag.push(this);
  }

  JsValue templatePattern(JsValue parts) {
    JsValue[] list = JS.assume(parts);
    string src = "";
    list.forEach((JsValue part) => {
      if (JS.isNullish(part) || isStr(part) || isNum(part) || isBool(part) || isBig(part)) {
        src = src + escapeRegex(toStr(part));
      } else if (isObj(part) && isObj(part["_zod"])) {
        JsValue pat = part["_zod"]["pattern"];
        if (JS.isNullish(pat)) {
          throw newError("Invalid template literal part, no pattern found: " + invoke1(gArray(), "from", part["_zod"]["traits"])[0]);
        }
        string source = toStr(pat["source"]);
        if (source.length == 0) throw newError("Invalid template literal part");
        src = src + cleanRegex(source);
      } else {
        throw newError("Invalid template literal part: " + part);
      }
    });
    return rx("^" + src + "$");
  }
}

int kindOfType(string t) {
  if (t == "int") return KNumber;
  int k = typeNames.indexOf(t);
  if (k < 0) return KCustom;
  return k;
}

export string typeNameOf(int kind) {
  return typeNames[kind];
}

JsValue rx(string source) {
  return new Regex(source);
}

// String(value): unlike concatenation it also renders symbols.
string sv(JsValue value) {
  string s = JS.assume(toStringValue(value));
  return s;
}

string escapeRegex(string s) {
  return s.replace(new Regex("[.*+?^${}()|[\\]\\\\]", "g"), "\\$&");
}

string cleanRegex(string source) {
  int start = 0;
  int end = source.length;
  if (source.startsWith("^")) start = 1;
  if (source.endsWith("$")) end = end - 1;
  return source.slice(start, end);
}

JsValue computePattern(Schema s) {
  float k = s.kind;
  JsValue zod = s.handle["_zod"];
  JsValue b = zod["bag"];
  if (k == KString) {
    JsValue last = invoke0(invoke1(gArray(), "from", JS.or(b["patterns"], JS.array())), "pop");
    if (!isUndef(last)) return last;
    if (!isUndef(s.def["pattern"])) return s.def["pattern"];
    string min = "0";
    string max = "";
    if (isNum(b["minimum"])) min = toStr(b["minimum"]);
    if (isNum(b["maximum"])) max = toStr(b["maximum"]);
    return rx("^[\\s\\S]{" + min + "," + max + "}$");
  }
  if (k == KNumber) {
    if (!JS.isNullish(b["pattern"])) return b["pattern"];
    if (isStr(b["format"]) && toStr(b["format"]).includes("int")) return rx("^-?\\d+$");
    return rx("^-?\\d+(?:\\.\\d+)?$");
  }
  if (k == KBoolean) return new Regex("^(?:true|false)$", "i");
  if (k == KBigint) return rx("^-?\\d+n?$");
  if (k == KUndefined || k == KNull) return rx("^" + s.typeName + "$");
  JsValue[] vals = JS.assume(invoke1(gArray(), "from", zod["values"]));
  string[] parts = [];
  vals.forEach((JsValue v) => {
    if (k == KLiteral || isStr(v) || isNum(v) || isSym(v)) parts.push(escapeRegex(sv(v)));
  });
  return rx("^(" + parts.join("|") + ")$");
}

// Number.<test>(value) (isFinite, isNaN, isInteger, isSafeInteger).
bool numberIs(string test, JsValue value) {
  return JS.invoke(gNumber(), test, value).truthy();
}

// A non-enumerable, non-writable property (the attributes of an existing one are kept).
void defConst(JsValue target, JsValue key, JsValue value) {
  defineProperty(target, key, JS.object("configurable", true, "value", value));
}

JsValue dataDesc(JsValue value) {
  return JS.object("configurable", true, "writable", true, "value", value);
}

// A memoized internal computed from the instance's `_zod` on first read, installed once
// per constructor on the shared internals prototype (upstream util.defineLazyInternal).
void lazyInternal(JsValue intern, string key, func(JsValue)->JsValue compute) {
  JsValue proto = getPrototypeOf(intern);
  if (JS.in(key, proto) && !JS.strictEqual(installingZod, intern)) {
    installingZod = undef();
    return;
  }
  installingZod = intern;
  defineProperty(proto, key, JS.object(
    "configurable", true,
    "get", JS.method0((JsValue self) => {
      defineProperty(self, key, breakerDesc);
      bool outer = brokeInternal;
      brokeInternal = false;
      try {
        JsValue value = compute(self);
        if (brokeInternal) JS.delete(self, key);
        else defineProperty(self, key, dataDesc(value));
        if (outer) brokeInternal = true;
        return value;
      } catch (auto err) {
        JS.delete(self, key);
        if (outer) brokeInternal = true;
        throw err;
      }
    }),
    "set", JS.method1((JsValue self, JsValue value) => {
      defineProperty(self, key, dataDesc(value));
      return undef();
    })
  ));
}

// The internals of `zod.def[child]` (child "" = a lazy schema's resolved innerType).
JsValue childZod(JsValue zod, string child) {
  JsValue c = zod["innerType"];
  if (child != "") c = zod["def"][child];
  if (isObj(c) && isObj(c["_zod"])) return c["_zod"];
  return undef();
}

// A lazy internal `key` forwarded from the child schema.
void fwd(JsValue intern, string key, string child) {
  lazyInternal(intern, key, (JsValue zod) => {
    JsValue c = childZod(zod, child);
    if (isUndef(c)) return undef();
    return c[key];
  });
}

void installDerived(Schema s) {
  float k = s.kind;
  JsValue def = s.def;
  JsValue intern = s.handle["_zod"];
  if (k == KLazy) {
    JsValue getter = def["getter"];
    JsValue cached = undef();
    defineProperty(intern, "innerType", JS.object(
      "configurable", true,
      "get", () => {
        if (JS.strictEqual(cached, breakerDesc)) return undef();
        if (isUndef(cached)) {
          cached = breakerDesc;
          JsValue d = intern["def"];
          if (isUndef(d["_cachedInner"])) d["_cachedInner"] = call0(getter, undef());
          cached = d["_cachedInner"];
        }
        return cached;
      },
      "set", (JsValue v) => {
        defineProperty(intern, "innerType", dataDesc(v));
      }
    ));
    fwd(intern, "pattern", "");
    fwd(intern, "optin", "");
    fwd(intern, "optout", "");
    return;
  }
  if (k == KOptional || k == KNullable || k == KCatch || k == KReadonly) {
    if (k == KNullable || k == KReadonly) fwd(intern, "optin", "innerType");
    else {
      // .optional()/.catch() keep a defaulted inner's rung.
      lazyInternal(intern, "optin", (JsValue zod) => {
        JsValue c = childZod(zod, "innerType");
        if (!isUndef(c) && JS.strictEqual(c["optin"], "defaulted")) return "defaulted";
        return "optional";
      });
    }
    if (k == KOptional) intern["optout"] = "optional";
    else fwd(intern, "optout", "innerType");
    if (k == KCatch || k == KReadonly) {
      fwd(intern, "values", "innerType");
      return;
    }
    lazyInternal(intern, "values", (JsValue zod) => {
      JsValue c = childZod(zod, "innerType");
      if (isUndef(c) || isUndef(c["values"])) return undef();
      JsValue set = construct1(gSet(), c["values"]);
      if (k == KNullable) setAdd(set, null);
      else if (!zod["def"]["exact"].truthy()) setAdd(set, undef());
      return set;
    });
    lazyInternal(intern, "pattern", (JsValue zod) => {
      JsValue c = childZod(zod, "innerType");
      if (isUndef(c) || JS.isNullish(c["pattern"])) return undef();
      string tail = ")?$";
      if (k == KNullable) tail = "|null)$";
      return rx("^(" + cleanRegex(toStr(c["pattern"]["source"])) + tail);
    });
    return;
  }
  if (k == KUnion || k == KXor) {
    lazyInternal(intern, "optin", (JsValue zod) => {
      JsValue[] opts = JS.assume(zod["def"]["options"]);
      if (opts.some((JsValue o) => JS.strictEqual(o["_zod"]["optin"], "defaulted"))) return "defaulted";
      if (opts.some((JsValue o) => !isUndef(o["_zod"]["optin"]))) return "optional";
      return undef();
    });
    lazyInternal(intern, "optout", (JsValue zod) => {
      JsValue[] opts = JS.assume(zod["def"]["options"]);
      if (opts.some((JsValue o) => JS.strictEqual(o["_zod"]["optout"], "optional"))) return "optional";
      return undef();
    });
    lazyInternal(intern, "values", (JsValue zod) => {
      JsValue[] opts = JS.assume(zod["def"]["options"]);
      if (opts.some((JsValue o) => isUndef(o["_zod"]["values"]))) return undef();
      JsValue set = newSet();
      opts.forEach((JsValue o) => invoke1(o["_zod"]["values"], "forEach", (JsValue v) => setAdd(set, v)));
      return set;
    });
    lazyInternal(intern, "pattern", (JsValue zod) => {
      JsValue[] opts = JS.assume(zod["def"]["options"]);
      if (opts.some((JsValue o) => JS.isNullish(o["_zod"]["pattern"]))) return undef();
      return rx("^(" + opts.map((JsValue o) => cleanRegex(toStr(o["_zod"]["pattern"]["source"]))).join("|") + ")$");
    });
    return;
  }
  if (k == KPipe) {
    fwd(intern, "values", "in");
    fwd(intern, "optin", "in");
    fwd(intern, "optout", "out");
    return;
  }
  if (k <= KBigint || k == KUndefined || k == KNull || k == KLiteral || k == KEnum) {
    lazyInternal(intern, "pattern", (JsValue zod) => computePattern(bag[JS.number(zod["id"]).toInt()]));
  }
  if (k == KUndefined || k == KNull || k == KLiteral || k == KEnum) {
    JsValue list = def["values"];
    if (k == KUndefined) list = JS.array(undef());
    if (k == KNull) list = JS.array(null);
    if (k == KEnum) list = enumValues(def["entries"]);
    intern["values"] = construct1(gSet(), list);
  }
  if (k == KDefault || k == KPrefault) intern["optin"] = "defaulted";
  if (k == KTransform) intern["optin"] = "optional";
  if (k == KDefault || k == KPrefault || k == KNonoptional) fwd(intern, "values", "innerType");
}

bool isContainer(Schema s) {
  return s.kind >= KObject && s.kind <= KSet;
}

bool walkChild(JsValue child, JsValue stack) {
  if (!isObj(child)) return false;
  if (isObj(child["_zod"])) {
    Schema? s = trySchema(child);
    if (s != null) return isRecursive(s, stack);
    return false;
  }
  if (!isArr(child)) return false;
  JsValue[] items = JS.assume(child);
  return items.some((JsValue c) => walkChild(c, stack));
}

// Whether the schema's subtree contains a cycle, so one parse can re-enter it.
bool isRecursive(Schema s, JsValue stack) {
  JsValue h = s.handle;
  JsValue cached = mapGet(recCache, h);
  if (!JS.isNullish(cached)) return yes(cached);
  if (setHas(stack, h).truthy()) return true;
  setAdd(stack, h);
  bool result = false;
  JsValue def = s.def;
  if (s.kind == KLazy) result = walkChild(h["_zod"]["innerType"], stack);
  else {
    JsValue shape = def["shape"];
    if (isObj(shape)) {
      for (string key in shape) {
        if (!result) result = walkChild(shape[key], stack);
      }
    }
    for (string key in def) {
      if (!result) result = walkChild(def[key], stack);
    }
  }
  setDelete(stack, h);
  mapSet(recCache, h, result);
  return result;
}

JsValue cloneIssues(JsValue issues) {
  JsValue[] list = JS.assume(issues);
  return list.map((JsValue issue) => {
    JsValue c = objectAssign(JS.object(), issue);
    if (isArr(c["path"])) c["path"] = invoke0(c["path"], "slice");
    return c;
  });
}

void pushAll(JsValue into, JsValue items) {
  JsValue[] list = JS.assume(items);
  list.forEach((JsValue item) => push(into, item));
}

JsValue memoEnter(Schema s, JsValue payload, JsValue ctx) {
  JsValue m = s.handle["_zod"]["memoizer"];
  if (JS.isNullish(m)) return undef();
  if (isUndef(m["recursive"])) m["recursive"] = isRecursive(s, newSet());
  JsValue input = payload["value"];
  if (!m["recursive"].truthy() || !isObj(input) || !isObj(ctx)) return undef();
  JsValue state = ctx["~memo"];
  if (JS.isNullish(state)) {
    state = JS.object("buckets", newMap(), "backEdges", undef());
    ctx["~memo"] = state;
  }
  JsValue bucket = m["bucket"];
  if (!JS.strictEqual(m["ctx"], ctx)) {
    bucket = mapGet(state["buckets"], s.handle);
    if (JS.isNullish(bucket)) {
      bucket = newMap();
      mapSet(state["buckets"], s.handle, bucket);
    }
    m["ctx"] = ctx;
    m["bucket"] = bucket;
  }
  JsValue hit = mapGet(bucket, input);
  if (!JS.isNullish(hit)) {
    payload["value"] = hit["value"];
    JsValue issues = hit["issues"];
    if (!JS.isNullish(issues)) pushAll(payload["issues"], cloneIssues(issues));
    else {
      payload["memo"] = true;
      if (JS.isNullish(state["backEdges"])) state["backEdges"] = newSet();
      setAdd(state["backEdges"], hit["value"]);
    }
    return payload;
  }
  m["handoff"] = bucket;
  m["openDepth"] = m["open"]["length"];
  return undef();
}

JsValue memoAlloc(Schema s, JsValue payload, JsValue empty) {
  JsValue m = s.handle["_zod"]["memoizer"];
  if (JS.isNullish(m) || JS.isNullish(m["handoff"])) return empty;
  JsValue entry = JS.object("value", empty, "issues", null);
  mapSet(m["handoff"], payload["value"], entry);
  m["handoff"] = undef();
  push(m["open"], entry);
  return empty;
}

void memoLeave(Schema s, JsValue payload) {
  JsValue m = s.handle["_zod"]["memoizer"];
  if (JS.isNullish(m)) return;
  m["handoff"] = undef();
  JsValue open = m["open"];
  float depth = 0.0;
  if (isNum(m["openDepth"])) depth = toNum(m["openDepth"]);
  if (isArr(open) && JS.number(open["length"]) > depth) invoke0(open, "pop")["issues"] = cloneIssues(payload["issues"]);
}

JsValue localeErrorFn = undef();
JsValue customErrorFn = undef();
JsValue globalReg = undef();
JsValue versionObj = JS.object("major", 4, "minor", 4, "patch", 3);

export int registerSchema(Schema schema) {
  schema.id = bag.length;
  bag.push(schema);
  return schema.id;
}

export Schema schemaOf(JsValue inst) {
  return bag[JS.number(inst["_zod"]["id"]).toInt()];
}

// The schema behind a handle (null for anything else; a foreign id reads as absent).
export Schema? trySchema(JsValue inst) {
  if (!isObj(inst) || JS.isNullish(inst["_zod"]) || !isNum(inst["_zod"]["id"])) return null;
  return bag[JS.number(inst["_zod"]["id"]).toInt()];
}

export Schema makeSchema(JsValue def) {
  return new Schema(def);
}

export string parsedType(JsValue data) {
  string t = typeOf(data);
  if (t == "number") {
    if (numberIs("isFinite", data)) return "number";
    if (numberIs("isNaN", data)) return "nan";
    return toStr(data);
  }
  if (t == "object") {
    if (JS.isNullish(data)) return "null";
    if (isArr(data)) return "array";
    if (!JS.strictEqual(getPrototypeOf(data), gObject()["prototype"]) && isFn(data["constructor"])) {
      string name = toStr(data["constructor"]["name"]);
      if (name.length > 0) return name;
    }
    return "object";
  }
  return t;
}

export string stringifyPrimitive(JsValue value) {
  if (isBig(value)) return value + "n";
  if (isStr(value)) return "\"" + value + "\"";
  return toStr(value);
}

string joinValues(JsValue values, string sep) {
  JsValue[] list = JS.assume(values);
  return list.map((JsValue v) => stringifyPrimitive(v)).join(sep);
}

// en locale (upstream locales/en.ts): the unit a sized origin is counted in, and the noun of a string format.
JsValue sizeUnits = JS.object("string", "characters", "file", "bytes", "array", "items", "set", "items", "map", "entries");
JsValue formatNouns = JS.object(
  "regex", "input", "email", "email address", "url", "URL", "emoji", "emoji", "uuid", "UUID", "uuidv4", "UUIDv4",
  "uuidv6", "UUIDv6", "uuidv7", "UUIDv7", "nanoid", "nanoid", "guid", "GUID", "cuid", "cuid", "cuid2", "cuid2",
  "ulid", "ULID", "xid", "XID", "ksuid", "KSUID", "datetime", "ISO datetime", "date", "ISO date", "time", "ISO time",
  "duration", "ISO duration", "ipv4", "IPv4 address", "ipv6", "IPv6 address", "mac", "MAC address",
  "cidrv4", "IPv4 range", "cidrv6", "IPv6 range", "base64", "base64-encoded string", "base64url", "base64url-encoded string",
  "json_string", "JSON string", "e164", "E.164 number", "credit_card", "credit card number", "jwt", "JWT",
  "template_literal", "input"
);

string sizeMessage(JsValue issue, bool big) {
  string adj = "<";
  if (!big) adj = ">";
  if (issue["exact"].truthy()) adj = "exactly ";
  else if (!JS.strictEqual(issue["inclusive"], false)) adj = adj + "=";
  JsValue origin = issue["origin"];
  JsValue unit = sizeUnits[origin];
  if (isUndef(origin)) origin = "value";
  string head = "Too small: expected ";
  if (big) head = "Too big: expected ";
  string bound = toStr(issue["minimum"]);
  if (big) bound = toStr(issue["maximum"]);
  if (isStr(unit)) return head + origin + " to have " + adj + bound + " " + unit;
  return head + origin + " to be " + adj + bound;
}

string typeLabel(string t) {
  if (t == "nan") return "NaN";
  return t;
}

export string localeMessage(JsValue issue) {
  string code = toStr(issue["code"]);
  if (code == "invalid_type") {
    return "Invalid input: expected " + typeLabel(toStr(issue["expected"])) + ", received " + typeLabel(parsedType(issue["input"]));
  }
  if (code == "invalid_value") {
    JsValue values = issue["values"];
    if (!isArr(values)) return "Invalid input";
    if (JS.number(values["length"]) == 1.0) return "Invalid input: expected " + stringifyPrimitive(values[0]);
    return "Invalid option: expected one of " + joinValues(values, "|");
  }
  if (code == "too_big" || code == "too_small") return sizeMessage(issue, code == "too_big");
  if (code == "invalid_format") {
    string format = toStr(issue["format"]);
    if (format == "starts_with") return "Invalid string: must start with \"" + issue["prefix"] + "\"";
    if (format == "ends_with") return "Invalid string: must end with \"" + issue["suffix"] + "\"";
    if (format == "includes") return "Invalid string: must include \"" + issue["includes"] + "\"";
    if (format == "regex") return "Invalid string: must match pattern " + issue["pattern"];
    JsValue noun = formatNouns[format];
    if (!isStr(noun)) noun = format;
    return "Invalid " + noun;
  }
  if (code == "not_multiple_of") return "Invalid number: must be a multiple of " + issue["divisor"];
  if (code == "unrecognized_keys") {
    string s = "";
    if (JS.number(issue["keys"]["length"]) > 1.0) s = "s";
    return "Unrecognized key" + s + ": " + joinValues(issue["keys"], ", ");
  }
  if (code == "invalid_key") return "Invalid key in " + issue["origin"];
  if (code == "invalid_element") return "Invalid value in " + issue["origin"];
  if (code == "invalid_union") {
    JsValue opts = issue["options"];
    if (isArr(opts) && JS.number(opts["length"]) > 0.0) {
      JsValue[] list = JS.assume(opts);
      return "Invalid discriminator value. Expected " + list.map((JsValue o) => "'" + o + "'").join(" | ");
    }
