  void applyIndexedField(JsValue payload, JsValue out, JsValue idx, JsValue inner) {
    if (JS.number(inner["issues"]["length"]).toInt() > 0) prefixAll(inner["issues"], payload["issues"], idx);
    out[idx] = inner["value"];
