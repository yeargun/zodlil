      JsValue cl = cloneWithDef(self, undef());
      invoke2(globalRegistry(), "add", cl, args[0]);
      return cl;
    }),
    "refine", via(schemaRefine),
    "superRefine", via(schemaSuperRefine),
    "overwrite", via((JsValue fn, JsValue _u) => overwrite(fn)),
    "check", (JsValue self) => JS.staticRest((JsValue args) => {
      JsValue cur = self;
      int i = 0;
      while (i < len(args)) {
        JsValue ch = args[i];
        if (isFn(ch)) cur = withCheck(cur, createPayloadCheck(ch, undef()));
        else if (isObj(ch) && !isUndef(ch["_zod"])) cur = withCheck(cur, ch);
        i = i + 1;
      }
      return cur;
    }),
    "with", (JsValue self) => self["check"],
    "clone", (JsValue self) => (JsValue def) => cloneWithDef(self, def),
    "isOptional", (JsValue self) => () => safeParseInst(self, undef(), undef())["success"],
    "isNullable", (JsValue self) => () => safeParseInst(self, null, undef())["success"],
    "apply", (JsValue self) => JS.staticRest((JsValue args) => {
      JsValue callArgs = invoke1(gArray(), "from", args);
      callArgs[0] = self;
      return JS.apply(args[0], undef(), callArgs);
    }),
    "register", (JsValue self) => (JsValue registry, JsValue meta) => {
      invoke2(registry, "add", self, meta);
      return self;
    }
  ));
  installLazy(ZodType["prototype"], "~standard", (JsValue self) => JS.object(
    "validate", (JsValue value) => {
      try {
        return standardResult(safeParseInst(self, value, undef()));
      } catch (auto _err) {
        return invoke1(safeParseAsyncInst(self, value, undef()), "then", standardResult);
      }
    },
    "vendor", "zod",
    "version", 1,
    "jsonSchema", JS.object("input", standardJson(self, "input"), "output", standardJson(self, "output"))
  ), false);
  getter(ZodType, "_def", JS.method0((JsValue self) => defOf(self)));
  getter(ZodType, "description", JS.method0((JsValue self) => {
    JsValue meta = invoke1(globalRegistry(), "get", self);
    if (isNullish(meta)) return undef();
    return meta["description"];
  }));
  JsValue proto = ZodString["prototype"];
  for (string name in stringFormats) installLazy(proto, name, fmtM(name, stringFormats[name]), true);
  methodsOn(ZodString)(JS.object(
    "includes", sizedM("includes", "includes"),
    "startsWith", sizedM("starts_with", "prefix"),
    "endsWith", sizedM("ends_with", "suffix"),
    "regex", via((JsValue re, JsValue params) => formatCheck("regex", re, params)),
    "uuidv4", uuidM("4"),
    "uuidv6", uuidM("6"),
    "uuidv7", uuidM("7"),
    "mac", via((JsValue params, JsValue _u) => formatCheck("mac", macRegex(params), params)),
    "datetime", via((JsValue params, JsValue _u) => formatCheck("datetime", datetimeRegex(params), params)),
    "date", via((JsValue params, JsValue _u) => formatCheck("date", dateRegex(), params)),
    "time", via((JsValue params, JsValue _u) => formatCheck("time", timeRegex(params), params)),
    "trim", owM(trimFn),
    "toLowerCase", owM((JsValue v) => invoke0(v, "toLowerCase")),
    "toUpperCase", owM((JsValue v) => invoke0(v, "toUpperCase")),
    "lowercase", via((JsValue params, JsValue _u) => chk("lowercase", JS.object(), params)),
    "uppercase", via((JsValue params, JsValue _u) => chk("uppercase", JS.object(), params)),
    "normalize", via((JsValue form, JsValue _u) => overwrite((JsValue v) => invoke1(v, "normalize", form))),
    "slugify", owM(slugifyFn),
    "format", (JsValue self) => orNull(bagOf(self)["format"]),
    "minLength", (JsValue self) => orNull(bagOf(self)["minimum"]),
    "maxLength", (JsValue self) => orNull(bagOf(self)["maximum"]),
    "min", minM,
    "max", maxM,
    "length", lengthM,
    "nonempty", nonemptyM
  ));
  methodsOn(ZodNumber)(JS.object(
    "int", via((JsValue params, JsValue _u) => chk("number_format", JS.object("format", "int"), params)),
    "safe", via((JsValue params, JsValue _u) => chk("number_format", JS.object("format", "safeint"), params)),
    "positive", signM("greater_than", false, false),
    "nonnegative", signM("greater_than", true, false),
    "negative", signM("less_than", false, false),
    "nonpositive", signM("less_than", true, false),
    "multipleOf", multipleM,
    "step", multipleM,
    "finite", (JsValue self) => () => self,
    "format", (JsValue self) => orNull(bagOf(self)["format"]),
    "minValue", (JsValue self) => numberRange(self, "minimum", "exclusiveMinimum", "max", gNumber()["NEGATIVE_INFINITY"]),
    "maxValue", (JsValue self) => numberRange(self, "maximum", "exclusiveMaximum", "min", gNumber()["POSITIVE_INFINITY"]),
    "isInt", (JsValue self) => {
      JsValue bag = bagOf(self);
      if (JS.string(JS.or(bag["format"], "")).includes("int")) return true;
      JsValue step = bag["multipleOf"];
      if (isUndef(step)) step = 0.5;
      return JS.invoke(gNumber(), "isSafeInteger", step);
    },
    "isFinite", (JsValue _self) => true,
    "gt", gtM,
    "gte", gteM,
    "min", gteM,
    "lt", ltM,
    "lte", lteM,
    "max", lteM
  ));
  methodsOn(ZodBigInt)(JS.object(
    "positive", signM("greater_than", false, true),
    "nonnegative", signM("greater_than", true, true),
    "negative", signM("less_than", false, true),
    "nonpositive", signM("less_than", true, true),
    "multipleOf", multipleM,
    "format", (JsValue self) => orNull(bagOf(self)["format"]),
    "minValue", (JsValue self) => orNull(bagOf(self)["minimum"]),
    "maxValue", (JsValue self) => orNull(bagOf(self)["maximum"]),
    "gt", gtM,
    "gte", gteM,
    "min", gteM,
    "lt", ltM,
    "lte", lteM,
    "max", lteM
  ));
  methodsOn(ZodDate)(JS.object(
    "min", gteM,
    "max", lteM,
    "minDate", (JsValue self) => dateBound(self, "minimum"),
    "maxDate", (JsValue self) => dateBound(self, "maximum")
  ));
  methodsOn(ZodArray)(JS.object(
    "min", minM,
    "max", maxM,
    "length", lengthM,
    "nonempty", nonemptyM,
    "unwrap", (JsValue self) => () => defOf(self)["element"]
  ));
  JsValue sizeMethods = JS.object(
    "min", sizedM("min_size", "minimum"),
    "max", sizedM("max_size", "maximum"),
    "size", sizedM("size_equals", "size"),
    "nonempty", via((JsValue params, JsValue _u) => chk("min_size", JS.object("minimum", 1), params))
  );
  methodsOn(ZodMap)(sizeMethods);
  methodsOn(ZodSet)(sizeMethods);
  methodsOn(ZodFile)(JS.object(
    "mime", via((JsValue types, JsValue params) => {
      JsValue list = types;
      if (!isArr(types)) list = JS.array(types);
      return chk("mime_type", JS.object("mime", list), params);
    }),
    "min", sizeMethods["min"],
    "max", sizeMethods["max"]
  ));
  getter(ZodObject, "shape", JS.method0((JsValue self) => defOf(self)["shape"]));
  methodsOn(ZodObject)(JS.object(
    "strict", (JsValue self) => () => cloneWithDef(self, JS.object("catchall", schemaNever(undef()))),
    "passthrough", (JsValue self) => () => cloneWithDef(self, JS.object("catchall", schemaUnknown(undef()))),
    "strip", (JsValue self) => () => {
      JsValue def = objectAssign(JS.object(), defOf(self));
      def["catchall"] = undef();
      return construct1(ZodObject, def);
    },
    "loose", (JsValue self) => self["passthrough"],
    "catchall", (JsValue self) => (JsValue extra) => cloneWithDef(self, JS.object("catchall", extra)),
    "extend", (JsValue self) => (JsValue incoming) => {
      if (objectHasChecks(self)) {
