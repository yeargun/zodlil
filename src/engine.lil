void finishIntersection(JsValue payload, JsValue left, JsValue right) {
  JsValue unrec = JS.object();
  JsValue unrecIssue = undef();
  JsValue keyIssues = JS.object();
  int i = 0;
  int n = JS.number(left["issues"]["length"]).toInt();
  while (i < n) {
    if (!collectIntersectIssue(left["issues"][i], "l", unrec, keyIssues, unrecIssue)) {
      push(payload["issues"], left["issues"][i]);
    } else if (isUndef(unrecIssue) && toStr(left["issues"][i]["code"]) == "unrecognized_keys") {
      unrecIssue = left["issues"][i];
    }
    i = i + 1;
  }
  i = 0;
  n = JS.number(right["issues"]["length"]).toInt();
  while (i < n) {
    if (!collectIntersectIssue(right["issues"][i], "r", unrec, keyIssues, unrecIssue)) {
      push(payload["issues"], right["issues"][i]);
    } else if (isUndef(unrecIssue) && toStr(right["issues"][i]["code"]) == "unrecognized_keys") {
      unrecIssue = right["issues"][i];
    }
    i = i + 1;
  }
  JsValue both = newArray();
  JsValue keys = objectKeys(unrec);
  i = 0;
  n = JS.number(keys["length"]).toInt();
  while (i < n) {
    string k = toStr(keys[i]);
    if (unrec[k]["l"].truthy() && unrec[k]["r"].truthy()) push(both, k);
    i = i + 1;
  }
  if (JS.number(both["length"]).toInt() > 0) {
    if (!isUndef(unrecIssue)) {
      JsValue aggregated = newArray();
      JsValue src = unrecIssue["keys"];
      int bi = 0;
      int bn = JS.number(both["length"]).toInt();
      while (bi < bn) {
        int si = 0;
        int sn = JS.number(src["length"]).toInt();
        while (si < sn) {
          if (toStr(src[si]) == toStr(both[bi])) push(aggregated, both[bi]);
          si = si + 1;
