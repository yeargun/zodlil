// Walks issues depth-first through union branches and key/element sub-issues, calling
// leaf(fullPath, issue) for every other issue (upstream formatError/treeifyError).
void walkIssues(JsValue issues, JsValue prefix, func(JsValue, JsValue)->void leaf) {
  JsValue[] list = JS.assume(issues);
