    if (isFn(tx)) return runTransform(schema, payload, ctx, tx);
    return payload;
  }
  if (isBackward(ctx)) {
    if (right != null) {
      JsValue parsed = runOnPayload(right, payload, ctx);
      if (isPromise(parsed)) {
        return invoke1(parsed, "then", JS.method1((JsValue _s, JsValue next) => {
          if (pipeBlocked(next)) {
            next["aborted"] = true;
            return next;
          }
          JsValue ran = next;
          if (isFn(rev)) ran = runTransform(schema, next, ctx, rev);
          if (isPromise(ran)) {
            return invoke1(ran, "then", JS.method1((JsValue _a, JsValue mid) => {
              return parseAfterTransform(schema, mid, ctx, left);
            }));
          }
          return parseAfterTransform(schema, next, ctx, left);
        }));
      }
      if (pipeBlocked(payload)) {
        payload["aborted"] = true;
        return payload;
      }
    }
    if (isFn(rev)) {
      JsValue ran = runTransform(schema, payload, ctx, rev);
      if (isPromise(ran)) {
        return invoke1(ran, "then", JS.method1((JsValue _s, JsValue next) => {
          return parseAfterTransform(schema, next, ctx, left);
        }));
      }
    }
    return parseAfterTransform(schema, payload, ctx, left);
  }
  if (left != null) {
    JsValue parsed = runOnPayload(left, payload, ctx);
    if (isPromise(parsed)) {
      return invoke1(parsed, "then", JS.method1((JsValue _s, JsValue next) => {
        return parseAfterLeft(schema, next, ctx);
